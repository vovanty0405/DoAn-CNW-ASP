@model QL_DiemSV.ViewModels.CurriculumEditViewModel
@using QL_DiemSV.Services
@{ViewData["Title"]="Biên tập chương trình đào tạo";}
<link rel="stylesheet" href="~/css/curriculum.css" asp-append-version="true" />
<div class="academic"><h1>@ViewData["Title"]</h1><form method="post" action="/admin/curriculums/save" class="panel" id="curriculum-editor">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="error"></div><div class="toolbar"><label>Hệ đào tạo<input asp-for="HeDaoTao" list="systems" required maxlength="80" /></label><datalist id="systems"><option>Chính quy</option><option>Từ xa</option><option>Văn bằng 2</option></datalist><label>Khóa (năm)<input asp-for="KhoaHoc" type="number" min="1900" max="2200" required /></label><label>Ngành<select asp-for="NganhHocId" required><option value="">Chọn ngành</option>@foreach(var m in Model.Majors){<option value="@m.MaNganh">@m.TenNganh</option>}</select></label><label>Tên chương trình<input asp-for="TenChuongTrinh" list="programs" required maxlength="200" /></label><datalist id="programs">@foreach(var name in new[]{"Chính quy","Cử nhân tài năng","Chương trình tiếng Anh","Việt Nhật","Liên kết Newcastle","Văn bằng 2","Liên thông","CLC"}){<option>@name</option>}</datalist><label><span>Xuất bản</span><span><input asp-for="TrangThai" /> Hoạt động</span></label></div>
<p class="notice muted">Có thể để trống các mục chưa hoàn thiện. Mỗi mục hỗ trợ tối đa 2.000.000 ký tự nội dung HTML.</p>
@for(int i=0;i<11;i++){<details class="curriculum-section"><summary><span class="section-number">@(i+1)</span><strong>@CurriculumRules.Titles[i]</strong><i>⌄</i></summary><div class="curriculum-content"><div class="word-ribbon" aria-label="Công cụ soạn thảo"></div><div class="rich-editor curriculum-rich curriculum-section-content" contenteditable="true" role="textbox" aria-label="@CurriculumRules.Titles[i]">@Html.Raw(PortalRules.SanitizeHtml(Model.Contents.ElementAtOrDefault(i)))</div><label>Nội dung HTML (có thể chỉnh bảng trực tiếp)<textarea class="article-textarea curriculum-source" id="curriculum-source-@i" name="Contents[@i]" maxlength="2000000" rows="8">@Model.Contents.ElementAtOrDefault(i)</textarea></label></div></details>}
<div class="toolbar"><button>Lưu chương trình</button><a href="/admin/curriculums">Quay lại</a></div></form></div>
<script src="~/js/curriculum-tables.js" asp-append-version="true"></script>
<script src="~/js/curriculum.js" asp-append-version="true"></script>
