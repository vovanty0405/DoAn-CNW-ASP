@model QL_DiemSV.ViewModels.CurriculumEditViewModel
@using QL_DiemSV.Services
@{
    ViewData["Title"] = Model.Id > 0 ? "Biên tập chương trình đào tạo" : "Thêm chương trình đào tạo mới";
    bool isEditMode = Model.Id > 0;
}
<link rel="stylesheet" href="~/css/curriculum.css" asp-append-version="true" />
<div class="academic">
    <h1>@ViewData["Title"]</h1>
    <form method="post" action="/admin/curriculums/save" class="panel" id="curriculum-editor">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="error"></div>

        @if (isEditMode)
        {
            <div class="mb-3 px-3.5 py-2.5 rounded-xl bg-amber-500/10 border border-amber-500/25 text-xs text-amber-400 flex items-center gap-2">
                <span>🔒 <strong>Chế độ chỉnh sửa CTĐT:</strong> Các thông tin định danh (Hệ đào tạo, Khóa, Ngành, Tên chương trình) đã được khóa để bảo toàn tính toàn vẹn dữ liệu với 11 mục con và khung môn học. Bạn chỉ có thể cập nhật trạng thái <strong>Xuất bản (Hoạt động)</strong> và nội dung 11 mục bên dưới.</span>
            </div>
        }

        <div class="toolbar">
            <label>
                Hệ đào tạo
                <input asp-for="HeDaoTao" list="systems" required maxlength="80"
                       disabled="@isEditMode" readonly="@isEditMode"
                       class="@(isEditMode ? "bg-slate-100 cursor-not-allowed input-locked" : "")" />
                @if (isEditMode)
                {
                    <input type="hidden" name="HeDaoTao" value="@Model.HeDaoTao" />
                }
            </label>
            <datalist id="systems">
                <option>Chính quy</option>
                <option>Từ xa</option>
                <option>Văn bằng 2</option>
            </datalist>

            <label>
                Khóa (năm)
                <input asp-for="KhoaHoc" type="number" min="1900" max="2200" required
                       disabled="@isEditMode" readonly="@isEditMode"
                       class="@(isEditMode ? "bg-slate-100 cursor-not-allowed input-locked" : "")" />
                @if (isEditMode)
                {
                    <input type="hidden" name="KhoaHoc" value="@Model.KhoaHoc" />
                }
            </label>

            <label>
                Ngành
                <select asp-for="NganhHocId" required
                        disabled="@isEditMode"
                        class="@(isEditMode ? "bg-slate-100 cursor-not-allowed input-locked" : "")">
                    <option value="">Chọn ngành</option>
                    @foreach (var m in Model.Majors)
                    {
                        <option value="@m.MaNganh">@m.TenNganh</option>
                    }
                </select>
                @if (isEditMode)
                {
                    <input type="hidden" name="NganhHocId" value="@Model.NganhHocId" />
                }
            </label>

            <label>
                Tên chương trình
                <input asp-for="TenChuongTrinh" list="programs" required maxlength="200"
                       disabled="@isEditMode" readonly="@isEditMode"
                       class="@(isEditMode ? "bg-slate-100 cursor-not-allowed input-locked" : "")" />
                @if (isEditMode)
                {
                    <input type="hidden" name="TenChuongTrinh" value="@Model.TenChuongTrinh" />
                }
            </label>
            <datalist id="programs">
                @foreach (var name in new[] { "Chính quy", "Cử nhân tài năng", "Chương trình tiếng Anh", "Việt Nhật", "Liên kết Newcastle", "Văn bằng 2", "Liên thông", "CLC" })
                {
                    <option>@name</option>
                }
            </datalist>

            <label>
                <span>Xuất bản</span>
                <span><input asp-for="TrangThai" /> Hoạt động</span>
            </label>
        </div>

        <p class="notice muted">Có thể để trống các mục chưa hoàn thiện. Mỗi mục hỗ trợ tối đa 2.000.000 ký tự nội dung HTML.</p>
        @for (int i = 0; i < 11; i++)
        {
            <details class="curriculum-section">
                <summary><span class="section-number">@(i + 1)</span><strong>@CurriculumRules.Titles[i]</strong><i>⌄</i></summary>
                <div class="curriculum-content">
                    <div class="word-ribbon" aria-label="Công cụ soạn thảo"></div>
                    <div class="rich-editor curriculum-rich curriculum-section-content" contenteditable="true" role="textbox" aria-label="@CurriculumRules.Titles[i]">@Html.Raw(PortalRules.SanitizeHtml(Model.Contents.ElementAtOrDefault(i)))</div>
                    <label>Nội dung HTML (có thể chỉnh bảng trực tiếp)<textarea class="article-textarea curriculum-source" id="curriculum-source-@i" name="Contents[@i]" maxlength="2000000" rows="8">@Model.Contents.ElementAtOrDefault(i)</textarea></label>
                </div>
            </details>
        }
        <div class="toolbar">
            <button>Lưu chương trình</button>
            <a href="/admin/curriculums">Quay lại</a>
        </div>
    </form>
</div>
<script src="~/js/curriculum-tables.js" asp-append-version="true"></script>
<script src="~/js/curriculum.js" asp-append-version="true"></script>
