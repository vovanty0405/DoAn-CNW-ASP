@model QL_DiemSV.ViewModels.CurriculumCatalogViewModel
@{ViewData["Title"]="Quản lý CTĐT";}
<div class="academic"><div class="section-heading"><h1>Chương trình đào tạo</h1><a class="button admin-add" href="/admin/curriculums/edit">+ Thêm chương trình</a></div>
@if(TempData["Message"] is string message){<p role="status">@message</p>}
<section class="panel"><form class="toolbar" method="get"><label>Hệ<select name="system"><option value="">Tất cả</option>@foreach(var v in Model.All.Select(x=>x.HeDaoTao).Distinct()){<option selected="@(v==Model.System)">@v</option>}</select></label><label>Khóa<select name="year"><option value="">Tất cả</option>@foreach(var v in Model.All.Select(x=>x.KhoaHoc).Distinct()){<option selected="@(v==Model.Year)">@v</option>}</select></label><label>Ngành<select name="major"><option value="">Tất cả</option>@foreach(var g in Model.All.GroupBy(x=>x.NganhHocId)){<option value="@g.Key" selected="@(g.Key==Model.Major)">@g.First().NganhHoc?.TenNganh</option>}</select></label><label>Chương trình<select name="program"><option value="">Tất cả</option>@foreach(var v in Model.All.Select(x=>x.TenChuongTrinh).Distinct()){<option selected="@(v==Model.Program)">@v</option>}</select></label><label>Trạng thái<select name="active"><option value="">Tất cả</option><option value="true" selected="@(Model.Active==true)">Hoạt động</option><option value="false" selected="@(Model.Active==false)">Ẩn</option></select></label><button>Lọc</button></form>
<div class="scroll"><table><thead><tr><th>ID</th><th>Hệ</th><th>Khóa</th><th>Ngành</th><th>Chương trình</th><th>Số mục</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model.Visible){<tr><td>@c.Id</td><td>@c.HeDaoTao</td><td>@c.KhoaHoc</td><td>@c.NganhHoc?.TenNganh</td><td>@c.TenChuongTrinh</td><td>@Model.SectionCounts.GetValueOrDefault(c.Id)</td><td><span class="badge @(c.TrangThai?"active":"neutral")">@(c.TrangThai?"Hoạt động":"Ẩn")</span></td><td><div class="row-actions"><a href="/Portal/CurriculumDetail/@c.Id">Xem Portal</a><a class="button secondary" href="/admin/curriculums/edit/@c.Id">Sửa</a><form method="post" action="/admin/curriculums/delete/@c.Id" onsubmit="return confirm('Xóa chương trình và 11 mục nội dung?')">@Html.AntiForgeryToken()<button class="danger">Xóa</button></form></div><form class="toolbar" method="post" action="/admin/curriculums/clone/@c.Id">@Html.AntiForgeryToken()<label>Khóa mới<input type="number" name="year" min="1900" max="2200" required value="@(c.KhoaHoc+1)" /></label><button class="secondary">Sao chép</button></form></td></tr>}@if(Model.Visible.Count==0){<tr><td colspan="8">Chưa có chương trình phù hợp.</td></tr>}</tbody></table></div>
<nav class="toolbar" aria-label="Phân trang chương trình đào tạo">
<span class="muted">@Model.Total chương trình · Trang @Model.Page/@Model.TotalPages</span>
@if(Model.Page>1){<a class="button secondary" href="@Url.Action("Index",new{system=Model.System,year=Model.Year,major=Model.Major,program=Model.Program,active=Model.Active,page=Model.Page-1,pageSize=Model.PageSize})">« Trước</a>}
@if(Model.Page<Model.TotalPages){<a class="button secondary" href="@Url.Action("Index",new{system=Model.System,year=Model.Year,major=Model.Major,program=Model.Program,active=Model.Active,page=Model.Page+1,pageSize=Model.PageSize})">Sau »</a>}
</nav></section></div>
