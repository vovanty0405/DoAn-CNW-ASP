@model QL_DiemSV.ViewModels.PortalViewModel
@using QL_DiemSV.Services
@{Layout="_PortalLayout";ViewData["Title"]="Cổng thông tin đào tạo";}
<section class="portal-hero"><div><span class="eyebrow">STUDENT & LECTURER PORTAL</span><h1>Hành trình học tập.<br />Kết nối mỗi ngày.</h1><p>Thông báo, lịch học và chương trình đào tạo — mọi thông tin bạn cần trong một không gian.</p><a href="#articles" class="hero-link">Khám phá thông tin mới ↓</a></div><div class="hero-graphic" aria-hidden="true"><span>ACADEMIC<br /><b>LEDGER</b></span><i>Tri thức mở lối tương lai</i></div></section>
<section class="quick-actions" aria-label="Truy cập nhanh">@foreach(var item in new[]{("▦","Lịch phòng học","/quan-ly-lich-hoc/ma-tran"),("◷","Tra cứu TKB","/portal/tra-cuu-tkb"),("▤","Chương trình ĐT","#curriculum"),("▧","Văn bản - Biểu mẫu","#documents"),("✎","Đăng ký học phần","/dang-ky-hoc-phan"),("✉","Liên hệ","#contact")}){<a href="@item.Item3"><span aria-hidden="true">@item.Item1</span><strong>@item.Item2</strong><small>Truy cập →</small></a>}</section>
<section class="portal-panel" id="articles"><div class="portal-heading"><h2>📢 BÀI VIẾT</h2><a href="/portal?category=all#articles">Xem tất cả →</a></div>
<nav class="article-tabs" aria-label="Danh mục bài viết"><a class="@(Model.Category=="all"?"active":"")" href="@Url.Action("Index",new{category="all",search=Model.Search})#articles">Tất cả <span>@Model.Counts.Values.Sum()</span></a>@foreach(var c in PortalRules.Categories){<a class="@(Model.Category==c.Key?"active":"")" href="@Url.Action("Index",new{category=c.Key,search=Model.Search})#articles">@c.Value <span>@Model.Counts.GetValueOrDefault(c.Key)</span></a>}</nav>
<form method="get" class="portal-search"><input type="hidden" name="category" value="@Model.Category" /><input name="search" value="@Model.Search" placeholder="Tìm thông báo, học phí, hướng dẫn…" aria-label="Tìm bài viết" /><button>Tìm kiếm</button></form>
<div class="article-grid">@foreach(var article in Model.Articles){var date=PortalRules.Local(article.NgayDang);<article class="article-item"><div class="date-tile"><strong>@date.ToString("dd")</strong><span>TH @date.ToString("MM")</span></div><div><h3><a href="/portal/bai-viet/@article.Id">@if(article.GhimDauTrang){<span title="Bài viết ưu tiên">📌</span>} @article.TieuDe</a>@if(PortalRules.IsNew(article.NgayDang)){<span class="new-tag">MỚI</span>}</h3><div class="article-meta"><span class="category-badge">@PortalRules.Categories.GetValueOrDefault(article.DanhMuc,article.DanhMuc)</span><span>♙ @article.DonViDang</span></div></div></article>}
@if(Model.Articles.Count==0){<p class="portal-empty">Chưa có bài viết được xuất bản phù hợp. Vui lòng quay lại sau.</p>}</div>
@if(Model.Total>12){<nav class="portal-pagination" aria-label="Phân trang bài viết">@if(Model.Page>1){<a href="@Url.Action("Index",new{category=Model.Category,search=Model.Search,page=Model.Page-1})#articles">← Trang trước</a>}<span>Trang @Model.Page / @((Model.Total+11)/12)</span>@if(Model.Page*12<Model.Total){<a href="@Url.Action("Index",new{category=Model.Category,search=Model.Search,page=Model.Page+1})#articles">Trang sau →</a>}</nav>}
</section>
<div class="portal-columns"><section class="portal-panel"><div class="portal-heading"><h2>TIN TỨC & SỰ KIỆN</h2><a href="/portal?category=TinTuc#articles">Tất cả tin →</a></div><div class="news-grid">@foreach(var news in Model.News){<a class="news-card" href="/portal/bai-viet/@news.Id"><img src="@(PortalRules.SafeUrl(news.ThumbnailUrl,true)?news.ThumbnailUrl:"/images/portal-news.svg")" alt="" loading="lazy" /><div><span class="news-date">@PortalRules.Local(news.NgayDang).ToString("dd/MM/yyyy")</span><h3>@news.TieuDe</h3><p>@news.TomTat</p></div></a>}@if(Model.News.Count==0){<div class="portal-empty news-empty"><img src="/images/portal-news.svg" alt="" /><p>Tin tức và sự kiện mới sẽ được cập nhật tại đây.</p></div>}</div></section>
<aside class="portal-panel"><div class="portal-heading"><h2>📅 LỊCH PHÒNG HỌC HÔM NAY</h2></div><p class="widget-date">@RoomMatrixRules.Today.ToString("dd/MM/yyyy") · cập nhật khi tải trang</p><table class="portal-table room-widget"><thead><tr><th>PHÒNG</th><th>TIẾT TRONG NGÀY</th><th>HIỆN TẠI</th></tr></thead><tbody>@foreach(var r in Model.Rooms){<tr><td><strong>@r.Room</strong></td><td>@(string.IsNullOrEmpty(r.Periods)?"—":r.Periods)</td><td><span class="room-status @(r.Status=="Đang học"?"busy":"")">@r.Status</span></td></tr>}@if(Model.Rooms.Count==0){<tr><td colspan="3">Chưa khai báo phòng học.</td></tr>}</tbody></table><a href="/quan-ly-lich-hoc/ma-tran" class="widget-link">Xem toàn bộ lịch phòng học →</a></aside></div>
<div class="portal-columns"><section class="portal-panel" id="curriculum"><div class="portal-heading"><h2>🎓 CHƯƠNG TRÌNH ĐÀO TẠO</h2></div>@foreach(var group in Model.Majors.GroupBy(x=>x.HeDaoTao)){<h3 class="program-group">HỆ @group.Key.ToUpper()</h3><div class="program-grid">@foreach(var major in group){<a class="program-card" href="/portal/chuong-trinh/@major.MaNganh"><span class="program-icon">▤</span><strong>@major.TenNganh</strong><small>@major.MaNganh · @major.KhungChuongTrinhs.Count môn · @major.KhungChuongTrinhs.Sum(x=>x.MonHoc?.SoTinChi??0) tín chỉ</small><span>Khám phá chương trình →</span></a>}</div>}@if(Model.Majors.Count==0){<p class="portal-empty">Chưa có ngành đào tạo trong CSDL.</p>}</section>
<aside class="document-stack" id="documents">@foreach(var group in new[]{("QuyChe","QUY CHẾ - QUY ĐỊNH","regulations"),("BieuMau","BIỂU MẪU","forms")}){<section class="portal-panel" id="@group.Item3"><div class="portal-heading"><h2>@group.Item2</h2></div>@foreach(var doc in Model.Documents.Where(x=>x.Loai==group.Item1&&PortalRules.SafeUrl(x.FileUrl))){<a class="document-item" href="@doc.FileUrl" download><span class="file-icon">▧</span><span><strong>@doc.TieuDe</strong><small>@PortalRules.Size(doc.DungLuongBytes)</small></span><span>↓</span></a>}@if(!Model.Documents.Any(x=>x.Loai==group.Item1&&PortalRules.SafeUrl(x.FileUrl))){<p class="portal-empty">Tài liệu đang được cập nhật.</p>}</section>}</aside></div>
