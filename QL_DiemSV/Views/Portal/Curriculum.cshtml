@model QL_DiemSV.Models.Nganh
@{Layout="_PortalLayout";ViewData["Title"]=Model.TenNganh;}
<div class="portal-breadcrumb"><a href="/portal#curriculum">Chương trình đào tạo</a> / @Model.TenNganh</div><section class="portal-panel"><div class="portal-heading"><div><span class="eyebrow">HỆ @Model.HeDaoTao.ToUpper()</span><h1>@Model.TenNganh</h1><p>@Model.Khoa?.TenKhoa · @Model.MaNganh</p></div><span class="category-badge">@Model.KhungChuongTrinhs.Sum(x=>x.MonHoc?.SoTinChi??0) tín chỉ</span></div>
<div class="portal-table-wrap"><table class="portal-table"><thead><tr><th>Học kỳ dự kiến</th><th>Mã môn</th><th>Tên môn học</th><th>Tín chỉ</th><th>Loại môn</th></tr></thead><tbody>@foreach(var item in Model.KhungChuongTrinhs.OrderBy(x=>x.HocKyDuKien).ThenBy(x=>x.MaMon)){<tr><td>@item.HocKyDuKien</td><td>@item.MaMon</td><td>@item.MonHoc?.TenMon</td><td>@item.MonHoc?.SoTinChi</td><td>@item.LoaiMon</td></tr>}@if(Model.KhungChuongTrinhs.Count==0){<tr><td colspan="5">Chưa cập nhật khung đào tạo.</td></tr>}</tbody></table></div></section>
