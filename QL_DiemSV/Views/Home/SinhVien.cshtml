@{
    Layout = "_Layout";
}

<div class="max-w-[1600px] mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-text-muted font-medium mb-1">Quản lý Đào tạo &gt; Hồ sơ Sinh viên</div>
            <h1 class="text-2xl font-bold text-text-primary">Quản Lý Sinh Viên</h1>
        </div>
        <div class="flex flex-wrap gap-2.5">
            <label class="cursor-pointer px-4 py-2 rounded-xl bg-surface border border-surface-hover hover:border-primary text-sm font-semibold text-text-primary flex items-center gap-2 transition-all">
                <i data-lucide="upload" class="w-4 h-4 text-[#10B981]"></i> Nhập Excel
                <input type="file" accept=".xlsx,.xls" class="hidden" onchange="handleExcelUpload(event)" />
            </label>
            <button onclick="exportSinhVienExcel()" class="px-4 py-2 rounded-xl bg-surface border border-surface-hover hover:border-primary text-sm font-semibold text-text-primary flex items-center gap-2 transition-all">
                <i data-lucide="download" class="w-4 h-4 text-primary"></i> Xuất Excel
            </button>
            <button onclick="openSvModal()" class="px-4 py-2 rounded-xl bg-primary hover:bg-primary/90 text-white text-sm font-bold shadow-lg shadow-primary/20 flex items-center gap-2 transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i> Thêm Sinh Viên
            </button>
        </div>
    </div>

    <!-- Filter & Sort Bar -->
    <div class="bg-surface border border-surface-hover rounded-2xl p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input id="sv-search" oninput="queueSvSearch()" type="text" placeholder="Tìm Mã SV, Họ tên, Email..."
                   class="w-full bg-canvas border border-surface-hover rounded-lg pl-9 pr-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
        </div>
        <select id="sv-khoa" onchange="onFilterKhoaChange()" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
            <option value="">Tất cả Khoa</option>
        </select>
        <select id="sv-nganh" onchange="onFilterNganhChange()" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
            <option value="">Tất cả Ngành</option>
        </select>
        <select id="sv-lop" onchange="renderSvTable(true)" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
            <option value="">Tất cả Lớp hành chính</option>
        </select>
        <select id="sv-status" onchange="renderSvTable(true)" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
            <option value="">Tất cả Trạng thái</option>
            <option value="Đang học">Đang học</option>
            <option value="Bảo lưu">Bảo lưu</option>
            <option value="Đã tốt nghiệp">Đã tốt nghiệp</option>
            <option value="Thôi học">Thôi học</option>
        </select>
        <select id="sv-sort" onchange="onSvSortDropdownChange(this.value)" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none font-medium">
            <option value="masv_asc">Sắp xếp: Mã SV tăng dần</option>
            <option value="masv_desc">Sắp xếp: Mã SV giảm dần</option>
            <option value="newest">Sắp xếp: Mới nhất</option>
            <option value="oldest">Sắp xếp: Cũ nhất</option>
            <option value="hoten_asc">Sắp xếp: Họ tên (A → Z)</option>
            <option value="hoten_desc">Sắp xếp: Họ tên (Z → A)</option>
            <option value="malop_asc">Sắp xếp: Lớp hành chính (A → Z)</option>
            <option value="ngaysinh_desc">Sắp xếp: Ngày sinh (Trẻ → Lớn)</option>
        </select>
    </div>

    <!-- Data Table -->
    <div class="bg-surface border border-surface-hover rounded-2xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-surface-header border-b border-surface-hover text-xs text-text-muted uppercase tracking-wider select-none">
                        <th onclick="sortSvByColumn('masv')" class="px-5 py-3.5 font-semibold cursor-pointer hover:text-primary transition-colors">
                            <span class="inline-flex items-center gap-1">Mã SV <span id="sv-sort-icon-masv" class="text-primary">🔼</span></span>
                        </th>
                        <th onclick="sortSvByColumn('hoten')" class="px-5 py-3.5 font-semibold cursor-pointer hover:text-primary transition-colors">
                            <span class="inline-flex items-center gap-1">Họ và Tên <span id="sv-sort-icon-hoten" class="text-text-muted/40">↕</span></span>
                        </th>
                        <th onclick="sortSvByColumn('gioitinh')" class="px-5 py-3.5 font-semibold cursor-pointer hover:text-primary transition-colors">
                            <span class="inline-flex items-center gap-1">Giới tính <span id="sv-sort-icon-gioitinh" class="text-text-muted/40">↕</span></span>
                        </th>
                        <th onclick="sortSvByColumn('ngaysinh')" class="px-5 py-3.5 font-semibold cursor-pointer hover:text-primary transition-colors">
                            <span class="inline-flex items-center gap-1">Ngày sinh <span id="sv-sort-icon-ngaysinh" class="text-text-muted/40">↕</span></span>
                        </th>
                        <th onclick="sortSvByColumn('malop')" class="px-5 py-3.5 font-semibold cursor-pointer hover:text-primary transition-colors">
                            <span class="inline-flex items-center gap-1">Lớp hành chính <span id="sv-sort-icon-malop" class="text-text-muted/40">↕</span></span>
                        </th>
                        <th onclick="sortSvByColumn('nganh')" class="px-5 py-3.5 font-semibold cursor-pointer hover:text-primary transition-colors">
                            <span class="inline-flex items-center gap-1">Ngành / Khoa <span id="sv-sort-icon-nganh" class="text-text-muted/40">↕</span></span>
                        </th>
                        <th onclick="sortSvByColumn('trangthai')" class="px-5 py-3.5 font-semibold text-center cursor-pointer hover:text-primary transition-colors">
                            <span class="inline-flex items-center justify-center gap-1">Trạng thái <span id="sv-sort-icon-trangthai" class="text-text-muted/40">↕</span></span>
                        </th>
                        <th class="px-5 py-3.5 font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="sv-tbody" class="divide-y divide-surface-hover"></tbody>
            </table>
        </div>
        <!-- Pagination Footer -->
        <div class="px-5 py-3.5 border-t border-surface-hover bg-surface-header flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-text-muted">
            <div class="flex items-center gap-3">
                <span id="sv-pagination-info">Đang tải...</span>
                <div class="flex items-center gap-1.5">
                    <span>Hiển thị</span>
                    <select id="sv-page-size" onchange="changeSvPageSize(this.value)" class="bg-canvas border border-surface-hover rounded-lg px-2 py-1 text-xs text-text-primary outline-none focus:border-primary">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>/ trang</span>
                </div>
            </div>
            <div id="sv-pagination-controls" class="flex items-center gap-1"></div>
        </div>
    </div>
</div>

<!-- Modal Add/Edit Sinh Vien -->
<div id="sv-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-hover rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden">
        <div class="p-5 border-b border-surface-hover bg-surface-header flex justify-between items-center">
            <h3 id="sv-modal-title" class="text-lg font-bold text-text-primary">Thêm Sinh Viên Mới</h3>
            <button onclick="closeSvModal()" class="text-text-muted hover:text-[#ef4444]"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form onsubmit="saveSinhVien(event)" class="p-6 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs text-text-muted mb-1">Mã Sinh Viên *</label>
                    <input id="m-masv" required class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Họ và Tên *</label>
                    <input id="m-hoten" required class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Ngày sinh</label>
                    <input id="m-ngaysinh" type="date" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Giới tính</label>
                    <select id="m-gioitinh" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Lớp Hành Chính</label>
                    <select id="m-malop" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none"></select>
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Trạng thái học tập</label>
                    <select id="m-trangthai" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
                        <option value="Đang học">Đang học</option>
                        <option value="Bảo lưu">Bảo lưu</option>
                        <option value="Đã tốt nghiệp">Đã tốt nghiệp</option>
                        <option value="Thôi học">Thôi học</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Email</label>
                    <input id="m-email" type="email" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Số điện thoại</label>
                    <input id="m-sdt" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Số CCCD</label>
                    <input id="m-cccd" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Địa chỉ</label>
                    <input id="m-diachi" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
                </div>
            </div>
            <div class="pt-4 border-t border-surface-hover flex justify-end gap-3">
                <button type="button" onclick="closeSvModal()" class="px-4 py-2 rounded-lg border border-surface-hover text-sm text-text-muted hover:bg-surface-hover">Hủy</button>
                <button type="submit" class="px-5 py-2 rounded-lg bg-primary text-white text-sm font-bold hover:bg-primary/90">Lưu Dữ Liệu</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Xác Thực Mật Khẩu Khi Xóa -->
<div id="pwd-confirm-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-hover rounded-2xl w-full max-w-md shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        <div class="p-5 border-b border-surface-hover bg-surface-header flex justify-between items-center">
            <h3 class="text-base font-bold text-text-primary flex items-center gap-2">
                <i data-lucide="shield-alert" class="w-5 h-5 text-[#ef4444]"></i> Xác Thực Mật Khẩu Xóa
            </h3>
            <button onclick="closePwdConfirmModal()" class="text-text-muted hover:text-[#ef4444] transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form onsubmit="handlePwdConfirmSubmit(event)" class="p-6 space-y-4">
            <p class="text-xs text-text-muted leading-relaxed">
                Hành động này mang tính chất quan trọng và không thể hoàn tác. Để tiếp tục xóa <span id="pwd-confirm-item-name" class="font-bold text-text-primary"></span>, vui lòng nhập mật khẩu tài khoản của bạn để xác thực:
            </p>
            <div>
                <label class="block text-xs font-semibold text-text-muted mb-1.5">Mật khẩu tài khoản *</label>
                <div class="relative">
                    <i data-lucide="lock" class="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
                    <input id="pwd-confirm-input" type="password" required placeholder="Nhập mật khẩu của bạn..."
                           class="w-full bg-canvas border border-surface-hover rounded-xl pl-9 pr-3 py-2.5 text-sm text-text-primary focus:border-[#ef4444] focus:outline-none transition-colors" />
                </div>
                <p id="pwd-confirm-error" class="hidden text-xs text-[#ef4444] font-medium mt-1.5 flex items-center gap-1">
                    <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span id="pwd-confirm-error-msg">Mật khẩu xác thực không chính xác!</span>
                </p>
            </div>
            <div class="pt-2 border-t border-surface-hover flex justify-end gap-3">
                <button type="button" onclick="closePwdConfirmModal()" class="px-4 py-2 rounded-xl border border-surface-hover text-xs font-semibold text-text-muted hover:bg-surface-hover transition-colors">Hủy bỏ</button>
                <button type="submit" id="btn-pwd-confirm-submit" class="px-5 py-2 rounded-xl bg-[#ef4444] hover:bg-[#ef4444]/90 text-white text-xs font-bold shadow-lg shadow-[#ef4444]/20 flex items-center gap-1.5 transition-all">
                    <i data-lucide="trash-2" class="w-4 h-4"></i> Xác nhận xóa
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let svList = [], khoas = [], nganhs = [], lops = [];
        let editingMaSV = null;
        let svCurrentPage = 1, svPageSize = 10;
        let svSortCol = 'masv', svSortDir = 'asc', svSortParam = 'masv_asc';
        let svRequest = 0, svSearchTimer;
        function queueSvSearch() { clearTimeout(svSearchTimer); svSearchTimer = setTimeout(() => renderSvTable(true), 250); }

        function onSvSortDropdownChange(val) {
            svSortParam = val;
            if (val === 'newest' || val === 'oldest') {
                svSortCol = '';
            } else {
                const parts = val.split('_');
                svSortCol = parts[0] || 'masv';
                svSortDir = parts[1] || 'asc';
            }
            updateSvSortIcons();
            renderSvTable(true);
        }

        function sortSvByColumn(col) {
            if (svSortCol === col) {
                svSortDir = svSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                svSortCol = col;
                svSortDir = 'asc';
            }
            svSortParam = `${svSortCol}_${svSortDir}`;
            const selectEl = document.getElementById('sv-sort');
            if (selectEl && [...selectEl.options].some(o => o.value === svSortParam)) {
                selectEl.value = svSortParam;
            }
            updateSvSortIcons();
            renderSvTable(true);
        }

        function updateSvSortIcons() {
            ['masv', 'hoten', 'gioitinh', 'ngaysinh', 'malop', 'nganh', 'trangthai'].forEach(c => {
                const el = document.getElementById(`sv-sort-icon-${c}`);
                if (!el) return;
                if (c === svSortCol) {
                    el.textContent = svSortDir === 'asc' ? '🔼' : '🔽';
                    el.className = 'text-primary';
                } else {
                    el.textContent = '↕';
                    el.className = 'text-text-muted/40';
                }
            });
        }

        async function loadData() {
            const [resKhoa, resNganh, resLop] = await Promise.all([
                apiFetch('/api/khoa'),
                apiFetch('/api/nganh'),
                apiFetch('/api/lophanhchinh')
            ]);
            khoas = resKhoa.data || [];
            nganhs = resNganh.data || [];
            lops = resLop.data || [];

            const selKhoa = document.getElementById('sv-khoa');
            selKhoa.innerHTML = '<option value="">Tất cả Khoa</option>' + khoas.map(k => `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`).join('');

            const mLop = document.getElementById('m-malop');
            mLop.innerHTML = lops.map(l => `<option value="${l.MaLop}">${l.MaLop} - ${l.TenLop}</option>`).join('');

            onFilterKhoaChange();
        }

        function onFilterKhoaChange() {
            const maKhoa = document.getElementById('sv-khoa').value;
            const selNganh = document.getElementById('sv-nganh');
            selNganh.innerHTML = '<option value="">Tất cả Ngành</option>' +
                nganhs.filter(n => !maKhoa || n.MaKhoa === maKhoa).map(n => `<option value="${n.MaNganh}">${n.TenNganh}</option>`).join('');
            onFilterNganhChange();
        }

        function onFilterNganhChange() {
            const maNganh = document.getElementById('sv-nganh').value;
            const selLop = document.getElementById('sv-lop');
            selLop.innerHTML = '<option value="">Tất cả Lớp hành chính</option>' +
                lops.filter(l => !maNganh || l.MaNganh === maNganh).map(l => `<option value="${l.MaLop}">${l.MaLop} - ${l.TenLop}</option>`).join('');
            renderSvTable(true);
        }

        function studentParams(page = svCurrentPage, pageSize = svPageSize) {
            return new URLSearchParams({ page, pageSize,
                search: document.getElementById('sv-search').value.trim(),
                maKhoa: document.getElementById('sv-khoa').value,
                maNganh: document.getElementById('sv-nganh').value,
                maLop: document.getElementById('sv-lop').value,
                status: document.getElementById('sv-status').value,
                sort: svSortParam
            });
        }
        async function renderSvTable(resetPage = false) {
            if (resetPage) svCurrentPage = 1;
            const request = ++svRequest;
            let response;
            try { response = await apiFetch('/api/sinhvien?' + studentParams()); }
            catch (error) { if (request === svRequest) showToast(error.message, 'error'); return; }
            if (request !== svRequest) return;
            svList = (response.data || []).map(s => ({ ...s, LopHanhChinh: lops.find(l => l.MaLop === s.MaLop) || s.LopHanhChinh }));
            svCurrentPage = response.page;
            const totalItems = response.total, totalPages = response.totalPages;
            const startIndex = (svCurrentPage - 1) * svPageSize;
            const endIndex = Math.min(startIndex + svList.length, totalItems);
            const paged = svList;

            const tbody = document.getElementById('sv-tbody');

            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-text-muted">Không tìm thấy sinh viên nào phù hợp</td></tr>`;
            } else {
                tbody.innerHTML = paged.map(s => {
                    const statusBadge = s.TrangThai === 'Đang học'
                        ? 'bg-[#10B981]/15 text-[#10B981]'
                        : s.TrangThai === 'Bảo lưu'
                            ? 'bg-amber-500/15 text-amber-400'
                            : 'bg-surface-hover text-text-muted';
                    return `
                        <tr class="hover:bg-surface-hover/40 transition-colors">
                            <td class="px-5 py-3.5 font-bold text-primary">${s.MaSV}</td>
                            <td class="px-5 py-3.5 font-medium text-text-primary">
                                <div>${s.HoTen}</div>
                                <div class="text-xs text-text-muted">${s.Email || ''}</div>
                            </td>
                            <td class="px-5 py-3.5 text-text-muted">${s.GioiTinh || ''}</td>
                            <td class="px-5 py-3.5 text-text-muted">${s.NgaySinh ? new Date(s.NgaySinh).toLocaleDateString('vi-VN') : ''}</td>
                            <td class="px-5 py-3.5 font-medium text-text-primary">${s.MaLop || ''}</td>
                            <td class="px-5 py-3.5 text-xs text-text-muted">
                                <div class="text-text-primary font-medium">${s.LopHanhChinh?.Nganh?.TenNganh || ''}</div>
                                <div>${s.LopHanhChinh?.Nganh?.Khoa?.TenKhoa || ''}</div>
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${statusBadge}">${s.TrangThai || 'Đang học'}</span>
                            </td>
                            <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                <div class="inline-flex items-center justify-end gap-1.5">
                                    <a href="/tra-cuu-diem?maSV=${encodeURIComponent(s.MaSV)}" title="Xem bảng điểm" class="p-1.5 rounded-lg text-text-muted hover:text-[#10B981] hover:bg-[#10B981]/10 transition-colors"><i data-lucide="award" class="w-4 h-4"></i></a>
                                    <button onclick="openSvModalById('${s.MaSV.replace(/'/g, "\\'")}')" class="p-1.5 rounded-lg text-text-muted hover:text-primary hover:bg-primary/10 transition-colors"><i data-lucide="edit" class="w-4 h-4"></i></button>
                                    <button onclick="deleteSv('${s.MaSV.replace(/'/g, "\\'")}')" class="p-1.5 rounded-lg text-text-muted hover:text-[#ef4444] hover:bg-[#ef4444]/10 transition-colors"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            renderSvPagination(totalItems, totalPages, startIndex, endIndex);
            lucide.createIcons();
        }

        function renderSvPagination(totalItems, totalPages, startIndex, endIndex) {
            const infoEl = document.getElementById('sv-pagination-info');
            if (infoEl) {
                if (totalItems === 0) infoEl.textContent = '0 sinh viên';
                else infoEl.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên ${totalItems} sinh viên`;
            }

            const controlsEl = document.getElementById('sv-pagination-controls');
            if (!controlsEl) return;
            if (totalPages <= 1) {
                controlsEl.innerHTML = '';
                return;
            }

            let html = '';
            const prevDisabled = svCurrentPage === 1;
            html += `<button onclick="changeSvPage(${svCurrentPage - 1})" ${prevDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${prevDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-left" class="w-3.5 h-3.5 inline"></i></button>`;

            const startP = Math.max(1, svCurrentPage - 2);
            const endP = Math.min(totalPages, svCurrentPage + 2);

            if (startP > 1) {
                html += `<button onclick="changeSvPage(1)" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">1</button>`;
                if (startP > 2) html += `<span class="px-1 text-text-muted">...</span>`;
            }

            for (let p = startP; p <= endP; p++) {
                const isActive = p === svCurrentPage;
                html += `<button onclick="changeSvPage(${p})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all ${isActive ? 'bg-primary text-white shadow-md shadow-primary/20' : 'border border-surface-hover hover:bg-surface-hover text-text-primary'}">${p}</button>`;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) html += `<span class="px-1 text-text-muted">...</span>`;
                html += `<button onclick="changeSvPage(${totalPages})" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">${totalPages}</button>`;
            }

            const nextDisabled = svCurrentPage === totalPages;
            html += `<button onclick="changeSvPage(${svCurrentPage + 1})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${nextDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-right" class="w-3.5 h-3.5 inline"></i></button>`;

            controlsEl.innerHTML = html;
        }

        function changeSvPage(page) {
            svCurrentPage = page;
            renderSvTable();
        }

        function changeSvPageSize(size) {
            svPageSize = parseInt(size, 10);
            svCurrentPage = 1;
            renderSvTable();
        }

        function openSvModalById(maSV) {
            const sv = svList.find(x => x.MaSV === maSV);
            openSvModal(sv || null);
        }

        function openSvModal(sv = null) {
            editingMaSV = sv ? sv.MaSV : null;
            document.getElementById('sv-modal-title').textContent = sv ? 'Cập Nhật Hồ Sơ Sinh Viên' : 'Thêm Sinh Viên Mới';
            const maSvInput = document.getElementById('m-masv');
            maSvInput.value = sv ? sv.MaSV : '';
            maSvInput.disabled = !!sv;
            document.getElementById('m-hoten').value = sv ? sv.HoTen : '';
            document.getElementById('m-ngaysinh').value = sv && sv.NgaySinh ? sv.NgaySinh.substring(0, 10) : '2004-01-01';
            document.getElementById('m-gioitinh').value = sv ? (sv.GioiTinh || 'Nam') : 'Nam';
            document.getElementById('m-malop').value = sv ? (sv.MaLop || (lops[0]?.MaLop || '')) : (lops[0]?.MaLop || '');
            document.getElementById('m-trangthai').value = sv ? (sv.TrangThai || 'Đang học') : 'Đang học';
            document.getElementById('m-email').value = sv ? (sv.Email || '') : '';
            document.getElementById('m-sdt').value = sv ? (sv.SDT || '') : '';
            document.getElementById('m-cccd').value = sv ? (sv.CCCD || '') : '';
            document.getElementById('m-diachi').value = sv ? (sv.DiaChi || '') : '';
            document.getElementById('sv-modal').classList.remove('hidden');
        }

        function closeSvModal() {
            document.getElementById('sv-modal').classList.add('hidden');
        }

        async function saveSinhVien(e) {
            e.preventDefault();
            const payload = {
                MaSV: document.getElementById('m-masv').value.trim(),
                HoTen: document.getElementById('m-hoten').value.trim(),
                NgaySinh: document.getElementById('m-ngaysinh').value || null,
                GioiTinh: document.getElementById('m-gioitinh').value,
                MaLop: document.getElementById('m-malop').value,
                TrangThai: document.getElementById('m-trangthai').value,
                Email: document.getElementById('m-email').value.trim(),
                SDT: document.getElementById('m-sdt').value.trim(),
                CCCD: document.getElementById('m-cccd').value.trim(),
                DiaChi: document.getElementById('m-diachi').value.trim()
            };

            try {
                if (editingMaSV) {
                    await apiFetch(`/api/sinhvien/${editingMaSV}`, { method: 'PUT', body: JSON.stringify(payload) });
                    showToast('Đã cập nhật sinh viên!');
                } else {
                    await apiFetch('/api/sinhvien', { method: 'POST', body: JSON.stringify(payload) });
                    showToast('Đã thêm sinh viên mới!');
                }
                closeSvModal();
                await loadData();
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        let pendingDeleteAction = null;

        function deleteSv(maSV) {
            const sv = svList.find(x => x.MaSV === maSV);
            const label = sv ? `Sinh viên "${sv.MaSV} - ${sv.HoTen}"` : `Sinh viên "${maSV}"`;
            requestSecureDelete(label, async () => {
                await apiFetch(`/api/sinhvien/${encodeURIComponent(maSV)}`, { method: 'DELETE' });
                showToast('Đã xóa sinh viên!');
                await loadData();
            });
        }

        function requestSecureDelete(itemName, callback) {
            pendingDeleteAction = callback;
            document.getElementById('pwd-confirm-item-name').textContent = itemName;
            document.getElementById('pwd-confirm-input').value = '';
            document.getElementById('pwd-confirm-error').classList.add('hidden');
            document.getElementById('pwd-confirm-modal').classList.remove('hidden');
            setTimeout(() => document.getElementById('pwd-confirm-input').focus(), 100);
            lucide.createIcons();
        }

        function closePwdConfirmModal() {
            pendingDeleteAction = null;
            document.getElementById('pwd-confirm-modal').classList.add('hidden');
            document.getElementById('pwd-confirm-input').value = '';
            document.getElementById('pwd-confirm-error').classList.add('hidden');
        }

        async function handlePwdConfirmSubmit(e) {
            e.preventDefault();
            const pwd = document.getElementById('pwd-confirm-input').value;
            const errBox = document.getElementById('pwd-confirm-error');
            const errMsg = document.getElementById('pwd-confirm-error-msg');
            const btnSubmit = document.getElementById('btn-pwd-confirm-submit');

            errBox.classList.add('hidden');
            btnSubmit.disabled = true;
            btnSubmit.classList.add('opacity-70');

            try {
                await apiFetch('/api/auth/verify-password', {
                    method: 'POST',
                    body: JSON.stringify({ Password: pwd })
                });

                if (typeof pendingDeleteAction === 'function') {
                    await pendingDeleteAction();
                }
                closePwdConfirmModal();
            } catch (err) {
                errBox.classList.remove('hidden');
                errMsg.textContent = err.message || 'Mật khẩu xác thực không chính xác!';
                lucide.createIcons();
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.classList.remove('opacity-70');
            }
        }

        async function exportSinhVienExcel() {
            const selectedParams = studentParams(1, 100);
            const students = [];
            try {
                let page = 1, totalPages = 1;
                do {
                    selectedParams.set('page', page);
                    const response = await apiFetch('/api/sinhvien?' + selectedParams);
                    students.push(...response.data);
                    totalPages = response.totalPages;
                    page++;
                } while (page <= totalPages);
            } catch (error) { showToast(error.message, 'error'); return; }
            const rows = students.map((s, idx) => ({
                'STT': idx + 1,
                'MaSV': s.MaSV,
                'HoTen': s.HoTen,
                'GioiTinh': s.GioiTinh,
                'NgaySinh': s.NgaySinh ? s.NgaySinh.substring(0, 10) : '',
                'MaLop': s.MaLop,
                'Email': s.Email,
                'SDT': s.SDT,
                'TrangThai': s.TrangThai
            }));
            const ws = XLSX.utils.json_to_sheet(rows);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'DanhSachSinhVien');
            XLSX.writeFile(wb, 'DanhSach_SinhVien.xlsx');
        }

        function handleExcelUpload(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = async (evt) => {
                const wb = XLSX.read(evt.target.result, { type: 'binary' });
                const ws = wb.Sheets[wb.SheetNames[0]];
                const json = XLSX.utils.sheet_to_json(ws);
                const mapped = json.map(r => ({
                    MaSV: String(r.MaSV || r['Mã SV'] || '').trim(),
                    HoTen: String(r.HoTen || r['Họ Tên'] || '').trim(),
                    GioiTinh: r.GioiTinh || r['Giới tính'] || 'Nam',
                    MaLop: String(r.MaLop || r['Mã Lớp'] || lops[0]?.MaLop || '').trim(),
                    Email: r.Email || '',
                    SDT: String(r.SDT || ''),
                    TrangThai: r.TrangThai || 'Đang học'
                })).filter(x => x.MaSV && x.HoTen);

                try {
                    const res = await apiFetch('/api/sinhvien/bulk', { method: 'POST', body: JSON.stringify(mapped) });
                    showToast(res.message || 'Nhập Excel thành công!');
                    await loadData();
                } catch (err) {
                    showToast(err.message, 'error');
                }
            };
            reader.readAsBinaryString(file);
            e.target.value = '';
        }

        loadData();
    </script>
}
