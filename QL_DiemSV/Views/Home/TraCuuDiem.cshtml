@using System.Security.Claims
@{
    Layout = "_Layout";
    var roleName = User.FindFirst(ClaimTypes.Role)?.Value ?? "SinhVien";
    var currentMaSV = User.FindFirst("MaSV")?.Value ?? (roleName == "SinhVien" ? (User.Identity?.Name ?? "") : "");
    var isStudent = roleName == "SinhVien";
}

<div class="max-w-[1600px] mx-auto space-y-6">
    <!-- Top Header -->
    <div class="bg-surface border border-surface-hover rounded-2xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-text-muted font-medium mb-1">Điểm số & Phúc khảo &gt; Kết quả học tập & Tốt nghiệp</div>
            <h1 class="text-2xl font-bold text-text-primary">Tra Cứu Điểm & Xét Điều Kiện Tốt Nghiệp</h1>
            <p class="text-xs text-text-muted mt-1">
                @if (isStudent)
                {
                    <span>Theo dõi bảng điểm chi tiết, tiến độ tích lũy tín chỉ và gửi phúc khảo trực tuyến.</span>
                }
                else
                {
                    <span>Tra cứu kết quả học tập của sinh viên theo Khóa học, Khoa, Lớp hành chính hoặc tìm kiếm nhanh.</span>
                }
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button id="btn-back-to-list" onclick="backToList()" class="hidden px-4 py-2.5 rounded-xl bg-surface border border-surface-hover hover:border-primary text-text-primary text-sm font-semibold flex items-center gap-2 transition-all">
                <i data-lucide="arrow-left" class="w-4 h-4 text-primary"></i> Quay lại danh sách SV
            </button>
            <button type="button" onclick="window.print()" class="px-4 py-2.5 rounded-xl bg-canvas border border-surface-hover hover:border-primary text-text-primary text-sm font-semibold flex items-center gap-2 transition-all">
                <i data-lucide="printer" class="w-4 h-4 text-primary"></i> In Bảng Điểm
            </button>
        </div>
    </div>

    @if (!isStudent)
    {
        <!-- SECTION 1: FILTER BAR & DANH SÁCH SINH VIÊN (Dành cho Admin, Giảng viên, Khảo thí) -->
        <div id="section-search-students" class="space-y-6">
            <!-- Filter Bar Component -->
            <div class="bg-surface border border-surface-hover rounded-2xl p-5 space-y-4">
                <div class="text-xs font-bold uppercase tracking-wider text-text-primary flex items-center gap-2">
                    <i data-lucide="filter" class="w-4 h-4 text-primary"></i> Bộ Lọc Tìm Kiếm Sinh Viên
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Dropdown Khóa học (Niên khóa) -->
                    <div>
                        <label class="block text-xs font-medium text-text-muted mb-1.5">Khóa học (Niên khóa)</label>
                        <select id="tc-filter-nienkhoa" onchange="onNienKhoaOrKhoaChange()" class="w-full bg-canvas border border-surface-hover rounded-xl px-3.5 py-2.5 text-sm text-text-primary focus:border-primary outline-none transition-colors">
                            <option value="">Tất cả Khóa học</option>
                        </select>
                    </div>

                    <!-- Dropdown Khoa -->
                    <div>
                        <label class="block text-xs font-medium text-text-muted mb-1.5">Khoa</label>
                        <select id="tc-filter-khoa" onchange="onNienKhoaOrKhoaChange()" class="w-full bg-canvas border border-surface-hover rounded-xl px-3.5 py-2.5 text-sm text-text-primary focus:border-primary outline-none transition-colors">
                            <option value="">Tất cả Khoa</option>
                        </select>
                    </div>

                    <!-- Dropdown Lớp (cập nhật động theo Khoa/Khóa) -->
                    <div>
                        <label class="block text-xs font-medium text-text-muted mb-1.5">Lớp hành chính</label>
                        <select id="tc-filter-lop" class="w-full bg-canvas border border-surface-hover rounded-xl px-3.5 py-2.5 text-sm text-text-primary focus:border-primary outline-none transition-colors">
                            <option value="">Tất cả Lớp</option>
                        </select>
                    </div>

                    <!-- Search Input: Mã SV hoặc Họ tên -->
                    <div>
                        <label class="block text-xs font-medium text-text-muted mb-1.5">Tìm kiếm nhanh</label>
                        <div class="relative">
                            <i data-lucide="search" class="w-4 h-4 text-text-muted absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                            <input id="tc-filter-keyword" type="text" placeholder="Mã SV hoặc Họ và tên..."
                                   class="w-full bg-canvas border border-surface-hover rounded-xl pl-10 pr-3.5 py-2.5 text-sm text-text-primary focus:border-primary outline-none transition-colors" />
                        </div>
                    </div>
                </div>

                <!-- Action Buttons: Lọc / Tìm kiếm & Đặt lại -->
                <div class="flex items-center justify-end gap-3 pt-2 border-t border-surface-hover">
                    <button type="button" onclick="resetFilters()" class="px-4 py-2 rounded-xl bg-canvas border border-surface-hover hover:border-primary text-text-muted hover:text-text-primary text-xs font-semibold flex items-center gap-1.5 transition-colors">
                        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Đặt lại bộ lọc
                    </button>
                    <button type="button" onclick="applyFilters()" class="px-5 py-2 rounded-xl bg-primary hover:bg-primary/90 text-white text-xs font-bold shadow-lg shadow-primary/20 flex items-center gap-1.5 transition-all">
                        <i data-lucide="search" class="w-3.5 h-3.5"></i> Lọc / Tìm kiếm
                    </button>
                </div>
            </div>

            <!-- Bảng danh sách sinh viên kết quả -->
            <div class="bg-surface border border-surface-hover rounded-2xl overflow-hidden shadow-sm">
                <div class="p-4 border-b border-surface-hover bg-surface-header flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <i data-lucide="users" class="w-4 h-4 text-primary"></i>
                        <span class="text-sm font-bold text-text-primary">Kết Quả Danh Sách Sinh Viên</span>
                    </div>
                    <span id="sv-results-count" class="text-xs text-text-muted font-medium">Đang tải...</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-surface-header border-b border-surface-hover text-xs text-text-muted uppercase tracking-wider">
                                <th class="px-5 py-3.5 font-semibold text-center w-14">STT</th>
                                <th class="px-5 py-3.5 font-semibold">Mã SV</th>
                                <th class="px-5 py-3.5 font-semibold">Họ và Tên</th>
                                <th class="px-5 py-3.5 font-semibold">Giới tính</th>
                                <th class="px-5 py-3.5 font-semibold">Ngày sinh</th>
                                <th class="px-5 py-3.5 font-semibold">Lớp hành chính</th>
                                <th class="px-5 py-3.5 font-semibold">Ngành / Khoa</th>
                                <th class="px-5 py-3.5 font-semibold text-center">Trạng thái</th>
                                <th class="px-5 py-3.5 font-semibold text-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="sv-results-tbody" class="divide-y divide-surface-hover">
                            <tr>
                                <td colspan="9" class="p-8 text-center text-text-muted">Đang tải danh sách sinh viên...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="px-5 py-3.5 border-t border-surface-hover bg-surface-header flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-text-muted">
                    <div class="flex items-center gap-3">
                        <span id="sv-results-pagination-info">Đang tải...</span>
                        <div class="flex items-center gap-1.5">
                            <span>Hiển thị</span>
                            <select id="sv-results-page-size" onchange="changeSvPageSize(this.value)" class="bg-canvas border border-surface-hover rounded-lg px-2 py-1 text-xs text-text-primary outline-none focus:border-primary">
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                            <span>/ trang</span>
                        </div>
                    </div>
                    <div id="sv-results-pagination-controls" class="flex items-center gap-1"></div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 2: CHI TIẾT BẢNG ĐIỂM & TIẾN ĐỘ TỐT NGHIỆP CỦA SINH VIÊN -->
    <div id="section-student-detail" class="@(!isStudent ? "hidden" : "") space-y-6">
        <!-- Student Profile + Graduation Eligibility -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Student Info Card -->
            <div class="lg:col-span-5 bg-surface border border-surface-hover rounded-2xl p-6 space-y-4">
                <div class="flex items-center gap-4 border-b border-surface-hover pb-4">
                    <div class="w-14 h-14 rounded-2xl bg-primary/15 text-primary font-extrabold text-xl flex items-center justify-center">
                        <i data-lucide="user-check" class="w-7 h-7"></i>
                    </div>
                    <div>
                        <h2 id="info-hoten" class="text-xl font-extrabold text-text-primary">--</h2>
                        <div class="text-xs font-bold text-primary mt-0.5">MSSV: <span id="info-masv">--</span> • Lớp: <span id="info-lop">--</span></div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div class="p-3 rounded-xl bg-canvas border border-surface-hover">
                        <div class="text-text-muted">Ngành đào tạo</div>
                        <div id="info-nganh" class="font-bold text-text-primary mt-1">--</div>
                    </div>
                    <div class="p-3 rounded-xl bg-canvas border border-surface-hover">
                        <div class="text-text-muted">Khoa quản lý</div>
                        <div id="info-khoa" class="font-bold text-text-primary mt-1">--</div>
                    </div>
                    <div class="p-3 rounded-xl bg-canvas border border-surface-hover">
                        <div class="text-text-muted">GPA Tích lũy (Hệ 10 / Hệ 4)</div>
                        <div class="font-extrabold text-base text-primary mt-1"><span id="info-gpa10">0.0</span> / <span id="info-gpa4" class="text-[#10B981]">0.0</span></div>
                    </div>
                    <div class="p-3 rounded-xl bg-canvas border border-surface-hover">
                        <div class="text-text-muted">Xếp loại Học lực</div>
                        <div id="info-xeploai" class="font-extrabold text-base text-amber-400 mt-1">--</div>
                    </div>
                </div>
            </div>

            <!-- Graduation Progress Card -->
            <div class="lg:col-span-7 bg-surface border border-surface-hover rounded-2xl p-6 flex flex-col justify-between space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-text-primary flex items-center gap-2">
                        <i data-lucide="graduation-cap" class="w-5 h-5 text-primary"></i> Kết Quả Xét Điều Kiện Tốt Nghiệp Tự Động
                    </h3>
                    <span id="grad-badge" class="px-3 py-1 rounded-full text-xs font-bold">--</span>
                </div>

                <div class="grid grid-cols-3 gap-4 text-center">
                    <div class="p-3.5 rounded-xl bg-canvas border border-surface-hover">
                        <div class="text-xs text-text-muted">Tổng Tín Chỉ Tích Lũy</div>
                        <div id="grad-tc-tong" class="text-lg font-extrabold text-primary mt-1">0 / 0</div>
                    </div>
                    <div class="p-3.5 rounded-xl bg-canvas border border-surface-hover">
                        <div class="text-xs text-text-muted">Tín Chỉ Bắt Buộc</div>
                        <div id="grad-tc-bb" class="text-lg font-extrabold text-[#10B981] mt-1">0 / 0</div>
                    </div>
                    <div class="p-3.5 rounded-xl bg-canvas border border-surface-hover">
                        <div class="text-xs text-text-muted">Tín Chỉ Tự Chọn</div>
                        <div id="grad-tc-tc" class="text-lg font-extrabold text-amber-400 mt-1">0 / 0</div>
                    </div>
                </div>

                <div id="grad-reasons" class="p-3.5 rounded-xl bg-canvas border border-surface-hover text-xs space-y-1"></div>
            </div>
        </div>

        <!-- Semesters Transcript -->
        <div id="tc-semesters" class="space-y-6"></div>
        <section id="tc-overall-summary" class="bg-surface border border-surface-hover rounded-2xl overflow-hidden" aria-label="Tổng kết điểm sinh viên"></section>
    </div>
</div>

<!-- Modal Gửi Đơn Phúc Khảo / Khiếu Nại Điểm -->
<div id="appeal-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-hover rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="p-5 border-b border-surface-hover bg-surface-header flex justify-between items-center">
            <h3 class="text-base font-bold text-text-primary flex items-center gap-2">
                <i data-lucide="message-square-warning" class="w-4 h-4 text-amber-400"></i> Gửi Đơn Phúc Khảo Điểm
            </h3>
            <button onclick="document.getElementById('appeal-modal').classList.add('hidden')" class="text-text-muted hover:text-[#ef4444]"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form onsubmit="submitAppeal(event)" class="p-6 space-y-4">
            <input type="hidden" id="ap-malhp" />
            <input type="hidden" id="ap-masv" />
            <div>
                <label class="block text-xs text-text-muted mb-1">Học phần phúc khảo</label>
                <input id="ap-tenmon" readonly class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm font-bold text-primary" />
            </div>
            <div>
                <label class="block text-xs text-text-muted mb-1">Cột điểm cần phúc khảo</label>
                <select id="ap-loaidiem" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary">
                    <option value="quatrinh">Điểm Quá Trình (40%)</option>
                    <option value="thiLan1">Điểm Thi Kết Thúc Lần 1 (60%)</option>
                    <option value="thiLan2">Điểm Thi Lại Lần 2</option>
                </select>
            </div>
            <div>
                <label class="block text-xs text-text-muted mb-1">Lý do khiếu nại / phúc khảo *</label>
                <textarea id="ap-lydo" required rows="3" placeholder="Trình bày rõ lý do đề nghị giảng viên kiểm tra lại điểm..."
                          class="w-full bg-canvas border border-surface-hover rounded-lg p-3 text-sm text-text-primary outline-none focus:border-primary"></textarea>
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="document.getElementById('appeal-modal').classList.add('hidden')" class="px-4 py-2 rounded-lg border border-surface-hover text-xs text-text-muted">Hủy</button>
                <button type="submit" class="px-5 py-2 rounded-lg bg-primary text-white text-xs font-bold">Gửi Đơn Phúc Khảo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const IS_STUDENT = @(isStudent ? "true" : "false");
        const CURRENT_STUDENT_ID = "@currentMaSV";
        
        let allStudents = [];
        let allKhoas = [];
        let allLops = [];
        let activeStudentMaSV = null;
        let currentFilteredSv = [];
        let svCurrentPage = 1, svPageSize = 10;

        async function initPage() {
            if (IS_STUDENT) {
                // Nếu là sinh viên, load thẳng bảng điểm của chính mình
                if (CURRENT_STUDENT_ID) {
                    await loadTranscript(CURRENT_STUDENT_ID);
                } else {
                    document.getElementById('tc-semesters').innerHTML = '<div class="p-8 text-center text-text-muted">Không xác định được mã sinh viên của tài khoản.</div>';
                }
                return;
            }

            // Với Admin / Giảng viên / Khảo thí: tải danh mục để phục vụ bộ lọc
            try {
                const [resKhoa, resLop] = await Promise.all([
                    apiFetch('/api/khoa'),
                    apiFetch('/api/lophanhchinh')
                ]);

                allStudents = [];
                allKhoas = resKhoa.data || [];
                allLops = resLop.data || [];
                currentFilteredSv = allStudents;

                populateFilterOptions();
                renderStudentResultsTable();

                // Cho phép nhấn Enter trên ô tìm kiếm
                document.getElementById('tc-filter-keyword').addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        applyFilters();
                    }
                });
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        // Đổ dữ liệu vào các dropdown lọc
        function populateFilterOptions() {
            // 1. Niên khóa (Lấy distinct từ danh sách lớp)
            const nienKhoas = [...new Set(allLops.map(l => l.NienKhoa).filter(Boolean))].sort();
            const selNienKhoa = document.getElementById('tc-filter-nienkhoa');
            selNienKhoa.innerHTML = '<option value="">Tất cả Khóa học</option>' +
                nienKhoas.map(nk => `<option value="${nk}">${nk}</option>`).join('');

            // 2. Khoa
            const selKhoa = document.getElementById('tc-filter-khoa');
            selKhoa.innerHTML = '<option value="">Tất cả Khoa</option>' +
                allKhoas.map(k => `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`).join('');

            // 3. Lớp hành chính ban đầu
            updateLopDropdown();
        }

        // Cập nhật động danh sách lớp theo Khoa & Niên khóa đã chọn
        function onNienKhoaOrKhoaChange() {
            updateLopDropdown();
        }

        function updateLopDropdown() {
            const selectedNienKhoa = document.getElementById('tc-filter-nienkhoa').value;
            const selectedKhoa = document.getElementById('tc-filter-khoa').value;

            const filteredLops = allLops.filter(l => {
                const matchNienKhoa = !selectedNienKhoa || l.NienKhoa === selectedNienKhoa;
                const matchKhoa = !selectedKhoa || l.Nganh?.MaKhoa === selectedKhoa;
                return matchNienKhoa && matchKhoa;
            });

            const selLop = document.getElementById('tc-filter-lop');
            selLop.innerHTML = '<option value="">Tất cả Lớp</option>' +
                filteredLops.map(l => `<option value="${l.MaLop}">${l.MaLop} - ${l.TenLop}</option>`).join('');
        }

        // Áp dụng bộ lọc và từ khóa
        function applyFilters() {
            svCurrentPage = 1;
            renderStudentResultsTable();
        }

        // Đặt lại bộ lọc về mặc định
        function resetFilters() {
            document.getElementById('tc-filter-nienkhoa').value = '';
            document.getElementById('tc-filter-khoa').value = '';
            document.getElementById('tc-filter-keyword').value = '';
            updateLopDropdown();
            currentFilteredSv = allStudents;
            svCurrentPage = 1;
            renderStudentResultsTable();
        }

        // Hiển thị danh sách sinh viên kết quả vào table với phân trang
        let studentLookupRequest = 0;
        async function renderStudentResultsTable() {
            const request = ++studentLookupRequest;
            const params = new URLSearchParams({ page: svCurrentPage, pageSize: svPageSize,
                maLop: document.getElementById('tc-filter-lop').value,
                maKhoa: document.getElementById('tc-filter-khoa').value,
                cohort: document.getElementById('tc-filter-nienkhoa').value,
                search: document.getElementById('tc-filter-keyword').value.trim()
            });
            let response;
            try { response = await apiFetch('/api/sinhvien?' + params); }
            catch (error) { if (request === studentLookupRequest) showToast(error.message, 'error'); return; }
            if (request !== studentLookupRequest) return;
            svCurrentPage = response.page;
            const totalItems = response.total, totalPages = response.totalPages;
            const startIndex = (svCurrentPage - 1) * svPageSize;
            const paged = (response.data || []).map(s => ({ ...s, LopHanhChinh: allLops.find(l => l.MaLop === s.MaLop) || s.LopHanhChinh }));
            const endIndex = Math.min(startIndex + paged.length, totalItems);
            currentFilteredSv = paged;

            const tbody = document.getElementById('sv-results-tbody');
            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-text-muted">Không tìm thấy sinh viên nào phù hợp với điều kiện lọc</td></tr>`;
            } else {
                tbody.innerHTML = paged.map((s, idx) => {
                    const statusBadge = s.TrangThai === 'Đang học'
                        ? 'bg-[#10B981]/15 text-[#10B981]'
                        : s.TrangThai === 'Bảo lưu'
                            ? 'bg-amber-500/15 text-amber-400'
                            : 'bg-surface-hover text-text-muted';

                    return `
                        <tr class="hover:bg-surface-hover/40 transition-colors">
                            <td class="px-5 py-3.5 text-center text-text-muted font-medium">${startIndex + idx + 1}</td>
                            <td class="px-5 py-3.5 font-bold text-primary">${s.MaSV}</td>
                            <td class="px-5 py-3.5 font-medium text-text-primary">
                                <div>${s.HoTen}</div>
                                <div class="text-xs text-text-muted">${s.Email || ''}</div>
                            </td>
                            <td class="px-5 py-3.5 text-text-muted">${s.GioiTinh || ''}</td>
                            <td class="px-5 py-3.5 text-text-muted">${s.NgaySinh ? new Date(s.NgaySinh).toLocaleDateString('vi-VN') : ''}</td>
                            <td class="px-5 py-3.5 font-medium text-text-primary">
                                <div>${s.MaLop || ''}</div>
                                <div class="text-[11px] text-text-muted">${s.LopHanhChinh?.NienKhoa || ''}</div>
                            </td>
                            <td class="px-5 py-3.5 text-xs text-text-muted">
                                <div class="text-text-primary font-medium">${s.LopHanhChinh?.Nganh?.TenNganh || ''}</div>
                                <div>${s.LopHanhChinh?.Nganh?.Khoa?.TenKhoa || ''}</div>
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${statusBadge}">${s.TrangThai || 'Đang học'}</span>
                            </td>
                            <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                <button onclick="viewStudentDetail('${s.MaSV}')" class="px-3.5 py-1.5 rounded-xl bg-primary/15 text-primary hover:bg-primary hover:text-white text-xs font-bold transition-all inline-flex items-center gap-1.5">
                                    <i data-lucide="award" class="w-3.5 h-3.5"></i> Xem Bảng Điểm
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            renderSvPagination(totalItems, totalPages, startIndex, endIndex);
            lucide.createIcons();
        }

        function renderSvPagination(totalItems, totalPages, startIndex, endIndex) {
            const infoEl = document.getElementById('sv-results-pagination-info');
            if (infoEl) {
                if (totalItems === 0) infoEl.textContent = '0 sinh viên';
                else infoEl.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên ${totalItems} sinh viên`;
            }

            const controlsEl = document.getElementById('sv-results-pagination-controls');
            if (!controlsEl) return;
            if (totalPages <= 1) {
                controlsEl.innerHTML = '';
                return;
            }

            let html = '';
            const prevDisabled = svCurrentPage === 1;
            html += `<button onclick="changeSvPage(${svCurrentPage - 1})" ${prevDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${prevDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-left" class="w-3.5 h-3.5 inline"></i></button>`;

            const startP = Math.max(1, svCurrentPage - 2);
            const endP = Math.min(totalPages, svCurrentPage + 2);

            if (startP > 1) {
                html += `<button onclick="changeSvPage(1)" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">1</button>`;
                if (startP > 2) html += `<span class="px-1 text-text-muted">...</span>`;
            }

            for (let p = startP; p <= endP; p++) {
                const isActive = p === svCurrentPage;
                html += `<button onclick="changeSvPage(${p})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all ${isActive ? 'bg-primary text-white shadow-md shadow-primary/20' : 'border border-surface-hover hover:bg-surface-hover text-text-primary'}">${p}</button>`;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) html += `<span class="px-1 text-text-muted">...</span>`;
                html += `<button onclick="changeSvPage(${totalPages})" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">${totalPages}</button>`;
            }

            const nextDisabled = svCurrentPage === totalPages;
            html += `<button onclick="changeSvPage(${svCurrentPage + 1})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${nextDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-right" class="w-3.5 h-3.5 inline"></i></button>`;

            controlsEl.innerHTML = html;
        }

        function changeSvPage(page) {
            svCurrentPage = page;
            renderStudentResultsTable();
        }

        function changeSvPageSize(size) {
            svPageSize = parseInt(size, 10);
            svCurrentPage = 1;
            renderStudentResultsTable();
        }

        // Chọn xem chi tiết bảng điểm của một sinh viên
        async function viewStudentDetail(maSV) {
            activeStudentMaSV = maSV;
            document.getElementById('section-search-students').classList.add('hidden');
            document.getElementById('section-student-detail').classList.remove('hidden');
            document.getElementById('btn-back-to-list').classList.remove('hidden');

            await loadTranscript(maSV);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Quay lại danh sách sinh viên
        function backToList() {
            document.getElementById('section-search-students').classList.remove('hidden');
            document.getElementById('section-student-detail').classList.add('hidden');
            document.getElementById('btn-back-to-list').classList.add('hidden');
        }

        // Tải chi tiết bảng điểm và kết quả xét tốt nghiệp từ API
        function formatTranscriptGpa(value) { return value == null ? '—' : Number(value).toFixed(2); }
        function transcriptSummaryRows(rows, labelSpan = 8, valueSpan = 4) {
            return rows.map(([label, value]) => `<tr class="border-t border-surface-hover bg-canvas">
                <th colspan="${labelSpan}" scope="row" class="px-5 py-2 text-left text-xs font-semibold text-text-muted">${label}</th>
                <td colspan="${valueSpan}" class="px-5 py-2 text-left text-sm font-bold text-text-primary">${value}</td></tr>`).join('');
        }
        function semesterSummary(hk) {
            const current = hk.ThongKeHocKy, cumulative = hk.TichLuyDenHocKy;
            return transcriptSummaryRows([
                ['Điểm trung bình học kỳ hệ 10', formatTranscriptGpa(current.GPAHe10)],
                ['Điểm trung bình học kỳ hệ 4', formatTranscriptGpa(current.GPAHe4)],
                ['Điểm trung bình tích lũy đến học kỳ này (hệ 10)', formatTranscriptGpa(cumulative.GPAHe10)],
                ['Điểm trung bình tích lũy đến học kỳ này (hệ 4)', formatTranscriptGpa(cumulative.GPAHe4)],
                ['Số tín chỉ đăng ký trong học kỳ', current.TinChiDangKy],
                ['Số tín chỉ đã có điểm tổng kết', current.TinChiDaCoDiem],
                ['Số tín chỉ đạt trong học kỳ', current.TinChiDat],
                ['Số tín chỉ chưa đạt trong học kỳ', current.TinChiKhongDat],
                ['Số tín chỉ chưa có điểm tổng kết', current.TinChiChuaCoDiem],
                ['Số tín chỉ tích lũy đến học kỳ này', cumulative.TinChiDat],
                ['Phân loại điểm trung bình học kỳ', current.XepLoai]
            ]);
        }
        function overallTranscriptSummary(totals) {
            return `<div class="px-6 py-4 bg-surface-header border-b border-surface-hover">
                <h3 class="font-bold text-base text-primary">Tổng kết điểm đến hiện tại</h3>
                <p class="text-xs text-text-muted mt-2">Chỉ tính điểm tổng kết đã có; môn 0 tín chỉ không ảnh hưởng GPA. Tích lũy lấy điểm cao nhất mỗi môn, không cộng lặp tín chỉ học lại/cải thiện.</p>
                </div><table class="w-full text-sm"><tbody>${transcriptSummaryRows([
                    ['Điểm trung bình tích lũy hệ 10', formatTranscriptGpa(totals.GPAHe10)],
                    ['Điểm trung bình tích lũy hệ 4', formatTranscriptGpa(totals.GPAHe4)],
                    ['Tổng tín chỉ đăng ký (không trùng môn)', totals.TinChiDangKy],
                    ['Tổng tín chỉ đã có điểm tổng kết (không trùng môn)', totals.TinChiDaCoDiem],
                    ['Tổng tín chỉ đạt / tích lũy', totals.TinChiDat],
                    ['Số tín chỉ chưa đạt', totals.TinChiKhongDat],
                    ['Số tín chỉ của môn chưa có điểm tổng kết', totals.TinChiChuaCoDiem],
                    ['Số môn đã có điểm tổng kết', totals.SoMonDaCoDiem],
                    ['Số môn chưa có điểm tổng kết', totals.SoMonChuaCoDiem],
                    ['Xếp loại học lực hiện tại', totals.XepLoai]
                ], 1, 1)}</tbody></table>`;
        }

        async function loadTranscript(maSV) {
            try {
                const res = await apiFetch(`/api/tracuudiem/${encodeURIComponent(maSV)}`);
                const d = res.data;
                const sv = d.thongTinSinhVien;
                const tk = d.tongKetToanKhoa;
                const xet = tk.XetTotNghiep;

                document.getElementById('info-hoten').textContent = sv.HoTen;
                document.getElementById('info-masv').textContent = sv.MaSV;
                document.getElementById('info-lop').textContent = sv.MaLop || 'N/A';
                document.getElementById('info-nganh').textContent = sv.TenNganh || 'N/A';
                document.getElementById('info-khoa').textContent = sv.TenKhoa || 'N/A';
                document.getElementById('info-gpa10').textContent = formatTranscriptGpa(tk.GPA_He10);
                document.getElementById('info-gpa4').textContent = formatTranscriptGpa(tk.GPA_He4);
                document.getElementById('tc-overall-summary').innerHTML = overallTranscriptSummary(tk.ThongKe);
                document.getElementById('info-xeploai').textContent = tk.XepLoai;

                const badge = document.getElementById('grad-badge');
                if (xet.DuDieuKien) {
                    badge.textContent = 'ĐỦ ĐIỀU KIỆN TỐT NGHIỆP';
                    badge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-[#10B981]/15 text-[#10B981]';
                } else {
                    badge.textContent = 'CHƯA ĐỦ ĐIỀU KIỆN TỐT NGHIỆP';
                    badge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-amber-500/15 text-amber-400';
                }

                document.getElementById('grad-tc-tong').textContent = `${tk.TongTinChiTichLuy} / ${xet.QuyDinh.TongTTC} TC`;
                document.getElementById('grad-tc-bb').textContent = `${tk.TCBatBuocDat} / ${xet.QuyDinh.TCBatBuoc} TC`;
                document.getElementById('grad-tc-tc').textContent = `${tk.TCTuChonDat} / ${xet.QuyDinh.TCTuChon} TC`;

                const reasonsEl = document.getElementById('grad-reasons');
                if (xet.DuDieuKien) {
                    reasonsEl.innerHTML = `<div class="text-[#10B981] font-semibold">🎉 Chúc mừng! Sinh viên đã hoàn thành đầy đủ chuẩn đầu ra tín chỉ và GPA tối thiểu (${xet.QuyDinh.MinGPA}).</div>`;
                } else {
                    reasonsEl.innerHTML = `<div class="font-bold text-text-primary mb-1">Các điều kiện cần hoàn thành thêm:</div>` +
                        (xet.LyDo || []).map(r => `<div class="text-text-muted">• ${r}</div>`).join('');
                }

                const semContainer = document.getElementById('tc-semesters');
                const hks = d.ketQuaTheoHocKy || [];
                if (hks.length === 0) {
                    semContainer.innerHTML = `<div class="bg-surface border border-surface-hover rounded-2xl p-10 text-center text-text-muted">Sinh viên chưa có điểm học phần nào.</div>`;
                    return;
                }

                semContainer.innerHTML = hks.map(hk => `
                    <div class="bg-surface border border-surface-hover rounded-2xl overflow-hidden shadow-sm">
                        <div class="px-6 py-4 bg-surface-header border-b border-surface-hover flex flex-wrap items-center justify-between gap-4">
                            <div>
                                <h3 class="font-bold text-base text-primary">${hk.TenHK} — Năm học ${hk.NamHoc}</h3>
                                <span class="text-xs text-text-muted">Mã học kỳ: ${hk.MaHK}</span>
                            </div>
                            <div class="flex items-center gap-4 text-xs">
                                <span>TC Đạt trong kỳ: <strong class="text-text-primary">${hk.TongTinChiHK} TC</strong></span>
                                <span>GPA Học kỳ (Hệ 10): <strong class="text-primary">${formatTranscriptGpa(hk.GPA_HK_He10)}</strong></span>
                                <span>GPA Học kỳ (Hệ 4): <strong class="text-[#10B981]">${formatTranscriptGpa(hk.GPA_HK_He4)}</strong></span>
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-sm">
                                <thead>
                                    <tr class="border-b border-surface-hover text-xs text-text-muted uppercase">
                                        <th class="px-5 py-3">Mã Môn</th>
                                        <th class="px-5 py-3">Tên Học Phần</th>
                                        <th class="px-4 py-3 text-center">TC</th>
                                        <th class="px-4 py-3 text-center">Loại</th>
                                        <th class="px-4 py-3 text-center">Điểm QT (40%)</th>
                                        <th class="px-4 py-3 text-center">Thi L1 (60%)</th>
                                        <th class="px-4 py-3 text-center">Thi L2</th>
                                        <th class="px-4 py-3 text-center">Tổng Kết (10)</th>
                                        <th class="px-4 py-3 text-center">Hệ 4</th>
                                        <th class="px-4 py-3 text-center">Điểm Chữ</th>
                                        <th class="px-4 py-3 text-center">Kết Quả</th>
                                        <th class="px-4 py-3 text-right">Phúc khảo</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-surface-hover">
                                    ${hk.DanhSachMon.map(m => `
                                        <tr class="hover:bg-surface-hover/40">
                                            <td class="px-5 py-3 font-bold text-primary">${m.MaMon}</td>
                                            <td class="px-5 py-3 font-medium text-text-primary">${m.TenMon}</td>
                                            <td class="px-4 py-3 text-center">${m.SoTinChi}</td>
                                            <td class="px-4 py-3 text-center text-xs text-text-muted">${m.LoaiMon}</td>
                                            <td class="px-4 py-3 text-center">${m.DiemQT ?? '-'}</td>
                                            <td class="px-4 py-3 text-center">${m.DiemThiLan1 ?? '-'}</td>
                                            <td class="px-4 py-3 text-center text-amber-400">${m.DiemThiLan2 ?? '-'}</td>
                                            <td class="px-4 py-3 text-center font-extrabold text-text-primary">${m.DiemTongKet ?? '-'}</td>
                                            <td class="px-4 py-3 text-center font-bold text-primary">${m.DiemHe4 ?? '-'}</td>
                                            <td class="px-4 py-3 text-center font-bold">${m.DiemChu ?? '-'}</td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold ${m.DiemTongKet == null ? 'bg-surface-hover text-text-muted' : m.QuaMon ? 'bg-[#10B981]/15 text-[#10B981]' : 'bg-[#ef4444]/15 text-[#ef4444]'}">${m.DiemTongKet == null ? 'Chưa có điểm' : (m.GhiChu || (m.QuaMon ? 'Đạt' : 'Học lại'))}</span>
                                            </td>
                                            <td class="px-4 py-3 text-right">
                                                <button onclick="openAppealModal('${m.MaLHP}', '${m.TenMon}', '${sv.MaSV}')" class="px-2.5 py-1 rounded-lg bg-amber-500/15 text-amber-400 hover:bg-amber-500/25 text-xs font-semibold">
                                                    Khiếu nại
                                                </button>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                                <tfoot>${semesterSummary(hk)}</tfoot>
                            </table>
                        </div>
                    </div>
                `).join('');
                lucide.createIcons();
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        // Mở popup modal gửi khiếu nại
        function openAppealModal(maLHP, tenMon, maSV) {
            document.getElementById('ap-malhp').value = maLHP;
            document.getElementById('ap-masv').value = maSV;
            document.getElementById('ap-tenmon').value = `${tenMon} (${maLHP})`;
            document.getElementById('ap-lydo').value = '';
            document.getElementById('appeal-modal').classList.remove('hidden');
        }

        // Submit gửi đơn phúc khảo
        async function submitAppeal(e) {
            e.preventDefault();
            const maSV = document.getElementById('ap-masv').value;
            try {
                const res = await apiFetch('/api/khieunai', {
                    method: 'POST',
                    body: JSON.stringify({
                        MaSV: maSV,
                        MaLHP: document.getElementById('ap-malhp').value,
                        LoaiDiem: document.getElementById('ap-loaidiem').value,
                        LyDo: document.getElementById('ap-lydo').value.trim()
                    })
                });
                showToast(res.message);
                document.getElementById('appeal-modal').classList.add('hidden');
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        initPage();
    </script>
}
