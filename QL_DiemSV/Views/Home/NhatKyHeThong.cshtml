@{
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/nhat-ky.css" asp-append-version="true" />
}

<div class="max-w-[1500px] mx-auto space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-text-muted font-medium mb-1">Quản trị Hệ thống &gt; Audit Logs</div>
            <h1 class="text-2xl font-bold text-text-primary">Nhật Ký Hoạt Động Hệ Thống</h1>
        </div>
        <div class="flex gap-2.5">
            <button onclick="exportLogsExcel()" class="px-4 py-2 rounded-xl bg-surface border border-surface-hover hover:border-primary text-sm font-semibold text-text-primary flex items-center gap-2">
                <i data-lucide="download" class="w-4 h-4 text-[#10B981]"></i> Xuất Nhật Ký Excel
            </button>
        </div>
    </div>

    <div class="admin-filter-card log-filter-card">
        <div class="log-filter-grid">
            <label>Tài khoản<input id="log-account" oninput="queueLogSearch()" placeholder="Tên tài khoản..." /></label>
            <label>Hành động<select id="log-action" onchange="loadLogs(true)">
                <option value="">Tất cả hành động</option>
                <optgroup label="Nhóm hành động">
                    <option value="group:grade">Điểm số và phúc khảo</option>
                    <option value="group:update">Sửa và cập nhật</option>
                    <option value="group:create">Thêm và tạo mới</option>
                    <option value="group:delete">Xóa dữ liệu</option>
                    <option value="group:export">In và xuất dữ liệu</option>
                    <option value="group:login">Đăng nhập và đăng xuất</option>
                </optgroup>
                <optgroup id="log-exact-actions" label="Hành động cụ thể"></optgroup>
            </select></label>
            <label>Phân loại<select id="log-type" onchange="loadLogs(true)">
                <option value="">Tất cả phân loại</option><option>Thông tin</option><option>Cảnh báo</option><option>Lỗi</option>
            </select></label>
            <label>Nội dung chi tiết<input id="log-desc" oninput="queueLogSearch()" placeholder="Tìm trong mô tả..." /></label>
            <label>Khoảng thời gian<select id="log-period" onchange="setLogPeriod()">
                <option value="all">Tất cả thời gian</option><option value="2h">2 giờ gần đây</option>
                <option value="today">Hôm nay</option><option value="yesterday">Hôm qua</option>
                <option value="7d">7 ngày gần đây</option><option value="30d">30 ngày gần đây</option>
                <option value="custom">Tùy chọn ngày giờ</option>
            </select></label>
            <label>Từ ngày giờ<input type="datetime-local" id="log-from" onchange="customLogPeriod()" /></label>
            <label>Đến hết phút<input type="datetime-local" id="log-to" onchange="customLogPeriod()" /></label>
            <div class="log-filter-buttons"><button type="button" class="btn" onclick="loadLogs(true)">Lọc nhật ký</button>
                <button type="button" class="btn" onclick="resetLogFilters()">Đặt lại</button></div>
        </div>
        <p class="log-filter-note">Ngày giờ theo thời gian hiển thị của hệ thống. Đăng nhập thành công của cùng tài khoản được ghi tối đa một lần trong 2 giờ; các thao tác nghiệp vụ vẫn ghi đầy đủ.</p>
        <p id="log-status" role="status" class="log-status"></p>
    </div>

    <!-- Table -->
    <div class="admin-data-card bg-surface border border-surface-hover rounded-2xl overflow-hidden shadow-sm">
        <div class="admin-card-heading">Danh sách nhật ký hệ thống</div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-surface-header border-b border-surface-hover text-xs text-text-muted uppercase tracking-wider">
                        <th class="px-5 py-3.5 w-16">ID</th>
                        <th class="px-5 py-3.5 w-40">Tài Khoản</th>
                        <th class="px-5 py-3.5 w-56">Hành Động</th>
                        <th class="px-5 py-3.5 w-32 text-center">Phân Loại</th>
                        <th class="px-5 py-3.5 w-48">Thời Gian</th>
                        <th class="px-5 py-3.5">Mô Tả Chi Tiết</th>
                    </tr>
                </thead>
                <tbody id="log-tbody" class="divide-y divide-surface-hover"></tbody>
            </table>
        </div>
        <!-- Pagination Footer -->
        <div class="px-5 py-3.5 border-t border-surface-hover bg-surface-header flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-text-muted">
            <div class="flex items-center gap-3">
                <span id="log-pagination-info">Đang tải...</span>
                <div class="flex items-center gap-1.5">
                    <span>Hiển thị</span>
                    <select id="log-page-size" onchange="changeLogPageSize(this.value)" class="bg-canvas border border-surface-hover rounded-lg px-2 py-1 text-xs text-text-primary outline-none focus:border-primary">
                        <option value="15">15</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>/ trang</span>
                </div>
            </div>
            <div id="log-pagination-controls" class="flex items-center gap-1"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let logs = [];
        let logCurrentPage = 1, logPageSize = 15;
        let logRequest = 0, logSearchTimer;

        function queueLogSearch() {
            clearTimeout(logSearchTimer);
            logSearchTimer = setTimeout(() => loadLogs(true), 250);
        }

        async function loadLogs(resetPage = false) {
            if (resetPage) logCurrentPage = 1;
            const request = ++logRequest;
            let params;
            try { params = logFilterParams(); }
            catch (error) { document.getElementById('log-status').textContent = error.message; return; }
            params.set('page', logCurrentPage); params.set('pageSize', logPageSize);
            document.getElementById('log-status').textContent = 'Đang tải nhật ký...';

            let res;
            try {
                res = await apiFetch('/api/nhatkyhoatdong?' + params.toString());
            } catch (err) {
                if (request === logRequest) { document.getElementById('log-status').textContent = err.message; showToast(err.message, 'error'); }
                return;
            }
            if (request !== logRequest) return;

            document.getElementById('log-status').textContent = '';
            logs = res.data || [];
            logCurrentPage = res.page || 1;
            const totalItems = res.total ?? logs.length;
            const totalPages = res.totalPages || 1;
            const startIndex = (logCurrentPage - 1) * logPageSize;
            const endIndex = Math.min(startIndex + logs.length, totalItems);
            const paged = logs;

            const tbody = document.getElementById('log-tbody');
            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-text-muted">Không tìm thấy nhật ký hoạt động nào</td></tr>`;
            } else {
                tbody.innerHTML = paged.map(l => {
                    const badge = l.type === 'Cảnh báo'
                        ? 'bg-amber-500/15 text-amber-400'
                        : l.type === 'Lỗi'
                            ? 'bg-[#ef4444]/15 text-[#ef4444]'
                            : 'bg-primary/15 text-primary';
                    return `
                        <tr class="hover:bg-surface-hover/40 transition-colors">
                            <td class="px-5 py-3 text-text-muted">#${l.id}</td>
                            <td class="px-5 py-3 font-bold text-text-primary">${escapeLog(l.account)}</td>
                            <td class="px-5 py-3 font-medium text-primary">${escapeLog(l.action)}</td>
                            <td class="px-5 py-3 text-center"><span class="px-2.5 py-0.5 rounded-full text-xs font-semibold ${badge}">${escapeLog(l.type)}</span></td>
                            <td class="px-5 py-3 text-xs text-text-muted">${escapeLog(l.time)}</td>
                            <td class="px-5 py-3 text-text-muted">${escapeLog(l.description)}</td>
                        </tr>
                    `;
                }).join('');
            }

            renderLogPagination(totalItems, totalPages, startIndex, endIndex);
            lucide.createIcons();
        }

        function renderLogPagination(totalItems, totalPages, startIndex, endIndex) {
            const infoEl = document.getElementById('log-pagination-info');
            if (infoEl) {
                if (totalItems === 0) infoEl.textContent = '0 bản ghi';
                else infoEl.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên ${totalItems} nhật ký`;
            }

            const controlsEl = document.getElementById('log-pagination-controls');
            if (!controlsEl) return;
            if (totalPages <= 1) {
                controlsEl.innerHTML = '';
                return;
            }

            let html = '';
            const prevDisabled = logCurrentPage === 1;
            html += `<button onclick="changeLogPage(${logCurrentPage - 1})" ${prevDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${prevDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-left" class="w-3.5 h-3.5 inline"></i></button>`;

            const startP = Math.max(1, logCurrentPage - 2);
            const endP = Math.min(totalPages, logCurrentPage + 2);

            if (startP > 1) {
                html += `<button onclick="changeLogPage(1)" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">1</button>`;
                if (startP > 2) html += `<span class="px-1 text-text-muted">...</span>`;
            }

            for (let p = startP; p <= endP; p++) {
                const isActive = p === logCurrentPage;
                html += `<button onclick="changeLogPage(${p})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all ${isActive ? 'bg-primary text-white shadow-md shadow-primary/20' : 'border border-surface-hover hover:bg-surface-hover text-text-primary'}">${p}</button>`;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) html += `<span class="px-1 text-text-muted">...</span>`;
                html += `<button onclick="changeLogPage(${totalPages})" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">${totalPages}</button>`;
            }

            const nextDisabled = logCurrentPage === totalPages;
            html += `<button onclick="changeLogPage(${logCurrentPage + 1})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${nextDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-right" class="w-3.5 h-3.5 inline"></i></button>`;

            controlsEl.innerHTML = html;
        }

        function changeLogPage(page) {
            logCurrentPage = page;
            loadLogs();
        }

        function changeLogPageSize(size) {
            logPageSize = parseInt(size, 10);
            logCurrentPage = 1;
            loadLogs();
        }

        function escapeLog(value) {
            const node = document.createElement('span'); node.textContent = value ?? ''; return node.innerHTML;
        }
        function logFilterParams() {
            const from = document.getElementById('log-from').value;
            const to = document.getElementById('log-to').value;
            if (from && to && from > to) throw new Error('Thời gian bắt đầu phải trước thời gian kết thúc.');
            const action = document.getElementById('log-action').value;
            return new URLSearchParams({
                account: document.getElementById('log-account').value.trim(),
                actionGroup: action.startsWith('group:') ? action.slice(6) : '',
                actionName: action.startsWith('action:') ? action.slice(7) : '', exactAction: true,
                type: document.getElementById('log-type').value,
                desc: document.getElementById('log-desc').value.trim(),
                ...(from ? { from: from + ':00' } : {}), ...(to ? { to: to + ':59.9999999' } : {})
            });
        }
        function localLogDate(date) {
            const pad = n => String(n).padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }
        function setLogPeriod() {
            const period = document.getElementById('log-period').value;
            if (period === 'custom') return;
            const end = new Date(); const start = new Date(end);
            if (period === '2h') start.setHours(start.getHours()-2);
            else if (period === 'today') start.setHours(0,0,0,0);
            else if (period === 'yesterday') { start.setDate(start.getDate()-1);start.setHours(0,0,0,0);end.setDate(end.getDate()-1);end.setHours(23,59,59,999); }
            else if (period === '7d' || period === '30d') start.setDate(start.getDate()-(period === '7d' ? 7 : 30));
            document.getElementById('log-from').value = period === 'all' ? '' : localLogDate(start);
            document.getElementById('log-to').value = period === 'all' ? '' : localLogDate(end);
            loadLogs(true);
        }
        function customLogPeriod() { document.getElementById('log-period').value = 'custom'; loadLogs(true); }
        function resetLogFilters() {
            clearTimeout(logSearchTimer);
            ['log-account','log-action','log-type','log-desc','log-from','log-to'].forEach(id=>document.getElementById(id).value='');
            document.getElementById('log-period').value='all';loadLogs(true);
        }
        async function exportLogsExcel() {
            try {
                const params=logFilterParams();
                const response=await apiFetch('/api/nhatkyhoatdong/export?'+params);
                const rows=(response.data||[]).map(l=>({ID:l.MaLog,'Tài khoản':l.NguoiDung,'Hành động':l.HanhDong,
                    'Phân loại':l.Loai,'Thời gian':String(l.ThoiGian).replace('T',' '),'Chi tiết':l.ChiTiet}));
                if (!rows.length) { showToast('Không có nhật ký phù hợp để xuất.','error');return; }
                const ws=XLSX.utils.json_to_sheet(rows);const wb=XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb,ws,'NhatKyHeThong');XLSX.writeFile(wb,'NhatKy_HeThong.xlsx');
                showToast(`Đã xuất ${rows.length} dòng theo bộ lọc.`,'success');
            } catch(error) { showToast(error.message,'error'); }
        }
        async function initLogFilters() {
            try {
                const result=await apiFetch('/api/nhatkyhoatdong/options');
                const group=document.getElementById('log-exact-actions');
                for(const action of result.actions||[]) { const option=document.createElement('option');option.value='action:'+action;option.textContent=action;group.appendChild(option); }
            } catch(error) { showToast('Không tải được danh sách hành động. '+error.message,'error'); }
        }
        initLogFilters();loadLogs();
    </script>
}
