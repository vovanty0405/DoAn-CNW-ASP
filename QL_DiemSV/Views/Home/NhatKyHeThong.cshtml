@{
    Layout = "_Layout";
}

<div class="max-w-[1500px] mx-auto space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-text-muted font-medium mb-1">Quản trị Hệ thống &gt; Audit Logs</div>
            <h1 class="text-2xl font-bold text-text-primary">Nhật Ký Hoạt Động Hệ Thống</h1>
        </div>
        <div class="flex gap-2.5">
            <button onclick="exportLogsExcel()" class="px-4 py-2 rounded-xl bg-surface border border-surface-hover hover:border-primary text-sm font-semibold text-text-primary flex items-center gap-2">
                <i data-lucide="download" class="w-4 h-4 text-[#10B981]"></i> Xuất Nhật Ký Excel
            </button>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="admin-filter-card bg-surface border border-surface-hover rounded-2xl p-4 grid grid-cols-1 sm:grid-cols-4 gap-3">
        <input id="log-account" oninput="renderLogs()" placeholder="Tìm theo Tài khoản..." class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none" />
        <input id="log-action" oninput="renderLogs()" placeholder="Tìm theo Hành động..." class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none" />
        <select id="log-type" onchange="renderLogs()" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none">
            <option value="">Tất cả Phân loại</option>
            <option value="Thông tin">Thông tin</option>
            <option value="Cảnh báo">Cảnh báo</option>
            <option value="Lỗi">Lỗi</option>
        </select>
        <input id="log-desc" oninput="renderLogs()" placeholder="Tìm trong chi tiết..." class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none" />
    </div>

    <!-- Table -->
    <div class="admin-data-card bg-surface border border-surface-hover rounded-2xl overflow-hidden shadow-sm">
        <div class="admin-card-heading">Danh sách nhật ký hệ thống</div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-surface-header border-b border-surface-hover text-xs text-text-muted uppercase tracking-wider">
                        <th class="px-5 py-3.5 w-16">ID</th>
                        <th class="px-5 py-3.5 w-40">Tài Khoản</th>
                        <th class="px-5 py-3.5 w-56">Hành Động</th>
                        <th class="px-5 py-3.5 w-32 text-center">Phân Loại</th>
                        <th class="px-5 py-3.5 w-48">Thời Gian</th>
                        <th class="px-5 py-3.5">Mô Tả Chi Tiết</th>
                    </tr>
                </thead>
                <tbody id="log-tbody" class="divide-y divide-surface-hover"></tbody>
            </table>
        </div>
        <!-- Pagination Footer -->
        <div class="px-5 py-3.5 border-t border-surface-hover bg-surface-header flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-text-muted">
            <div class="flex items-center gap-3">
                <span id="log-pagination-info">Đang tải...</span>
                <div class="flex items-center gap-1.5">
                    <span>Hiển thị</span>
                    <select id="log-page-size" onchange="changeLogPageSize(this.value)" class="bg-canvas border border-surface-hover rounded-lg px-2 py-1 text-xs text-text-primary outline-none focus:border-primary">
                        <option value="15">15</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>/ trang</span>
                </div>
            </div>
            <div id="log-pagination-controls" class="flex items-center gap-1"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let logs = [];
        let logCurrentPage = 1, logPageSize = 15;

        async function loadLogs() {
            const res = await apiFetch('/api/nhatkyhoatdong');
            logs = res.data || [];
            renderLogs();
        }

        function getFilteredLogs() {
            const acc = document.getElementById('log-account').value.toLowerCase().trim();
            const act = document.getElementById('log-action').value.toLowerCase().trim();
            const type = document.getElementById('log-type').value;
            const desc = document.getElementById('log-desc').value.toLowerCase().trim();

            return logs.filter(l => {
                const mAcc = !acc || (l.account || '').toLowerCase().includes(acc);
                const mAct = !act || (l.action || '').toLowerCase().includes(act);
                const mType = !type || l.type === type;
                const mDesc = !desc || (l.description || '').toLowerCase().includes(desc);
                return mAcc && mAct && mType && mDesc;
            });
        }

        function renderLogs(resetPage = false) {
            if (resetPage) logCurrentPage = 1;
            const filtered = getFilteredLogs();
            const totalItems = filtered.length;
            const totalPages = Math.max(1, Math.ceil(totalItems / logPageSize));

            if (logCurrentPage > totalPages) logCurrentPage = totalPages;
            if (logCurrentPage < 1) logCurrentPage = 1;

            const startIndex = (logCurrentPage - 1) * logPageSize;
            const endIndex = Math.min(startIndex + logPageSize, totalItems);
            const paged = filtered.slice(startIndex, endIndex);

            const tbody = document.getElementById('log-tbody');
            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-text-muted">Không tìm thấy nhật ký hoạt động nào</td></tr>`;
            } else {
                tbody.innerHTML = paged.map(l => {
                    const badge = l.type === 'Cảnh báo'
                        ? 'bg-amber-500/15 text-amber-400'
                        : l.type === 'Lỗi'
                            ? 'bg-[#ef4444]/15 text-[#ef4444]'
                            : 'bg-primary/15 text-primary';
                    return `
                        <tr class="hover:bg-surface-hover/40 transition-colors">
                            <td class="px-5 py-3 text-text-muted">#${l.id}</td>
                            <td class="px-5 py-3 font-bold text-text-primary">${l.account}</td>
                            <td class="px-5 py-3 font-medium text-primary">${l.action}</td>
                            <td class="px-5 py-3 text-center"><span class="px-2.5 py-0.5 rounded-full text-xs font-semibold ${badge}">${l.type}</span></td>
                            <td class="px-5 py-3 text-xs text-text-muted">${l.time}</td>
                            <td class="px-5 py-3 text-text-muted">${l.description}</td>
                        </tr>
                    `;
                }).join('');
            }

            renderLogPagination(totalItems, totalPages, startIndex, endIndex);
            lucide.createIcons();
        }

        function renderLogPagination(totalItems, totalPages, startIndex, endIndex) {
            const infoEl = document.getElementById('log-pagination-info');
            if (infoEl) {
                if (totalItems === 0) infoEl.textContent = '0 bản ghi';
                else infoEl.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên ${totalItems} nhật ký`;
            }

            const controlsEl = document.getElementById('log-pagination-controls');
            if (!controlsEl) return;
            if (totalPages <= 1) {
                controlsEl.innerHTML = '';
                return;
            }

            let html = '';
            const prevDisabled = logCurrentPage === 1;
            html += `<button onclick="changeLogPage(${logCurrentPage - 1})" ${prevDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${prevDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-left" class="w-3.5 h-3.5 inline"></i></button>`;

            const startP = Math.max(1, logCurrentPage - 2);
            const endP = Math.min(totalPages, logCurrentPage + 2);

            if (startP > 1) {
                html += `<button onclick="changeLogPage(1)" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">1</button>`;
                if (startP > 2) html += `<span class="px-1 text-text-muted">...</span>`;
            }

            for (let p = startP; p <= endP; p++) {
                const isActive = p === logCurrentPage;
                html += `<button onclick="changeLogPage(${p})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all ${isActive ? 'bg-primary text-white shadow-md shadow-primary/20' : 'border border-surface-hover hover:bg-surface-hover text-text-primary'}">${p}</button>`;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) html += `<span class="px-1 text-text-muted">...</span>`;
                html += `<button onclick="changeLogPage(${totalPages})" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">${totalPages}</button>`;
            }

            const nextDisabled = logCurrentPage === totalPages;
            html += `<button onclick="changeLogPage(${logCurrentPage + 1})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${nextDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-right" class="w-3.5 h-3.5 inline"></i></button>`;

            controlsEl.innerHTML = html;
        }

        function changeLogPage(page) {
            logCurrentPage = page;
            renderLogs();
        }

        function changeLogPageSize(size) {
            logPageSize = parseInt(size, 10);
            logCurrentPage = 1;
            renderLogs();
        }

        function exportLogsExcel() {
            const ws = XLSX.utils.json_to_sheet(logs);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'NhatKyHeThong');
            XLSX.writeFile(wb, 'NhatKy_HeThong.xlsx');
        }

        loadLogs();
    </script>
}
