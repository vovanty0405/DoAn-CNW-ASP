@{
    Layout = "_Layout";
}

<div class="max-w-[1600px] mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-text-muted font-medium mb-1">Quản lý Đào tạo &gt; Đội ngũ Giảng viên</div>
            <h1 class="text-2xl font-bold text-text-primary">Quản Lý Giảng Viên & Khoa</h1>
        </div>
        <div class="flex flex-wrap gap-2.5">
            <button onclick="openKhoaModal()" class="px-4 py-2 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 hover:bg-amber-500/25 text-sm font-bold flex items-center gap-2 transition-all">
                <i data-lucide="building" class="w-4 h-4"></i> Quản lý Khoa
            </button>
            <label class="cursor-pointer px-4 py-2 rounded-xl bg-surface border border-surface-hover hover:border-primary text-sm font-semibold text-text-primary flex items-center gap-2 transition-all">
                <i data-lucide="upload" class="w-4 h-4 text-[#10B981]"></i> Nhập Excel
                <input type="file" accept=".xlsx,.xls" class="hidden" onchange="importGvExcel(event)" />
            </label>
            <button onclick="exportGvExcel()" class="px-4 py-2 rounded-xl bg-surface border border-surface-hover hover:border-primary text-sm font-semibold text-text-primary flex items-center gap-2 transition-all">
                <i data-lucide="download" class="w-4 h-4 text-primary"></i> Xuất Excel
            </button>
            <button onclick="openGvModal()" class="px-4 py-2 rounded-xl bg-primary hover:bg-primary/90 text-white text-sm font-bold shadow-lg shadow-primary/20 flex items-center gap-2 transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i> Thêm Giảng Viên
            </button>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-surface border border-surface-hover rounded-2xl p-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input id="gv-search" oninput="renderGvTable()" type="text" placeholder="Tìm Mã GV, Họ tên, Email..."
                   class="w-full bg-canvas border border-surface-hover rounded-lg pl-9 pr-3 py-2 text-sm text-text-primary focus:border-primary outline-none" />
        </div>
        <select id="gv-khoa" onchange="renderGvTable()" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
            <option value="">Tất cả Khoa</option>
        </select>
        <select id="gv-hocvi" onchange="renderGvTable()" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none">
            <option value="">Tất cả Học vị</option>
            <option value="Cử nhân">Cử nhân / Kỹ sư</option>
            <option value="Thạc sĩ">Thạc sĩ</option>
            <option value="Tiến sĩ">Tiến sĩ</option>
            <option value="Phó Giáo sư">Phó Giáo sư</option>
            <option value="Giáo sư">Giáo sư</option>
        </select>
    </div>

    <!-- Table -->
    <div class="bg-surface border border-surface-hover rounded-2xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-surface-header border-b border-surface-hover text-xs text-text-muted uppercase tracking-wider">
                        <th class="px-5 py-3.5 font-semibold">Mã GV</th>
                        <th class="px-5 py-3.5 font-semibold">Họ và Tên</th>
                        <th class="px-5 py-3.5 font-semibold">Học vị</th>
                        <th class="px-5 py-3.5 font-semibold">Khoa trực thuộc</th>
                        <th class="px-5 py-3.5 font-semibold">Email & Điện thoại</th>
                        <th class="px-5 py-3.5 font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="gv-tbody" class="divide-y divide-surface-hover"></tbody>
            </table>
        </div>
        <!-- Pagination Footer -->
        <div class="px-5 py-3.5 border-t border-surface-hover bg-surface-header flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-text-muted">
            <div class="flex items-center gap-3">
                <span id="gv-pagination-info">Đang tải...</span>
                <div class="flex items-center gap-1.5">
                    <span>Hiển thị</span>
                    <select id="gv-page-size" onchange="changeGvPageSize(this.value)" class="bg-canvas border border-surface-hover rounded-lg px-2 py-1 text-xs text-text-primary outline-none focus:border-primary">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span>/ trang</span>
                </div>
            </div>
            <div id="gv-pagination-controls" class="flex items-center gap-1"></div>
        </div>
    </div>
</div>

<!-- Modal Giảng Viên -->
<div id="gv-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-hover rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden">
        <div class="p-5 border-b border-surface-hover bg-surface-header flex justify-between items-center">
            <h3 id="gv-modal-title" class="text-lg font-bold text-text-primary">Thêm Giảng Viên</h3>
            <button onclick="closeGvModal()" class="text-text-muted hover:text-[#ef4444]"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form onsubmit="saveGiangVien(event)" class="p-6 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs text-text-muted mb-1">Mã Giảng Viên *</label>
                    <input id="g-magv" required class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Họ và Tên *</label>
                    <input id="g-hoten" required class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Học vị</label>
                    <select id="g-hocvi" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
                        <option value="Thạc sĩ">Thạc sĩ</option>
                        <option value="Tiến sĩ">Tiến sĩ</option>
                        <option value="Phó Giáo sư">Phó Giáo sư</option>
                        <option value="Giáo sư">Giáo sư</option>
                        <option value="Cử nhân">Cử nhân / Kỹ sư</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Khoa</label>
                    <select id="g-makhoa" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary"></select>
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Email</label>
                    <input id="g-email" type="email" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary" />
                </div>
                <div>
                    <label class="block text-xs text-text-muted mb-1">Số điện thoại</label>
                    <input id="g-sdt" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary" />
                </div>
            </div>
            <div class="pt-4 border-t border-surface-hover flex justify-end gap-3">
                <button type="button" onclick="closeGvModal()" class="px-4 py-2 rounded-lg border border-surface-hover text-sm text-text-muted">Hủy</button>
                <button type="submit" class="px-5 py-2 rounded-lg bg-primary text-white text-sm font-bold">Lưu</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Quản lý Khoa -->
<div id="khoa-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-hover rounded-2xl w-full max-w-5xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
        <div class="p-5 border-b border-surface-hover bg-surface-header flex justify-between items-center">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-primary/15 text-primary flex items-center justify-center">
                    <i data-lucide="building" class="w-4 h-4"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-text-primary">Quản Lý Danh Mục Khoa</h3>
                    <p class="text-xs text-text-muted">Thêm mới, cập nhật thông tin và danh mục các Khoa trong toàn trường</p>
                </div>
            </div>
            <button onclick="document.getElementById('khoa-modal').classList.add('hidden')" class="text-text-muted hover:text-[#ef4444] transition-colors"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <div class="p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 overflow-y-auto">
            <!-- Form bên trái -->
            <form id="form-khoa" onsubmit="saveKhoa(event)" class="lg:col-span-4 bg-canvas border border-surface-hover rounded-xl p-4 space-y-3.5 h-fit">
                <div class="border-b border-surface-hover pb-2.5 flex items-center justify-between">
                    <h4 id="k-form-title" class="font-bold text-sm text-primary flex items-center gap-1.5">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i> Thêm Khoa Mới
                    </h4>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-text-muted mb-1">Mã Khoa *</label>
                    <input id="k-makhoa" required placeholder="VD: CNTT, KTVP" class="w-full bg-surface border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none transition-colors disabled:opacity-60 disabled:cursor-not-allowed" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-text-muted mb-1">Tên Khoa *</label>
                    <input id="k-tenkhoa" required placeholder="VD: Khoa Công nghệ Thông tin" class="w-full bg-surface border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none transition-colors" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-text-muted mb-1">Trưởng Khoa</label>
                    <input id="k-truongkhoa" placeholder="VD: PGS.TS Nguyễn Văn A" class="w-full bg-surface border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary focus:border-primary outline-none transition-colors" />
                </div>
                <div class="pt-2 flex items-center gap-2">
                    <button type="button" id="btn-cancel-edit-khoa" onclick="cancelEditKhoa()" class="hidden flex-1 py-2 rounded-lg border border-surface-hover text-xs font-semibold text-text-muted hover:bg-surface-hover transition-colors">
                        Hủy Sửa
                    </button>
                    <button type="submit" id="btn-save-khoa" class="flex-1 py-2 rounded-lg bg-primary hover:bg-primary/90 text-white text-xs font-bold shadow-md shadow-primary/20 flex items-center justify-center gap-1.5 transition-all">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Thêm Khoa
                    </button>
                </div>
            </form>

            <!-- Bảng danh sách bên phải -->
            <div class="lg:col-span-8 overflow-hidden border border-surface-hover rounded-xl flex flex-col bg-canvas">
                <div class="p-3 border-b border-surface-hover bg-surface-header flex justify-between items-center">
                    <span class="text-xs font-bold uppercase tracking-wider text-text-muted flex items-center gap-1.5">
                        <i data-lucide="list" class="w-3.5 h-3.5 text-primary"></i> Danh Sách Khoa Đã Có
                    </span>
                    <span id="khoa-count-badge" class="text-xs text-text-muted">0 khoa</span>
                </div>
                <div class="overflow-y-auto max-h-[420px] custom-scrollbar">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead class="sticky top-0 z-10 bg-surface-header border-b border-surface-hover shadow-sm">
                            <tr class="text-xs text-text-muted uppercase tracking-wider">
                                <th class="p-3.5 font-semibold">Mã Khoa</th>
                                <th class="p-3.5 font-semibold">Tên Khoa</th>
                                <th class="p-3.5 font-semibold">Trưởng Khoa</th>
                                <th class="p-3.5 font-semibold text-right">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="khoa-tbody" class="divide-y divide-surface-hover"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác Thực Mật Khẩu Khi Xóa -->
<div id="pwd-confirm-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-hover rounded-2xl w-full max-w-md shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        <div class="p-5 border-b border-surface-hover bg-surface-header flex justify-between items-center">
            <h3 class="text-base font-bold text-text-primary flex items-center gap-2">
                <i data-lucide="shield-alert" class="w-5 h-5 text-[#ef4444]"></i> Xác Thực Mật Khẩu Xóa
            </h3>
            <button onclick="closePwdConfirmModal()" class="text-text-muted hover:text-[#ef4444] transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form onsubmit="handlePwdConfirmSubmit(event)" class="p-6 space-y-4">
            <p class="text-xs text-text-muted leading-relaxed">
                Hành động này mang tính chất quan trọng và không thể hoàn tác. Để tiếp tục xóa <span id="pwd-confirm-item-name" class="font-bold text-text-primary"></span>, vui lòng nhập mật khẩu tài khoản của bạn để xác thực:
            </p>
            <div>
                <label class="block text-xs font-semibold text-text-muted mb-1.5">Mật khẩu tài khoản *</label>
                <div class="relative">
                    <i data-lucide="lock" class="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
                    <input id="pwd-confirm-input" type="password" required placeholder="Nhập mật khẩu của bạn..."
                           class="w-full bg-canvas border border-surface-hover rounded-xl pl-9 pr-3 py-2.5 text-sm text-text-primary focus:border-[#ef4444] focus:outline-none transition-colors" />
                </div>
                <p id="pwd-confirm-error" class="hidden text-xs text-[#ef4444] font-medium mt-1.5 flex items-center gap-1">
                    <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span id="pwd-confirm-error-msg">Mật khẩu xác thực không chính xác!</span>
                </p>
            </div>
            <div class="pt-2 border-t border-surface-hover flex justify-end gap-3">
                <button type="button" onclick="closePwdConfirmModal()" class="px-4 py-2 rounded-xl border border-surface-hover text-xs font-semibold text-text-muted hover:bg-surface-hover transition-colors">Hủy bỏ</button>
                <button type="submit" id="btn-pwd-confirm-submit" class="px-5 py-2 rounded-xl bg-[#ef4444] hover:bg-[#ef4444]/90 text-white text-xs font-bold shadow-lg shadow-[#ef4444]/20 flex items-center gap-1.5 transition-all">
                    <i data-lucide="trash-2" class="w-4 h-4"></i> Xác nhận xóa
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let gvList = [], khoas = [], editingMaGV = null, editingMaKhoa = null;
        let gvCurrentPage = 1, gvPageSize = 10;
        let pendingDeleteAction = null;

        async function loadData() {
            const [resGv, resKhoa] = await Promise.all([apiFetch('/api/giangvien'), apiFetch('/api/khoa')]);
            gvList = resGv.data || [];
            khoas = resKhoa.data || [];

            document.getElementById('gv-khoa').innerHTML = '<option value="">Tất cả Khoa</option>' + khoas.map(k => `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`).join('');
            document.getElementById('g-makhoa').innerHTML = khoas.map(k => `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`).join('');

            renderGvTable();
            renderKhoaTable();
        }

        function getFilteredGv() {
            const q = document.getElementById('gv-search').value.toLowerCase().trim();
            const maKhoa = document.getElementById('gv-khoa').value;
            const hocVi = document.getElementById('gv-hocvi').value;

            return gvList.filter(g => {
                const mQ = !q || g.MaGV.toLowerCase().includes(q) || g.HoTen.toLowerCase().includes(q) || (g.Email || '').toLowerCase().includes(q);
                const mK = !maKhoa || g.MaKhoa === maKhoa;
                const mH = !hocVi || (g.HocVi || '').includes(hocVi);
                return mQ && mK && mH;
            });
        }

        function renderGvTable() {
            const filtered = getFilteredGv();
            const totalItems = filtered.length;
            const totalPages = Math.max(1, Math.ceil(totalItems / gvPageSize));
            if (gvCurrentPage > totalPages) gvCurrentPage = totalPages;
            if (gvCurrentPage < 1) gvCurrentPage = 1;

            const startIndex = (gvCurrentPage - 1) * gvPageSize;
            const endIndex = Math.min(startIndex + gvPageSize, totalItems);
            const paged = filtered.slice(startIndex, endIndex);

            const tbody = document.getElementById('gv-tbody');
            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-text-muted">Không tìm thấy giảng viên nào phù hợp</td></tr>`;
            } else {
                tbody.innerHTML = paged.map(g => `
                    <tr class="hover:bg-surface-hover/40 transition-colors">
                        <td class="px-5 py-3.5 font-bold text-primary">${g.MaGV}</td>
                        <td class="px-5 py-3.5 font-semibold text-text-primary">${g.HoTen}</td>
                        <td class="px-5 py-3.5"><span class="px-2.5 py-1 rounded-md text-xs font-medium bg-primary/10 text-primary">${g.HocVi || 'Giảng viên'}</span></td>
                        <td class="px-5 py-3.5 text-text-muted">${g.Khoa?.TenKhoa || g.MaKhoa || ''}</td>
                        <td class="px-5 py-3.5 text-xs text-text-muted">
                            <div>${g.Email || ''}</div>
                            <div>${g.SDT || ''}</div>
                        </td>
                        <td class="px-5 py-3.5 text-right whitespace-nowrap">
                            <div class="inline-flex items-center justify-end gap-1.5">
                                <button onclick='openGvModal(${JSON.stringify(g).replace(/'/g, "&apos;")})' class="p-1.5 text-text-muted hover:text-primary transition-colors"><i data-lucide="edit" class="w-4 h-4"></i></button>
                                <button onclick="confirmDeleteGv('${g.MaGV}', '${(g.HoTen || '').replace(/'/g, "\\'")}')" class="p-1.5 text-text-muted hover:text-[#ef4444] transition-colors"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            }

            renderGvPagination(totalItems, totalPages, startIndex, endIndex);
            lucide.createIcons();
        }

        function renderGvPagination(totalItems, totalPages, startIndex, endIndex) {
            const infoEl = document.getElementById('gv-pagination-info');
            if (infoEl) {
                if (totalItems === 0) infoEl.textContent = '0 bản ghi';
                else infoEl.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên ${totalItems} giảng viên`;
            }

            const controlsEl = document.getElementById('gv-pagination-controls');
            if (!controlsEl) return;
            if (totalPages <= 1) {
                controlsEl.innerHTML = '';
                return;
            }

            let html = '';
            const prevDisabled = gvCurrentPage === 1;
            html += `<button onclick="changeGvPage(${gvCurrentPage - 1})" ${prevDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${prevDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-left" class="w-3.5 h-3.5 inline"></i></button>`;

            const startP = Math.max(1, gvCurrentPage - 2);
            const endP = Math.min(totalPages, gvCurrentPage + 2);

            if (startP > 1) {
                html += `<button onclick="changeGvPage(1)" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">1</button>`;
                if (startP > 2) html += `<span class="px-1 text-text-muted">...</span>`;
            }

            for (let p = startP; p <= endP; p++) {
                const isActive = p === gvCurrentPage;
                html += `<button onclick="changeGvPage(${p})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all ${isActive ? 'bg-primary text-white shadow-md shadow-primary/20' : 'border border-surface-hover hover:bg-surface-hover text-text-primary'}">${p}</button>`;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) html += `<span class="px-1 text-text-muted">...</span>`;
                html += `<button onclick="changeGvPage(${totalPages})" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">${totalPages}</button>`;
            }

            const nextDisabled = gvCurrentPage === totalPages;
            html += `<button onclick="changeGvPage(${gvCurrentPage + 1})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${nextDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-right" class="w-3.5 h-3.5 inline"></i></button>`;

            controlsEl.innerHTML = html;
        }

        function changeGvPage(page) {
            gvCurrentPage = page;
            renderGvTable();
        }

        function changeGvPageSize(size) {
            gvPageSize = parseInt(size, 10);
            gvCurrentPage = 1;
            renderGvTable();
        }

        function openGvModal(gv = null) {
            editingMaGV = gv ? gv.MaGV : null;
            document.getElementById('gv-modal-title').textContent = gv ? 'Cập Nhật Giảng Viên' : 'Thêm Giảng Viên Mới';
            document.getElementById('g-magv').value = gv ? gv.MaGV : '';
            document.getElementById('g-magv').disabled = !!gv;
            document.getElementById('g-hoten').value = gv ? gv.HoTen : '';
            document.getElementById('g-hocvi').value = gv ? (gv.HocVi || 'Thạc sĩ') : 'Thạc sĩ';
            document.getElementById('g-makhoa').value = gv ? (gv.MaKhoa || khoas[0]?.MaKhoa || '') : (khoas[0]?.MaKhoa || '');
            document.getElementById('g-email').value = gv ? (gv.Email || '') : '';
            document.getElementById('g-sdt').value = gv ? (gv.SDT || '') : '';
            document.getElementById('gv-modal').classList.remove('hidden');
        }

        function closeGvModal() {
            document.getElementById('gv-modal').classList.add('hidden');
        }

        async function saveGiangVien(e) {
            e.preventDefault();
            const payload = {
                MaGV: document.getElementById('g-magv').value.trim(),
                HoTen: document.getElementById('g-hoten').value.trim(),
                HocVi: document.getElementById('g-hocvi').value,
                MaKhoa: document.getElementById('g-makhoa').value,
                Email: document.getElementById('g-email').value.trim(),
                SDT: document.getElementById('g-sdt').value.trim()
            };
            try {
                if (editingMaGV) await apiFetch(`/api/giangvien/${editingMaGV}`, { method: 'PUT', body: JSON.stringify(payload) });
                else await apiFetch('/api/giangvien', { method: 'POST', body: JSON.stringify(payload) });
                showToast('Đã lưu giảng viên!');
                closeGvModal();
                await loadData();
            } catch (err) { showToast(err.message, 'error'); }
        }

        function confirmDeleteGv(maGV, hoTen) {
            requestSecureDelete(`Giảng viên "${maGV} - ${hoTen}"`, async () => {
                await apiFetch(`/api/giangvien/${maGV}`, { method: 'DELETE' });
                showToast('Đã xóa giảng viên!');
                await loadData();
            });
        }
        function deleteGv(maGV) { confirmDeleteGv(maGV, maGV); }

        function openKhoaModal() {
            cancelEditKhoa();
            document.getElementById('khoa-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        // --- QUẢN LÝ KHOA ---
        function renderKhoaTable() {
            const countBadge = document.getElementById('khoa-count-badge');
            if (countBadge) countBadge.textContent = `${khoas.length} khoa`;

            const tbody = document.getElementById('khoa-tbody');
            if (!khoas || khoas.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-text-muted">Chưa có khoa nào</td></tr>`;
                return;
            }

            tbody.innerHTML = khoas.map(k => `
                <tr class="hover:bg-surface-hover/30 transition-colors">
                    <td class="p-3.5 font-bold text-primary">${k.MaKhoa}</td>
                    <td class="p-3.5 font-medium text-text-primary">${k.TenKhoa}</td>
                    <td class="p-3.5 text-xs text-text-muted">${k.TruongKhoa || ''}</td>
                    <td class="p-3.5 text-right whitespace-nowrap">
                        <div class="inline-flex items-center justify-end gap-1.5">
                            <button type="button" onclick="editKhoa('${k.MaKhoa}')" class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/25 text-xs font-semibold inline-flex items-center gap-1 transition-colors">
                                <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Sửa
                            </button>
                            <button type="button" onclick="confirmDeleteKhoa('${k.MaKhoa}', '${(k.TenKhoa || '').replace(/'/g, "\\'")}')" class="px-2.5 py-1.5 rounded-lg bg-[#ef4444]/10 hover:bg-[#ef4444]/20 text-[#ef4444] border border-[#ef4444]/25 text-xs font-semibold inline-flex items-center gap-1 transition-colors">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Xóa
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
            lucide.createIcons();
        }

        function editKhoa(maKhoa) {
            const item = khoas.find(k => k.MaKhoa === maKhoa);
            if (!item) return;

            editingMaKhoa = maKhoa;
            document.getElementById('k-form-title').innerHTML = '<i data-lucide="edit-3" class="w-4 h-4 text-amber-400"></i> Cập Nhật Khoa';
            document.getElementById('k-makhoa').value = item.MaKhoa;
            document.getElementById('k-makhoa').disabled = true;
            document.getElementById('k-tenkhoa').value = item.TenKhoa;
            document.getElementById('k-truongkhoa').value = item.TruongKhoa || '';

            document.getElementById('btn-save-khoa').innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5"></i> Cập Nhật Khoa';
            document.getElementById('btn-cancel-edit-khoa').classList.remove('hidden');
            lucide.createIcons();
        }

        function cancelEditKhoa() {
            editingMaKhoa = null;
            document.getElementById('k-form-title').innerHTML = '<i data-lucide="plus-circle" class="w-4 h-4 text-primary"></i> Thêm Khoa Mới';
            document.getElementById('k-makhoa').value = '';
            document.getElementById('k-makhoa').disabled = false;
            document.getElementById('k-tenkhoa').value = '';
            document.getElementById('k-truongkhoa').value = '';

            document.getElementById('btn-save-khoa').innerHTML = '<i data-lucide="plus" class="w-3.5 h-3.5"></i> Thêm Khoa';
            document.getElementById('btn-cancel-edit-khoa').classList.add('hidden');
            lucide.createIcons();
        }

        async function saveKhoa(e) {
            e.preventDefault();
            const payload = {
                MaKhoa: document.getElementById('k-makhoa').value.trim(),
                TenKhoa: document.getElementById('k-tenkhoa').value.trim(),
                TruongKhoa: document.getElementById('k-truongkhoa').value.trim()
            };

            try {
                if (editingMaKhoa) {
                    await apiFetch(`/api/khoa/${editingMaKhoa}`, {
                        method: 'PUT',
                        body: JSON.stringify(payload)
                    });
                    showToast('Đã cập nhật khoa thành công!');
                } else {
                    await apiFetch('/api/khoa', {
                        method: 'POST',
                        body: JSON.stringify(payload)
                    });
                    showToast('Đã thêm khoa mới thành công!');
                }
                cancelEditKhoa();
                await loadData();
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        function confirmDeleteKhoa(id, name) {
            requestSecureDelete(`Khoa "${id} - ${name}"`, async () => {
                await apiFetch(`/api/khoa/${id}`, { method: 'DELETE' });
                showToast('Đã xóa khoa!');
                if (editingMaKhoa === id) cancelEditKhoa();
                await loadData();
            });
        }
        function deleteKhoa(id) { confirmDeleteKhoa(id, id); }

        // --- PASSWORD CONFIRMATION MODAL LOGIC ---
        function requestSecureDelete(itemName, callback) {
            pendingDeleteAction = callback;
            document.getElementById('pwd-confirm-item-name').textContent = itemName;
            document.getElementById('pwd-confirm-input').value = '';
            document.getElementById('pwd-confirm-error').classList.add('hidden');
            document.getElementById('pwd-confirm-modal').classList.remove('hidden');
            setTimeout(() => document.getElementById('pwd-confirm-input').focus(), 100);
            lucide.createIcons();
        }

        function closePwdConfirmModal() {
            pendingDeleteAction = null;
            document.getElementById('pwd-confirm-modal').classList.add('hidden');
            document.getElementById('pwd-confirm-input').value = '';
            document.getElementById('pwd-confirm-error').classList.add('hidden');
        }

        async function handlePwdConfirmSubmit(e) {
            e.preventDefault();
            const pwd = document.getElementById('pwd-confirm-input').value;
            const errBox = document.getElementById('pwd-confirm-error');
            const errMsg = document.getElementById('pwd-confirm-error-msg');
            const btnSubmit = document.getElementById('btn-pwd-confirm-submit');

            errBox.classList.add('hidden');
            btnSubmit.disabled = true;
            btnSubmit.classList.add('opacity-70');

            try {
                // Xác thực mật khẩu qua API
                await apiFetch('/api/auth/verify-password', {
                    method: 'POST',
                    body: JSON.stringify({ Password: pwd })
                });

                // Nếu chính xác, tiến hành xóa
                if (typeof pendingDeleteAction === 'function') {
                    await pendingDeleteAction();
                }
                closePwdConfirmModal();
            } catch (err) {
                errBox.classList.remove('hidden');
                errMsg.textContent = err.message || 'Mật khẩu xác thực không chính xác!';
                lucide.createIcons();
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.classList.remove('opacity-70');
            }
        }

        function exportGvExcel() {
            const ws = XLSX.utils.json_to_sheet(gvList.map(g => ({ MaGV: g.MaGV, HoTen: g.HoTen, HocVi: g.HocVi, MaKhoa: g.MaKhoa, Email: g.Email, SDT: g.SDT })));
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'GiangVien');
            XLSX.writeFile(wb, 'DanhSach_GiangVien.xlsx');
        }

        function importGvExcel(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = async (evt) => {
                const wb = XLSX.read(evt.target.result, { type: 'binary' });
                const json = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
                try {
                    const res = await apiFetch('/api/giangvien/bulk', { method: 'POST', body: JSON.stringify(json) });
                    showToast(res.message);
                    await loadData();
                } catch (err) { showToast(err.message, 'error'); }
            };
            reader.readAsBinaryString(file);
        }

        loadData();
    </script>
}
