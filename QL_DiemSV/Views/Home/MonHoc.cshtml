@{
    Layout = "_Layout";
}

<div class="max-w-[1600px] mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-text-muted font-medium mb-1">Quản lý Đào tạo &gt; Học phần & Tiên quyết</div>
            <h1 class="text-2xl font-bold text-text-primary">Quản Lý Môn Học</h1>
        </div>
        <div class="flex flex-wrap gap-2.5">
            <button onclick="exportMonHocExcel()" class="px-4 py-2 rounded-xl bg-surface border border-surface-hover hover:border-primary text-sm font-semibold text-text-primary flex items-center gap-2">
                <i data-lucide="download" class="w-4 h-4 text-primary"></i> Xuất Excel
            </button>
            <button onclick="openMhModal()" class="px-4 py-2 rounded-xl bg-primary hover:bg-primary/90 text-white text-sm font-bold shadow-lg shadow-primary/20 flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i> Thêm Môn Học
            </button>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-surface border border-surface-hover rounded-2xl p-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input id="mh-search" oninput="renderMhTable()" type="text" placeholder="Tìm Mã môn, Tên môn học..."
                   class="w-full bg-canvas border border-surface-hover rounded-lg pl-9 pr-3 py-2 text-sm text-text-primary outline-none focus:border-primary" />
        </div>
        <select id="mh-khoa" onchange="renderMhTable()" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
            <option value="">Tất cả Khoa phụ trách</option>
        </select>
        <select id="mh-tc" onchange="renderMhTable()" class="bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
            <option value="">Tất cả Số tín chỉ</option>
            <option value="2">2 Tín chỉ</option>
            <option value="3">3 Tín chỉ</option>
            <option value="4">4 Tín chỉ</option>
        </select>
    </div>

    <!-- Table -->
    <div class="bg-surface border border-surface-hover rounded-2xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-surface-header border-b border-surface-hover text-xs text-text-muted uppercase">
                        <th class="px-5 py-3.5 font-semibold">Mã Môn</th>
                        <th class="px-5 py-3.5 font-semibold">Tên Môn Học</th>
                        <th class="px-5 py-3.5 font-semibold text-center">Tín chỉ</th>
                        <th class="px-5 py-3.5 font-semibold text-center">LT / TH</th>
                        <th class="px-5 py-3.5 font-semibold">Khoa quản lý</th>
                        <th class="px-5 py-3.5 font-semibold">Môn Tiên Quyết</th>
                        <th class="px-5 py-3.5 font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="mh-tbody" class="divide-y divide-surface-hover"></tbody>
            </table>
        </div>
        <!-- Pagination Footer -->
        <div class="px-5 py-3.5 border-t border-surface-hover bg-surface-header flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-text-muted">
            <div class="flex items-center gap-3">
                <span id="mh-pagination-info">Đang tải...</span>
                <div class="flex items-center gap-1.5">
                    <span>Hiển thị</span>
                    <select id="mh-page-size" onchange="changeMhPageSize(this.value)" class="bg-canvas border border-surface-hover rounded-lg px-2 py-1 text-xs text-text-primary outline-none focus:border-primary">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span>/ trang</span>
                </div>
            </div>
            <div id="mh-pagination-controls" class="flex items-center gap-1"></div>
        </div>
    </div>
</div>

<!-- Modal Môn Học (Nâng cấp giao diện 2 cột & chọn Môn Tiên Quyết thông minh) -->
<div id="mh-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-6 overflow-y-auto">
    <div class="bg-surface border border-surface-hover rounded-2xl w-full max-w-5xl shadow-2xl overflow-hidden flex flex-col my-auto max-h-[92vh]">
        <!-- Header -->
        <div class="px-6 py-4 border-b border-surface-hover bg-surface-header flex justify-between items-center flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
                    <i data-lucide="book-open" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 id="mh-modal-title" class="text-lg font-bold text-text-primary">Thêm Môn Học Mới</h3>
                    <p class="text-xs text-text-muted">Cấu hình thông tin chi tiết môn học và sơ đồ môn tiên quyết</p>
                </div>
            </div>
            <button type="button" onclick="closeMhModal()" class="text-text-muted hover:text-[#ef4444] p-1.5 rounded-lg hover:bg-surface-hover transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Form Body with 2 Columns -->
        <form id="mh-form" onsubmit="saveMonHoc(event)" class="flex flex-col flex-1 overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 p-6 overflow-y-auto flex-1">
                <!-- Cột 1: Thông tin cơ bản môn học (5 cols) -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="flex items-center gap-2 pb-2 border-b border-surface-hover text-sm font-bold text-text-primary">
                        <i data-lucide="info" class="w-4 h-4 text-primary"></i>
                        <span>Thông tin cơ bản</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-text-muted mb-1.5">Mã Môn Học <span class="text-rose-500">*</span></label>
                        <input id="mh-mamon" required placeholder="VD: IT001, CS101..." 
                               class="w-full bg-canvas border border-surface-hover rounded-xl px-3.5 py-2.5 text-sm text-text-primary outline-none focus:border-primary disabled:opacity-50 disabled:cursor-not-allowed uppercase font-mono font-bold" />
                        <span id="mh-mamon-hint" class="text-[11px] text-text-muted mt-1 block">Mã môn không thể thay đổi sau khi tạo</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-text-muted mb-1.5">Tên Môn Học <span class="text-rose-500">*</span></label>
                        <input id="mh-tenmon" required placeholder="VD: Lập trình hướng đối tượng..." 
                               class="w-full bg-canvas border border-surface-hover rounded-xl px-3.5 py-2.5 text-sm text-text-primary outline-none focus:border-primary" />
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-text-muted mb-1.5">Số TC <span class="text-rose-500">*</span></label>
                            <input id="mh-sotc" type="number" min="1" max="15" value="3" required 
                                   class="w-full bg-canvas border border-surface-hover rounded-xl px-3 py-2 text-sm text-center font-bold text-text-primary outline-none focus:border-primary" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-text-muted mb-1.5">Tiết LT</label>
                            <input id="mh-lt" type="number" min="0" value="30" 
                                   class="w-full bg-canvas border border-surface-hover rounded-xl px-3 py-2 text-sm text-center text-text-primary outline-none focus:border-primary" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-text-muted mb-1.5">Tiết TH</label>
                            <input id="mh-th" type="number" min="0" value="15" 
                                   class="w-full bg-canvas border border-surface-hover rounded-xl px-3 py-2 text-sm text-center text-text-primary outline-none focus:border-primary" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-text-muted mb-1.5">Khoa phụ trách <span class="text-rose-500">*</span></label>
                        <select id="mh-makhoa" onchange="onFacultyChanged()" required
                                class="w-full bg-canvas border border-surface-hover rounded-xl px-3.5 py-2.5 text-sm text-text-primary outline-none focus:border-primary">
                        </select>
                        <p class="text-[11px] text-text-muted mt-1.5 flex items-center gap-1.5">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
                            Tự động lọc môn tiên quyết theo Khoa đã chọn
                        </p>
                    </div>

                    <div class="p-3.5 rounded-xl bg-canvas/60 border border-surface-hover space-y-2 text-xs text-text-muted">
                        <div class="font-semibold text-text-primary flex items-center gap-1.5">
                            <i data-lucide="help-circle" class="w-4 h-4 text-primary"></i>
                            Quy tắc môn tiên quyết:
                        </div>
                        <ul class="list-disc list-inside space-y-1 text-[11px] leading-relaxed">
                            <li>Sinh viên phải hoàn thành môn tiên quyết trước khi đăng ký môn này.</li>
                            <li>Hệ thống tự động phát hiện và khóa các môn gây vòng lặp (A &rarr; B &rarr; A).</li>
                            <li>Có thể chọn môn tiên quyết từ khoa khác qua bộ lọc "Tất cả các Khoa".</li>
                        </ul>
                    </div>
                </div>

                <!-- Cột 2: Khu vực chọn Môn Tiên Quyết thông minh (7 cols) -->
                <div class="lg:col-span-7 flex flex-col space-y-4 border-t lg:border-t-0 lg:border-l border-surface-hover lg:pl-6 pt-4 lg:pt-0">
                    <div class="flex items-center justify-between pb-2 border-b border-surface-hover">
                        <div class="flex items-center gap-2 text-sm font-bold text-text-primary">
                            <i data-lucide="git-merge" class="w-4 h-4 text-amber-400"></i>
                            <span>Môn Tiên Quyết</span>
                            <span id="prereq-count-badge" class="px-2 py-0.5 rounded-full text-xs bg-amber-500/15 text-amber-400 font-semibold border border-amber-500/20">Đã chọn: 0</span>
                        </div>
                        <button type="button" id="btn-clear-prereqs" onclick="clearAllPrereqs()" class="text-xs text-rose-400 hover:text-rose-300 font-medium hover:underline hidden flex items-center gap-1">
                            <i data-lucide="trash-2" class="w-3 h-3"></i> Xóa tất cả
                        </button>
                    </div>

                    <!-- Selected Tags Container -->
                    <div>
                        <div class="text-xs font-semibold text-text-muted mb-1.5 flex justify-between items-center">
                            <span>Các môn tiên quyết đã chọn:</span>
                        </div>
                        <div id="mh-selected-tags" class="min-h-[46px] max-h-28 overflow-y-auto p-2.5 rounded-xl bg-canvas border border-surface-hover flex flex-wrap gap-1.5 items-center">
                            <span class="text-xs text-text-muted italic py-1">Chưa có môn tiên quyết nào được chọn</span>
                        </div>
                    </div>

                    <!-- Filter Bar for Candidates -->
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 pt-1">
                        <div class="sm:col-span-7 relative">
                            <i data-lucide="search" class="w-3.5 h-3.5 text-text-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
                            <input id="prereq-search" oninput="renderAvailablePrereqs()" type="text" placeholder="Tìm theo mã hoặc tên môn..."
                                   class="w-full bg-canvas border border-surface-hover rounded-lg pl-8 pr-3 py-2 text-xs text-text-primary outline-none focus:border-primary" />
                        </div>
                        <div class="sm:col-span-5">
                            <select id="prereq-khoa-filter" onchange="renderAvailablePrereqs()"
                                    class="w-full bg-canvas border border-surface-hover rounded-lg px-2.5 py-2 text-xs text-text-primary outline-none focus:border-primary">
                                <option value="">Tất cả các Khoa</option>
                            </select>
                        </div>
                    </div>

                    <!-- Available Subjects List -->
                    <div class="flex-1 flex flex-col min-h-0">
                        <div class="text-xs font-semibold text-text-muted mb-1.5 flex justify-between items-center">
                            <span>Danh sách môn có thể chọn:</span>
                            <span id="prereq-candidate-count" class="text-[11px] text-text-muted font-normal">0 môn</span>
                        </div>
                        <div id="prereq-available-list" class="max-h-64 sm:max-h-72 overflow-y-auto space-y-1.5 pr-1 divide-y divide-surface-hover/20 rounded-xl bg-canvas/40 border border-surface-hover p-2">
                            <!-- Cards render via JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-surface-hover bg-surface-header flex flex-col sm:flex-row justify-between items-center gap-3 flex-shrink-0">
                <span class="text-xs text-text-muted text-center sm:text-left">
                    💡 Click vào thẻ môn để chọn / bỏ chọn làm môn tiên quyết.
                </span>
                <div class="flex gap-2.5 w-full sm:w-auto justify-end">
                    <button type="button" onclick="closeMhModal()" class="px-4 py-2 rounded-xl border border-surface-hover hover:bg-surface-hover text-sm font-semibold text-text-muted transition-colors">Hủy</button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-primary hover:bg-primary/90 text-white text-sm font-bold shadow-lg shadow-primary/20 flex items-center justify-center gap-2 transition-all">
                        <i data-lucide="check" class="w-4 h-4"></i> Lưu Môn Học
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let mhList = [], khoas = [], editingMaMon = null;
        let mhCurrentPage = 1, mhPageSize = 10;
        let selectedPrereqSet = new Set();

        async function loadData() {
            try {
                const [resMh, resKhoa] = await Promise.all([apiFetch('/api/monhoc'), apiFetch('/api/khoa')]);
                mhList = resMh.data || [];
                khoas = resKhoa.data || [];

                document.getElementById('mh-khoa').innerHTML = '<option value="">Tất cả Khoa phụ trách</option>' + khoas.map(k => `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`).join('');
                document.getElementById('mh-makhoa').innerHTML = khoas.map(k => `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`).join('');
                
                const prereqFilter = document.getElementById('prereq-khoa-filter');
                if (prereqFilter) {
                    prereqFilter.innerHTML = '<option value="">Tất cả các Khoa</option>' + khoas.map(k => `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`).join('');
                }

                renderMhTable();
            } catch (err) {
                showToast('Lỗi khi tải dữ liệu: ' + err.message, 'error');
            }
        }

        function getFilteredMh() {
            const q = document.getElementById('mh-search').value.toLowerCase().trim();
            const maKhoa = document.getElementById('mh-khoa').value;
            const tc = document.getElementById('mh-tc').value;

            return mhList.filter(m => {
                const mQ = !q || m.MaMon.toLowerCase().includes(q) || m.TenMon.toLowerCase().includes(q);
                const mK = !maKhoa || m.MaKhoa === maKhoa;
                const mTC = !tc || String(m.SoTinChi) === tc;
                return mQ && mK && mTC;
            });
        }

        function renderMhTable(resetPage = false) {
            if (resetPage) mhCurrentPage = 1;
            const filtered = getFilteredMh();
            const totalItems = filtered.length;
            const totalPages = Math.max(1, Math.ceil(totalItems / mhPageSize));

            if (mhCurrentPage > totalPages) mhCurrentPage = totalPages;
            if (mhCurrentPage < 1) mhCurrentPage = 1;

            const startIndex = (mhCurrentPage - 1) * mhPageSize;
            const endIndex = Math.min(startIndex + mhPageSize, totalItems);
            const paged = filtered.slice(startIndex, endIndex);

            const tbody = document.getElementById('mh-tbody');
            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-text-muted">Không tìm thấy môn học nào phù hợp</td></tr>`;
            } else {
                tbody.innerHTML = paged.map(m => {
                    const prereqs = (m.DieuKienTienQuyets || []).map(d => `<span class="px-2 py-0.5 rounded bg-amber-500/15 text-amber-400 text-xs font-semibold mr-1 font-mono">${d.MaMonTienQuyet}</span>`).join('');
                    return `
                        <tr class="hover:bg-surface-hover/40 transition-colors">
                            <td class="px-5 py-3.5 font-bold font-mono text-primary">${m.MaMon}</td>
                            <td class="px-5 py-3.5 font-semibold text-text-primary">${m.TenMon}</td>
                            <td class="px-5 py-3.5 text-center font-bold text-amber-400">${m.SoTinChi}</td>
                            <td class="px-5 py-3.5 text-center text-text-muted">${m.SoTietLyThuyet || 0} / ${m.SoTietThucHanh || 0}</td>
                            <td class="px-5 py-3.5 text-text-muted">${m.Khoa?.TenKhoa || m.MaKhoa || ''}</td>
                            <td class="px-5 py-3.5">${prereqs || '<span class="text-xs text-text-muted italic">Không có</span>'}</td>
                            <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                <button title="Sửa môn học" onclick='openMhModal(${JSON.stringify(m).replace(/'/g, "&apos;")})' class="p-1.5 text-text-muted hover:text-primary transition-colors"><i data-lucide="edit" class="w-4 h-4"></i></button>
                                <button title="Xóa môn học" onclick="deleteMh('${m.MaMon}')" class="p-1.5 text-text-muted hover:text-[#ef4444] transition-colors"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            renderMhPagination(totalItems, totalPages, startIndex, endIndex);
            lucide.createIcons();
        }

        function renderMhPagination(totalItems, totalPages, startIndex, endIndex) {
            const infoEl = document.getElementById('mh-pagination-info');
            if (infoEl) {
                if (totalItems === 0) infoEl.textContent = '0 môn học';
                else infoEl.textContent = `Hiển thị ${startIndex + 1} - ${endIndex} trên ${totalItems} môn học`;
            }

            const controlsEl = document.getElementById('mh-pagination-controls');
            if (!controlsEl) return;
            if (totalPages <= 1) {
                controlsEl.innerHTML = '';
                return;
            }

            let html = '';
            const prevDisabled = mhCurrentPage === 1;
            html += `<button onclick="changeMhPage(${mhCurrentPage - 1})" ${prevDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${prevDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-left" class="w-3.5 h-3.5 inline"></i></button>`;

            const startP = Math.max(1, mhCurrentPage - 2);
            const endP = Math.min(totalPages, mhCurrentPage + 2);

            if (startP > 1) {
                html += `<button onclick="changeMhPage(1)" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">1</button>`;
                if (startP > 2) html += `<span class="px-1 text-text-muted">...</span>`;
            }

            for (let p = startP; p <= endP; p++) {
                const isActive = p === mhCurrentPage;
                html += `<button onclick="changeMhPage(${p})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all ${isActive ? 'bg-primary text-white shadow-md shadow-primary/20' : 'border border-surface-hover hover:bg-surface-hover text-text-primary'}">${p}</button>`;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) html += `<span class="px-1 text-text-muted">...</span>`;
                html += `<button onclick="changeMhPage(${totalPages})" class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold hover:bg-surface-hover text-text-primary">${totalPages}</button>`;
            }

            const nextDisabled = mhCurrentPage === totalPages;
            html += `<button onclick="changeMhPage(${mhCurrentPage + 1})" ${nextDisabled ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-surface-hover text-xs font-semibold ${nextDisabled ? 'opacity-40 cursor-not-allowed text-text-muted' : 'hover:bg-surface-hover text-text-primary transition-colors'}"><i data-lucide="chevron-right" class="w-3.5 h-3.5 inline"></i></button>`;

            controlsEl.innerHTML = html;
        }

        function changeMhPage(page) {
            mhCurrentPage = page;
            renderMhTable();
        }

        function changeMhPageSize(size) {
            mhPageSize = parseInt(size, 10);
            mhCurrentPage = 1;
            renderMhTable();
        }

        // ============================================
        // LOGIC CHỌN MÔN TIÊN QUYẾT & KIỂM TRA VÒNG LẶP
        // ============================================

        function onFacultyChanged() {
            const selectedKhoa = document.getElementById('mh-makhoa').value;
            const prereqKhoaFilter = document.getElementById('prereq-khoa-filter');
            if (prereqKhoaFilter) {
                prereqKhoaFilter.value = selectedKhoa;
            }
            renderAvailablePrereqs();
        }

        function isCircularDependency(candMaMon) {
            const currentCode = (editingMaMon || document.getElementById('mh-mamon').value.trim()).toUpperCase();
            if (!currentCode) return false;
            if (candMaMon.toUpperCase() === currentCode) return true;

            // Kiểm tra xem candidate môn này có phụ thuộc vào currentCode qua chuỗi tiên quyết hay không (BFS)
            const queue = [candMaMon];
            const visited = new Set();

            while (queue.length > 0) {
                const curr = queue.shift().toUpperCase();
                if (curr === currentCode) return true;

                if (!visited.has(curr)) {
                    visited.add(curr);
                    const subj = mhList.find(x => x.MaMon.toUpperCase() === curr);
                    if (subj && subj.DieuKienTienQuyets) {
                        for (const d of subj.DieuKienTienQuyets) {
                            if (d.MaMonTienQuyet) {
                                queue.push(d.MaMonTienQuyet);
                            }
                        }
                    }
                }
            }
            return false;
        }

        function renderSelectedPrereqTags() {
            const container = document.getElementById('mh-selected-tags');
            const badge = document.getElementById('prereq-count-badge');
            const clearBtn = document.getElementById('btn-clear-prereqs');

            if (badge) badge.textContent = `Đã chọn: ${selectedPrereqSet.size}`;
            if (clearBtn) {
                if (selectedPrereqSet.size > 0) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }

            if (selectedPrereqSet.size === 0) {
                container.innerHTML = '<span class="text-xs text-text-muted italic py-1">Chưa có môn tiên quyết nào được chọn</span>';
                return;
            }

            let html = '';
            selectedPrereqSet.forEach(code => {
                const subj = mhList.find(x => x.MaMon.toUpperCase() === code.toUpperCase());
                const name = subj ? subj.TenMon : code;
                html += `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold group animate-fadeIn">
                        <span><strong class="font-mono text-amber-200">${code}</strong> - ${name}</span>
                        <button type="button" onclick="removePrereqTag('${code}')" title="Xóa môn này" class="text-amber-400 hover:text-white hover:bg-amber-500/30 rounded p-0.5 transition-colors">
                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                        </button>
                    </span>
                `;
            });
            container.innerHTML = html;
            lucide.createIcons();
        }

        function removePrereqTag(code) {
            selectedPrereqSet.delete(code);
            renderSelectedPrereqTags();
            renderAvailablePrereqs();
        }

        function clearAllPrereqs() {
            selectedPrereqSet.clear();
            renderSelectedPrereqTags();
            renderAvailablePrereqs();
        }

        function togglePrereq(code) {
            if (selectedPrereqSet.has(code)) {
                selectedPrereqSet.delete(code);
            } else {
                selectedPrereqSet.add(code);
            }
            renderSelectedPrereqTags();
            renderAvailablePrereqs();
        }

        function renderAvailablePrereqs() {
            const listEl = document.getElementById('prereq-available-list');
            const countEl = document.getElementById('prereq-candidate-count');
            const filterKhoa = document.getElementById('prereq-khoa-filter')?.value || '';
            const q = document.getElementById('prereq-search')?.value.toLowerCase().trim() || '';
            const currentCode = (editingMaMon || document.getElementById('mh-mamon')?.value.trim() || '').toUpperCase();

            // Lọc danh sách ứng viên
            const filtered = mhList.filter(m => {
                const matchesQ = !q || m.MaMon.toLowerCase().includes(q) || m.TenMon.toLowerCase().includes(q);
                const matchesKhoa = !filterKhoa || m.MaKhoa === filterKhoa;
                return matchesQ && matchesKhoa;
            });

            if (countEl) {
                countEl.textContent = `${filtered.length} môn`;
            }

            if (filtered.length === 0) {
                listEl.innerHTML = `<div class="p-6 text-center text-xs text-text-muted">Không tìm thấy môn học nào phù hợp với bộ lọc</div>`;
                return;
            }

            let html = '';
            filtered.forEach(m => {
                const isSelf = currentCode && m.MaMon.toUpperCase() === currentCode;
                const isCircular = !isSelf && isCircularDependency(m.MaMon);
                const isDisabled = isSelf || isCircular;
                const isSelected = selectedPrereqSet.has(m.MaMon);

                let statusBadge = '';
                if (isSelf) {
                    statusBadge = `<span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-surface border border-surface-hover text-text-muted">Môn hiện tại</span>`;
                } else if (isCircular) {
                    statusBadge = `<span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-500/15 border border-rose-500/30 text-rose-400 flex items-center gap-1"><i data-lucide="alert-triangle" class="w-3 h-3"></i> Gây vòng lặp</span>`;
                } else if (isSelected) {
                    statusBadge = `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-primary text-white shadow-sm flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> Đã chọn</span>`;
                } else {
                    statusBadge = `<span class="text-xs text-text-muted group-hover:text-primary font-medium flex items-center gap-1">+ Chọn</span>`;
                }

                const khoaName = m.Khoa?.TenKhoa || m.MaKhoa || 'Chung';

                html += `
                    <div onclick="${isDisabled ? '' : `togglePrereq('${m.MaMon}')`}"
                         class="group p-2.5 rounded-xl transition-all flex items-center justify-between gap-3 border ${
                             isDisabled 
                                 ? 'opacity-40 cursor-not-allowed bg-canvas/30 border-transparent select-none' 
                                 : isSelected 
                                     ? 'bg-primary/10 border-primary/40 cursor-pointer shadow-sm' 
                                     : 'hover:bg-surface border-transparent hover:border-surface-hover cursor-pointer'
                         }">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center font-mono text-xs font-bold ${
                                isSelected ? 'bg-primary text-white' : 'bg-surface border border-surface-hover text-primary'
                            }">
                                ${m.MaMon.length > 5 ? m.MaMon.substring(0, 5) : m.MaMon}
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-text-primary truncate">${m.TenMon}</span>
                                    <span class="text-[11px] font-mono text-text-muted">(${m.MaMon})</span>
                                </div>
                                <div class="text-[11px] text-text-muted flex items-center gap-2 mt-0.5">
                                    <span class="font-semibold text-amber-400/90">${m.SoTinChi} TC</span>
                                    <span>•</span>
                                    <span class="truncate max-w-[140px]">${khoaName}</span>
                                    <span>•</span>
                                    <span>${m.SoTietLyThuyet || 0}LT / ${m.SoTietThucHanh || 0}TH</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex-shrink-0">
                            ${statusBadge}
                        </div>
                    </div>
                `;
            });

            listEl.innerHTML = html;
            lucide.createIcons();
        }

        function openMhModal(mh = null) {
            editingMaMon = mh ? mh.MaMon : null;
            document.getElementById('mh-modal-title').textContent = mh ? 'Cập Nhật Môn Học' : 'Thêm Môn Học Mới';
            const maMonInput = document.getElementById('mh-mamon');
            maMonInput.value = mh ? mh.MaMon : '';
            maMonInput.disabled = !!mh;
            
            const hintEl = document.getElementById('mh-mamon-hint');
            if (hintEl) {
                hintEl.textContent = mh ? 'Mã môn học không thể sửa khi cập nhật' : 'Mã định danh duy nhất (VD: IT001, CS101)';
            }

            document.getElementById('mh-tenmon').value = mh ? mh.TenMon : '';
            document.getElementById('mh-sotc').value = mh ? mh.SoTinChi : 3;
            document.getElementById('mh-lt').value = mh ? (mh.SoTietLyThuyet ?? 30) : 30;
            document.getElementById('mh-th').value = mh ? (mh.SoTietThucHanh ?? 15) : 15;

            const defaultKhoa = mh ? (mh.MaKhoa || khoas[0]?.MaKhoa || '') : (khoas[0]?.MaKhoa || '');
            document.getElementById('mh-makhoa').value = defaultKhoa;

            // Đồng bộ bộ lọc khoa của môn tiên quyết theo Khoa phụ trách
            const prereqFilter = document.getElementById('prereq-khoa-filter');
            if (prereqFilter) {
                prereqFilter.value = defaultKhoa;
            }

            const searchInput = document.getElementById('prereq-search');
            if (searchInput) searchInput.value = '';

            // Khởi tạo tập môn tiên quyết đã chọn
            selectedPrereqSet = new Set((mh?.DieuKienTienQuyets || []).map(d => d.MaMonTienQuyet).filter(Boolean));

            renderSelectedPrereqTags();
            renderAvailablePrereqs();

            document.getElementById('mh-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeMhModal() {
            document.getElementById('mh-modal').classList.add('hidden');
            editingMaMon = null;
            selectedPrereqSet.clear();
        }

        async function saveMonHoc(e) {
            e.preventDefault();
            const maMon = document.getElementById('mh-mamon').value.trim();
            const tenMon = document.getElementById('mh-tenmon').value.trim();
            const soTC = Number(document.getElementById('mh-sotc').value);
            const lt = Number(document.getElementById('mh-lt').value);
            const th = Number(document.getElementById('mh-th').value);
            const maKhoa = document.getElementById('mh-makhoa').value;

            if (!maMon || !tenMon) {
                showToast('Vui lòng nhập đầy đủ Mã môn và Tên môn!', 'error');
                return;
            }

            const payload = {
                MaMon: maMon,
                TenMon: tenMon,
                SoTinChi: soTC,
                SoTietLyThuyet: lt,
                SoTietThucHanh: th,
                MaKhoa: maKhoa,
                MonTienQuyet: Array.from(selectedPrereqSet)
            };

            try {
                if (editingMaMon) {
                    await apiFetch(`/api/monhoc/${editingMaMon}`, { method: 'PUT', body: JSON.stringify(payload) });
                    showToast('Đã cập nhật môn học thành công!');
                } else {
                    await apiFetch('/api/monhoc', { method: 'POST', body: JSON.stringify(payload) });
                    showToast('Đã thêm môn học mới thành công!');
                }
                closeMhModal();
                await loadData();
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        async function deleteMh(id) {
            if (!confirm(`Bạn có chắc chắn muốn xóa môn học ${id}?`)) return;
            try {
                await apiFetch(`/api/monhoc/${id}`, { method: 'DELETE' });
                showToast('Đã xóa môn học!');
                await loadData();
            } catch (err) {
                showToast(err.message, 'error');
            }
        }

        function exportMonHocExcel() {
            const ws = XLSX.utils.json_to_sheet(mhList.map(m => ({ 
                MaMon: m.MaMon, 
                TenMon: m.TenMon, 
                SoTinChi: m.SoTinChi, 
                SoTietLyThuyet: m.SoTietLyThuyet, 
                SoTietThucHanh: m.SoTietThucHanh, 
                MaKhoa: m.MaKhoa,
                MonTienQuyet: (m.DieuKienTienQuyets || []).map(d => d.MaMonTienQuyet).join(', ')
            })));
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'MonHoc');
            XLSX.writeFile(wb, 'DanhSach_MonHoc.xlsx');
        }

        // Tự động kiểm tra môn hiện tại khi gõ mã môn lúc tạo mới
        document.addEventListener('DOMContentLoaded', () => {
            const maMonInput = document.getElementById('mh-mamon');
            if (maMonInput) {
                maMonInput.addEventListener('input', () => {
                    if (!editingMaMon) {
                        renderAvailablePrereqs();
                    }
                });
            }
        });

        loadData();
    </script>
}
