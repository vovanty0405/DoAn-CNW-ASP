@{
    Layout = "_Layout";
}

<div class="max-w-[1600px] mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-text-muted font-medium mb-1">Hệ thống &gt; Phân tích Dữ liệu</div>
            <h1 class="text-2xl font-bold text-text-primary">Thống Kê & Báo Cáo Học Tập</h1>
        </div>
        <button onclick="exportReportExcel()" class="px-4 py-2.5 rounded-xl bg-[#10B981] text-white text-sm font-bold hover:bg-[#10B981]/90 transition-all flex items-center gap-2 shadow-lg shadow-[#10B981]/20">
            <i data-lucide="download" class="w-4 h-4"></i> Xuất Báo Cáo Excel
        </button>
    </div>

    <!-- Cascading Filter Bar -->
    <div class="bg-surface border border-surface-hover rounded-2xl p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3 items-end">
        <div>
            <label class="block text-xs text-text-muted mb-1">Khoa</label>
            <select id="f-khoa" onchange="onFilterChange()" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
                <option value="">Tất cả Khoa</option>
            </select>
        </div>
        <div>
            <label class="block text-xs text-text-muted mb-1">Ngành học</label>
            <select id="f-nganh" onchange="onFilterChange()" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
                <option value="">Tất cả Ngành</option>
            </select>
        </div>
        <div>
            <label class="block text-xs text-text-muted mb-1">Lớp hành chính</label>
            <select id="f-lop" onchange="loadDashboard()" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
                <option value="">Tất cả Lớp</option>
            </select>
        </div>
        <div>
            <label class="block text-xs text-text-muted mb-1">Học kỳ</label>
            <select id="f-hk" onchange="reloadSectionOptions()" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
                <option value="">Tất cả Học kỳ</option>
            </select>
        </div>
        <div>
            <label class="block text-xs text-text-muted mb-1">Môn học</label>
            <select id="f-mon" onchange="loadDashboard()" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
                <option value="">Tất cả Môn học</option>
            </select>
        </div>
        <div>
            <label class="block text-xs text-text-muted mb-1">Lớp học phần</label>
            <select id="f-lhp" onchange="loadDashboard()" class="w-full bg-canvas border border-surface-hover rounded-lg px-3 py-2 text-sm text-text-primary outline-none focus:border-primary">
                <option value="">Tất cả LHP</option>
            </select>
        </div>
        <div>
            <button onclick="resetFilters()" class="w-full py-2 px-3 rounded-lg bg-canvas border border-surface-hover hover:border-primary text-sm text-text-muted hover:text-text-primary transition-colors flex items-center justify-center gap-1.5">
                <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Đặt lại
            </button>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-surface border border-surface-hover rounded-2xl p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Tổng số Sinh viên</div>
            <div id="kpi-sv" class="text-3xl font-extrabold text-text-primary mt-2">0</div>
            <div class="text-xs text-text-muted mt-1">Thuộc phạm vi bộ lọc hiện tại</div>
        </div>
        <div class="bg-surface border border-surface-hover rounded-2xl p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Điểm TB Toàn khóa (Hệ 10 / Hệ 4)</div>
            <div class="mt-2 flex items-baseline gap-2">
                <span id="kpi-gpa10" class="text-3xl font-extrabold text-primary">0.0</span>
                <span class="text-sm text-text-muted">/ <strong id="kpi-gpa4" class="text-text-primary">0.0</strong> (Hệ 4)</span>
            </div>
            <div class="text-xs text-text-muted mt-1">Trung bình tích lũy có trọng số</div>
        </div>
        <div class="bg-surface border border-surface-hover rounded-2xl p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Tỷ lệ Qua môn</div>
            <div id="kpi-pass" class="text-3xl font-extrabold text-[#10B981] mt-2">0%</div>
            <div class="text-xs text-text-muted mt-1">Điểm tổng kết đạt từ 4.0 trở lên</div>
        </div>
        <div class="bg-surface border border-surface-hover rounded-2xl p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-text-muted">Tỷ lệ Rớt môn / Cảnh báo</div>
            <div class="mt-2 flex items-baseline gap-2">
                <span id="kpi-fail" class="text-3xl font-extrabold text-[#ef4444]">0%</span>
                <span class="text-xs text-amber-400">(<span id="kpi-warn">0</span> SV GPA &lt; 2.0)</span>
            </div>
            <div class="text-xs text-text-muted mt-1">Cần theo dõi & hỗ trợ học tập</div>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="bg-surface border border-surface-hover rounded-2xl p-5">
            <h3 class="font-bold text-sm text-text-primary mb-4">Phân Bố Học Lực Sinh Viên</h3>
            <div class="h-64 flex items-center justify-center">
                <canvas id="chart-hocluc"></canvas>
            </div>
        </div>
        <div class="bg-surface border border-surface-hover rounded-2xl p-5">
            <h3 class="font-bold text-sm text-text-primary mb-4">Phổ Điểm Học Phần (Hệ 10)</h3>
            <div class="h-64">
                <canvas id="chart-phodiem"></canvas>
            </div>
        </div>
        <div class="bg-surface border border-surface-hover rounded-2xl p-5">
            <h3 class="font-bold text-sm text-text-primary mb-4">Xu Hướng GPA Qua Các Học Kỳ</h3>
            <div class="h-64">
                <canvas id="chart-xuhuong"></canvas>
            </div>
        </div>
    </div>

    <!-- Top Students & Warning Students -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Top SV -->
        <div class="bg-surface border border-surface-hover rounded-2xl overflow-hidden">
            <div class="p-4 border-b border-surface-hover bg-surface-header flex items-center justify-between">
                <h3 class="font-bold text-sm text-text-primary flex items-center gap-2">
                    <i data-lucide="trophy" class="w-4 h-4 text-amber-400"></i> Top Sinh Viên Tiêu Biểu (Học bổng)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-surface-hover text-xs text-text-muted uppercase">
                            <th class="px-4 py-3">Mã SV</th>
                            <th class="px-4 py-3">Họ tên</th>
                            <th class="px-4 py-3">Lớp</th>
                            <th class="px-4 py-3 text-center">TC</th>
                            <th class="px-4 py-3 text-center">GPA (10 / 4)</th>
                            <th class="px-4 py-3 text-center">Xếp loại</th>
                        </tr>
                    </thead>
                    <tbody id="tb-top-sv" class="divide-y divide-surface-hover"></tbody>
                </table>
            </div>
        </div>

        <!-- Warning SV -->
        <div class="bg-surface border border-surface-hover rounded-2xl overflow-hidden">
            <div class="p-4 border-b border-surface-hover bg-surface-header flex items-center justify-between">
                <h3 class="font-bold text-sm text-text-primary flex items-center gap-2">
                    <i data-lucide="alert-triangle" class="w-4 h-4 text-[#ef4444]"></i> Danh Sách Cảnh Báo Học Vụ (GPA Hệ 4 &lt; 2.0)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-surface-hover text-xs text-text-muted uppercase">
                            <th class="px-4 py-3">Mã SV</th>
                            <th class="px-4 py-3">Họ tên</th>
                            <th class="px-4 py-3">Lớp</th>
                            <th class="px-4 py-3 text-center">TC Đạt</th>
                            <th class="px-4 py-3 text-center">GPA Hệ 4</th>
                            <th class="px-4 py-3 text-center">Mức độ</th>
                        </tr>
                    </thead>
                    <tbody id="tb-warn-sv" class="divide-y divide-surface-hover"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allNganhs = [], allLops = [], allMons = [], allLhps = [];
        let chartHocLuc = null, chartPhoDiem = null, chartXuHuong = null;
        let currentDashboardData = null;

        async function initFilters() {
            const [khoas, nganhs, lops, hks, mons, lhps] = await Promise.all([
                apiFetch('/api/khoa'),
                apiFetch('/api/nganh'),
                apiFetch('/api/lophanhchinh'),
                apiFetch('/api/hocky'),
                apiFetch('/api/monhoc'),
                apiFetch('/api/lophocphan/options')
            ]);

            allNganhs = nganhs.data || [];
            allLops = lops.data || [];
            allMons = mons.data || [];
            allLhps = lhps.data || [];

            const selKhoa = document.getElementById('f-khoa');
            (khoas.data || []).forEach(k => selKhoa.insertAdjacentHTML('beforeend', `<option value="${k.MaKhoa}">${k.TenKhoa}</option>`));

            const selHk = document.getElementById('f-hk');
            (hks.data || []).forEach(h => selHk.insertAdjacentHTML('beforeend', `<option value="${h.MaHK}">${h.TenHK} (${h.NamHocBatDau}-${h.NamHocKetThuc})</option>`));

            document.getElementById("f-hk").value = lhps.maHK || "";
            populateDependentSelects();
            await loadDashboard();
        }

        async function reloadSectionOptions() {
            const response = await apiFetch('/api/lophocphan/options?' + new URLSearchParams({ maHK: document.getElementById('f-hk').value }));
            allLhps = response.data || [];
            document.getElementById('f-hk').value = response.maHK || '';
            populateDependentSelects();
            await loadDashboard();
        }
        function populateDependentSelects() {
            const maKhoa = document.getElementById('f-khoa').value;
            const maNganh = document.getElementById('f-nganh').value;

            const selNganh = document.getElementById('f-nganh');
            selNganh.innerHTML = '<option value="">Tất cả Ngành</option>';
            allNganhs.filter(n => !maKhoa || n.MaKhoa === maKhoa).forEach(n => {
                selNganh.insertAdjacentHTML('beforeend', `<option value="${n.MaNganh}" ${n.MaNganh === maNganh ? 'selected' : ''}>${n.TenNganh}</option>`);
            });

            const selLop = document.getElementById('f-lop');
            selLop.innerHTML = '<option value="">Tất cả Lớp</option>';
            allLops.filter(l => !maNganh || l.MaNganh === maNganh).forEach(l => {
                selLop.insertAdjacentHTML('beforeend', `<option value="${l.MaLop}">${l.MaLop} - ${l.TenLop}</option>`);
            });

            const selMon = document.getElementById('f-mon');
            selMon.innerHTML = '<option value="">Tất cả Môn học</option>';
            allMons.filter(m => !maKhoa || m.MaKhoa === maKhoa).forEach(m => {
                selMon.insertAdjacentHTML('beforeend', `<option value="${m.MaMon}">${m.TenMon}</option>`);
            });

            const selLhp = document.getElementById('f-lhp');
            selLhp.innerHTML = '<option value="">Tất cả LHP</option>';
            allLhps.forEach(l => {
                selLhp.insertAdjacentHTML('beforeend', `<option value="${l.MaLHP}">${l.MaLHP} - ${l.TenLopHP}</option>`);
            });
        }

        function onFilterChange() {
            populateDependentSelects();
            loadDashboard();
        }

        function resetFilters() {
            ['f-khoa', 'f-nganh', 'f-lop', 'f-hk', 'f-mon', 'f-lhp'].forEach(id => document.getElementById(id).value = '');
            reloadSectionOptions();
        }

        async function loadDashboard() {
            const params = new URLSearchParams({
                maKhoa: document.getElementById('f-khoa').value,
                maNganh: document.getElementById('f-nganh').value,
                maLop: document.getElementById('f-lop').value,
                maHK: document.getElementById('f-hk').value,
                maMon: document.getElementById('f-mon').value,
                maLHP: document.getElementById('f-lhp').value
            });

            const res = await apiFetch(`/api/thongke/tong-quan?${params.toString()}`);
            const d = res.data;
            currentDashboardData = d;

            document.getElementById('kpi-sv').textContent = d.summary.tongSinhVien;
            document.getElementById('kpi-gpa10').textContent = d.summary.diemTBToanKhoa;
            document.getElementById('kpi-gpa4').textContent = d.summary.gpaHe4TB;
            document.getElementById('kpi-pass').textContent = d.summary.tyLeQuaMon + '%';
            document.getElementById('kpi-fail').textContent = d.summary.tyLeRotMon + '%';
            document.getElementById('kpi-warn').textContent = d.summary.soSVCanhBao;

            renderCharts(d);
            renderTables(d);
        }

        function renderCharts(d) {
            if (chartHocLuc) chartHocLuc.destroy();
            if (chartPhoDiem) chartPhoDiem.destroy();
            if (chartXuHuong) chartXuHuong.destroy();

            chartHocLuc = new Chart(document.getElementById('chart-hocluc'), {
                type: 'doughnut',
                data: {
                    labels: d.phanBoHocLuc.map(x => x.name),
                    datasets: [{
                        data: d.phanBoHocLuc.map(x => x.value),
                        backgroundColor: d.phanBoHocLuc.map(x => x.color),
                        borderWidth: 0
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { color: '#9ca3af' } } } }
            });

            chartPhoDiem = new Chart(document.getElementById('chart-phodiem'), {
                type: 'bar',
                data: {
                    labels: d.phoDiem.map(x => x.range),
                    datasets: [{
                        label: 'Số lượt điểm',
                        data: d.phoDiem.map(x => x.count),
                        backgroundColor: '#4d8eff',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { ticks: { color: '#9ca3af' } },
                        y: { beginAtZero: true, ticks: { color: '#9ca3af', precision: 0 } }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            chartXuHuong = new Chart(document.getElementById('chart-xuhuong'), {
                type: 'line',
                data: {
                    labels: d.xuHuongGPA.map(x => x.TenHK),
                    datasets: [
                        { label: 'GPA Hệ 10', data: d.xuHuongGPA.map(x => x.GPA_He10), borderColor: '#4d8eff', tension: 0.3 },
                        { label: 'GPA Hệ 4', data: d.xuHuongGPA.map(x => x.GPA_He4), borderColor: '#10B981', tension: 0.3 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { ticks: { color: '#9ca3af' } },
                        y: { beginAtZero: true, max: 10, ticks: { color: '#9ca3af' } }
                    },
                    plugins: { legend: { labels: { color: '#9ca3af' } } }
                }
            });
        }

        function renderTables(d) {
            const topBody = document.getElementById('tb-top-sv');
            topBody.innerHTML = (d.topSinhVien || []).length === 0
                ? `<tr><td colspan="6" class="p-6 text-center text-text-muted">Chưa có dữ liệu</td></tr>`
                : d.topSinhVien.map(s => `
                    <tr class="hover:bg-surface-hover/40">
                        <td class="px-4 py-3 font-bold text-primary">${s.MaSV}</td>
                        <td class="px-4 py-3 font-medium text-text-primary">${s.HoTen}</td>
                        <td class="px-4 py-3 text-text-muted">${s.MaLop}</td>
                        <td class="px-4 py-3 text-center">${s.TinChiTichLuy}</td>
                        <td class="px-4 py-3 text-center font-bold">${s.GPA_He10} / <span class="text-[#10B981]">${s.GPA_He4}</span></td>
                        <td class="px-4 py-3 text-center"><span class="px-2 py-0.5 rounded-full text-xs bg-[#10B981]/15 text-[#10B981] font-semibold">${s.XepLoai}</span></td>
                    </tr>
                `).join('');

            const warnBody = document.getElementById('tb-warn-sv');
            warnBody.innerHTML = (d.sinhVienCanhBao || []).length === 0
                ? `<tr><td colspan="6" class="p-6 text-center text-[#10B981]">Không có sinh viên nào bị cảnh báo học vụ!</td></tr>`
                : d.sinhVienCanhBao.map(s => `
                    <tr class="hover:bg-surface-hover/40">
                        <td class="px-4 py-3 font-bold text-[#ef4444]">${s.MaSV}</td>
                        <td class="px-4 py-3 font-medium text-text-primary">${s.HoTen}</td>
                        <td class="px-4 py-3 text-text-muted">${s.MaLop}</td>
                        <td class="px-4 py-3 text-center">${s.TinChiTichLuy}</td>
                        <td class="px-4 py-3 text-center font-bold text-[#ef4444]">${s.GPA_He4}</td>
                        <td class="px-4 py-3 text-center"><span class="px-2 py-0.5 rounded-full text-xs bg-[#ef4444]/15 text-[#ef4444] font-semibold">Cảnh báo</span></td>
                    </tr>
                `).join('');
        }

        function exportReportExcel() {
            if (!currentDashboardData) return;
            const rows = (currentDashboardData.topSinhVien || []).map((s, idx) => ({
                'STT': idx + 1,
                'Mã SV': s.MaSV,
                'Họ Tên': s.HoTen,
                'Lớp': s.MaLop,
                'Ngành': s.TenNganh,
                'Tín chỉ tích lũy': s.TinChiTichLuy,
                'GPA Hệ 10': s.GPA_He10,
                'GPA Hệ 4': s.GPA_He4,
                'Xếp loại': s.XepLoai
            }));
            const ws = XLSX.utils.json_to_sheet(rows);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'ThongKeHocTap');
            XLSX.writeFile(wb, 'BaoCao_ThongKe_HocTap.xlsx');
            window.showToast('Đã xuất báo cáo Excel!');
        }

        initFilters();
    </script>
}
