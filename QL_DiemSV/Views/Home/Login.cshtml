@{
    Layout = "_Layout";
}

<div class="min-h-screen w-full flex items-center justify-center p-4 bg-canvas relative overflow-hidden">
    <div class="w-full max-w-4xl bg-surface border border-surface-hover rounded-3xl shadow-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 z-10">
        <!-- Left Banner -->
        <div class="lg:col-span-5 bg-surface-header p-8 border-b lg:border-b-0 lg:border-r border-surface-hover flex flex-col justify-between">
            <div>
                <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-bold mb-6">
                    <i data-lucide="graduation-cap" class="w-4 h-4"></i> Academic Ledger 2.0
                </div>
                <h1 class="text-2xl font-extrabold text-text-primary leading-snug mb-3">
                    Hệ Thống Quản Lý Điểm Sinh Viên
                </h1>
                <p class="text-sm text-text-muted leading-relaxed">
                    Nền tảng quản trị đào tạo tín chỉ, xét điều kiện tốt nghiệp, nhập điểm động theo trọng số và phúc khảo trực tuyến được xây dựng trên kiến trúc <strong class="text-text-primary">ASP.NET Core MVC & SQL Server</strong>.
                </p>
            </div>

            <!-- Quick Demo Accounts -->
            <div class="mt-8 pt-6 border-t border-surface-hover">
                <div class="text-xs font-bold uppercase tracking-wider text-text-muted mb-3">Tài khoản Demo (Click để điền nhanh)</div>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <button type="button" onclick="fillDemo('admin','admin123')" class="p-2.5 rounded-xl bg-canvas border border-surface-hover hover:border-primary text-left transition-all">
                        <div class="font-bold text-primary">Quản trị viên</div>
                        <div class="text-text-muted text-[11px]">admin / admin123</div>
                    </button>
                    <button type="button" onclick="fillDemo('GV001','123456')" class="p-2.5 rounded-xl bg-canvas border border-surface-hover hover:border-primary text-left transition-all">
                        <div class="font-bold text-[#10B981]">Giảng viên</div>
                        <div class="text-text-muted text-[11px]">GV001 / 123456</div>
                    </button>
                    <button type="button" onclick="fillDemo('SV001','123456')" class="p-2.5 rounded-xl bg-canvas border border-surface-hover hover:border-primary text-left transition-all">
                        <div class="font-bold text-amber-400">Sinh viên</div>
                        <div class="text-text-muted text-[11px]">SV001 / 123456</div>
                    </button>
                    <button type="button" onclick="fillDemo('khaothi','123456')" class="p-2.5 rounded-xl bg-canvas border border-surface-hover hover:border-primary text-left transition-all">
                        <div class="font-bold text-purple-400">Phòng Khảo thí</div>
                        <div class="text-text-muted text-[11px]">khaothi / 123456</div>
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Form -->
        <div class="lg:col-span-7 p-8 sm:p-10 flex flex-col justify-center">
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-text-primary">Đăng nhập hệ thống</h2>
                <p class="text-sm text-text-muted mt-1">Vui lòng nhập thông tin tài khoản đào tạo của bạn</p>
            </div>

            <div id="login-error" class="hidden mb-4 p-3.5 rounded-xl bg-[#ef4444]/10 border border-[#ef4444]/30 text-[#ef4444] text-sm font-medium"></div>

            <form id="login-form" onsubmit="submitLogin(event)" class="space-y-5">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">Tên đăng nhập / Mã SV / Mã GV</label>
                    <div class="relative">
                        <i data-lucide="user" class="w-4 h-4 text-text-muted absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input id="username" type="text" required placeholder="Nhập tên đăng nhập..."
                               class="w-full bg-canvas border border-surface-hover rounded-xl pl-10 pr-4 py-3 text-sm text-text-primary focus:border-primary outline-none transition-colors" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">Mật khẩu</label>
                    <div class="relative">
                        <i data-lucide="lock" class="w-4 h-4 text-text-muted absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input id="password" type="password" required placeholder="Nhập mật khẩu..."
                               class="w-full bg-canvas border border-surface-hover rounded-xl pl-10 pr-4 py-3 text-sm text-text-primary focus:border-primary outline-none transition-colors" />
                    </div>
                </div>

                <button id="btn-submit" type="submit"
                        class="w-full py-3 px-6 rounded-xl bg-primary hover:bg-primary/90 text-white font-bold text-sm shadow-lg shadow-primary/25 transition-all flex items-center justify-center gap-2">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    <span>Đăng Nhập Hệ Thống</span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillDemo(u, p) {
            document.getElementById('username').value = u;
            document.getElementById('password').value = p;
        }

        async function submitLogin(e) {
            e.preventDefault();
            const errBox = document.getElementById('login-error');
            const btn = document.getElementById('btn-submit');
            errBox.classList.add('hidden');
            btn.disabled = true;

            try {
                const username = document.getElementById('username').value.trim();
                const password = document.getElementById('password').value;
                const res = await window.apiFetch('/api/auth/login', {
                    method: 'POST',
                    body: JSON.stringify({ username, password })
                });

                if (res.data?.accessToken) {
                    localStorage.setItem('accessToken', res.data.accessToken);
                    localStorage.setItem('user', JSON.stringify(res.data.user));
                }
                window.showToast('Đăng nhập thành công!');
                window.location.href = '/';
            } catch (err) {
                errBox.textContent = err.message || 'Đăng nhập thất bại!';
                errBox.classList.remove('hidden');
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}
