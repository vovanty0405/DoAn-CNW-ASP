@model QL_DiemSV.ViewModels.ArticleListViewModel
@using QL_DiemSV.Services
@{ViewData["Title"]="Quản lý bài viết";}
<div class="academic"><div class="section-heading"><div><p class="muted">Cổng đào tạo / Biên tập nội dung</p><h1>Bài viết & Thông báo</h1></div><div><a class="button secondary" href="/portal">Xem Portal</a> <a class="button" href="/bai-viet/them">+ Thêm bài viết mới</a></div></div>
@if(TempData["Message"] is string msg){<p class="success" role="status">@msg</p>}
<section class="panel"><form method="get" class="toolbar"><label>Tìm kiếm<input name="search" value="@Model.Search" placeholder="Tiêu đề hoặc đơn vị đăng" /></label><label>Danh mục<select name="category"><option value="">Tất cả</option>@foreach(var c in PortalRules.Categories){<option value="@c.Key" selected="@(Model.Category==c.Key)">@c.Value</option>}</select></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="BanNhap" selected="@(Model.Status=="BanNhap")">Bản nháp</option><option value="DaXuatBan" selected="@(Model.Status=="DaXuatBan")">Đã xuất bản</option></select></label><button>Lọc bài viết</button></form>
<p class="notice muted">@(User.IsInRole("Admin")?"Bạn đang quản lý toàn bộ bài viết.":"Bạn đang quản lý các bài viết do mình đăng.") Tổng: @Model.Total bài.</p>
<div class="scroll"><table><thead><tr><th>Tiêu đề</th><th>Danh mục</th><th>Đơn vị đăng</th><th>Ngày đăng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var a in Model.Articles){<tr><td><a href="/portal/bai-viet/@a.Id">@(a.GhimDauTrang?"📌 ":"")@a.TieuDe</a></td><td>@PortalRules.Categories.GetValueOrDefault(a.DanhMuc,a.DanhMuc)</td><td>@a.DonViDang</td><td>@PortalRules.Local(a.NgayDang).ToString("dd/MM/yyyy HH:mm")</td><td class="@(a.TrangThai=="DaXuatBan"?"success":"pending")">@(a.TrangThai=="DaXuatBan"?"Đã xuất bản":"Bản nháp")</td><td><div class="row-actions"><a class="button secondary" href="/bai-viet/@a.Id/sua">Sửa</a><form method="post" action="/bai-viet/@a.Id/ghim">@Html.AntiForgeryToken()<button class="secondary">@(a.GhimDauTrang?"Bỏ ghim":"Ghim")</button></form><form method="post" action="/bai-viet/@a.Id/xoa" onsubmit="return confirm('Xóa bài viết này?')">@Html.AntiForgeryToken()<button class="danger">Xóa</button></form></div></td></tr>}@if(Model.Articles.Count==0){<tr><td colspan="6" class="empty-state">Chưa có bài viết phù hợp.</td></tr>}</tbody></table></div>
<div class="toolbar" style="margin-top:18px">@if(Model.Page>1){<a class="button secondary" href="@Url.Action("Index",new{search=Model.Search,category=Model.Category,status=Model.Status,page=Model.Page-1})">← Trang trước</a>}<span>Trang @Model.Page / @Math.Max(1,(Model.Total+19)/20)</span>@if(Model.Page*20<Model.Total){<a class="button secondary" href="@Url.Action("Index",new{search=Model.Search,category=Model.Category,status=Model.Status,page=Model.Page+1})">Trang sau →</a>}</div>
</section></div>
