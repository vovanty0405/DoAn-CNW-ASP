@using QL_DiemSV.Services
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@using System.Security.Claims
@inject IConfiguration Configuration
@{
    var logged = User.Identity?.IsAuthenticated == true;
    var canWrite = User.IsInRole("Admin") || (User.IsInRole("DaoTao") && (await Authorization.AuthorizeAsync(User, Context, ContentAccess.ArticleView)).Succeeded);
    var canManageCurriculum = User.IsInRole("Admin") || (User.IsInRole("DaoTao") && (await Authorization.AuthorizeAsync(User, Context, ContentAccess.CurriculumView)).Succeeded);
    var tkbPortalUrl = User.IsInRole("SinhVien")
        ? $"/portal/tra-cuu-tkb?code={Uri.EscapeDataString(User.FindFirst("MaSV")?.Value ?? User.Identity?.Name ?? "")}&kind=student"
        : User.IsInRole("GiangVien")
            ? $"/portal/tra-cuu-tkb?code={Uri.EscapeDataString(User.FindFirst("MaGV")?.Value ?? User.Identity?.Name ?? "")}&kind=lecturer"
            : "/portal/tra-cuu-tkb";
}
<!DOCTYPE html>
<html lang="vi" class="light enterprise">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] · Academic Ledger</title>
    <script>
        (() => {
            const theme = localStorage.getItem('app-theme') || 'light';
            document.documentElement.classList.toggle('dark', theme === 'dark');
            document.documentElement.classList.toggle('light', theme !== 'dark');
        })();
    </script>
    <link rel="stylesheet" href="~/css/academic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="portal-body" id="top">
    <div class="university-banner">
        <a href="/portal" class="portal-brand">
            <span class="brand-mark" aria-hidden="true">AL</span>
            <span>
                <strong>TRƯỜNG ĐẠI HỌC AN GIANG</strong>
                <small>CỔNG THÔNG TIN ĐÀO TẠO</small>
            </span>
        </a>
    </div>
    <header class="portal-header">
        <nav class="portal-nav" aria-label="Điều hướng chính">
            <a href="/portal">Trang chủ</a>
            <a href="/Portal/Articles">Bài viết & Thông báo</a>
            <a href="/portal#curriculum">Đào tạo</a>
            <a href="/portal#regulations">Quy trình - Quy định</a>
            <a href="/portal#documents">Văn bản - Hướng dẫn</a>
            <a href="/Portal/LichPhongHoc">Lịch phòng học</a>
            <a href="/portal/tra-cuu-tkb">Tra cứu TKB</a>
            <a href="/Portal/KetQuaHocTap">Kết quả học tập</a>
        </nav>
        <div class="portal-account">
            <button type="button" class="theme-toggle" id="portal-theme" aria-label="Chuyển giao diện Sáng/Tối">◐</button>
            @if (logged)
            {
                <div class="portal-notif-wrapper" id="portal-notif-wrapper">
                    <button type="button" class="portal-notif-btn" id="portal-notif-btn" aria-label="Thông báo" title="Thông báo">
                        <span aria-hidden="true">🔔</span>
                        <span class="portal-notif-badge" id="portal-notif-badge" hidden>0</span>
                    </button>
                    <div class="portal-notif-dropdown" id="portal-notif-dropdown" hidden>
                        <div class="portal-notif-header">
                            <strong>Thông báo</strong>
                            <button type="button" class="portal-notif-readall" id="portal-notif-readall">Đánh dấu tất cả đã đọc</button>
                        </div>
                        <div class="portal-notif-list" id="portal-notif-list">
                            <div class="portal-notif-empty">Đang tải thông báo...</div>
                        </div>
                    </div>
                </div>
                <details class="user-menu">
                    <summary>@(User.FindFirst("HoTen")?.Value ?? User.Identity?.Name) ▾</summary>
                    <div>
                        @if (User.IsInRole("SinhVien"))
                        {
                            <a href="/Portal/KetQuaHocTap">📊 Kết quả học tập &amp; Tốt nghiệp</a>
                            <a href="/Portal/KetQuaHocTap?tab=ho-so">👤 Hồ sơ sinh viên &amp; Đổi mật khẩu</a>
                            <a href="/Portal/KetQuaHocTap?tab=khieu-nai">📝 Lịch sử khiếu nại điểm</a>
                        }
                        <a href="@tkbPortalUrl">🗓️ Thời khóa biểu cá nhân</a>
                        @if (canManageCurriculum) { <a href="/admin/curriculums">Quản lý Chương trình đào tạo</a> }
                        @if (canWrite)
                        {
                            <a href="/bai-viet">📰 Quản lý bài viết</a>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("GiangVien") || User.IsInRole("KhaoThi") || User.IsInRole("GiaoVuKhoa"))
                        {
                            <a href="/Portal/KetQuaHocTap">📊 Tra cứu KQHT &amp; Tốt nghiệp</a>
                            <a href="/tra-cuu-diem">🔎 Danh sách tra cứu điểm</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("KhaoThi")) { <a href="/">⚙️ Khu vực quản trị</a> }
                        }
                    </div>
                </details>
                <button id="portal-logout" class="portal-logout-button" type="button">Đăng xuất</button>
            }
            else
            {
                <a class="portal-button" href="/login">Đăng nhập →</a>
            }
        </div>
    </header>
    <main class="portal-main">@RenderBody()</main>
    <footer class="portal-footer" id="contact">
        <div>
            <a href="/portal" class="footer-brand">Academic Ledger</a>
            <p>Cổng thông tin đào tạo dành cho sinh viên & giảng viên.</p>
            @foreach (var key in new[] { ("DiaChi", "Địa chỉ"), ("Hotline", "Hotline"), ("Email", "Email") })
            {
                var value = Configuration["Portal:" + key.Item1];
                if (!string.IsNullOrWhiteSpace(value))
                {
                    <p>@key.Item2: @value</p>
                }
            }
            @if (string.IsNullOrWhiteSpace(Configuration["Portal:Email"]) && string.IsNullOrWhiteSpace(Configuration["Portal:Hotline"]))
            {
                <p>Thông tin liên hệ các phòng ban đang được cập nhật.</p>
            }
        </div>
        <div>
            <h3>Liên kết nhanh</h3>
            <a href="/Portal/Articles">Tất cả bài viết & thông báo</a>
            <a href="/portal/tra-cuu-tkb">Tra cứu thời khóa biểu</a>
            <a href="/Portal/LichPhongHoc">Lịch phòng học</a>
            <a href="/portal#curriculum">Chương trình đào tạo</a>
        </div>
        <div>
            <h3>Đồng hành cùng bạn</h3>
            <p>Thông tin chính xác. Học tập chủ động.</p>

            <a href="#top" class="back-top">↑ Về đầu trang</a>
        </div>
    </footer>
    <div class="university-copyright">© @QL_DiemSV.Services.RoomMatrixRules.Today.Year. Trường Đại học An Giang. All Rights Reserved.</div>
    <script>
        window.PORTAL_USER = {
            isAuthenticated: @(logged ? "true" : "false"),
            username: '@Html.Raw(User.Identity?.Name ?? "")',
            role: '@Html.Raw(User.FindFirst(ClaimTypes.Role)?.Value ?? "")',
            maSV: '@Html.Raw(User.FindFirst("MaSV")?.Value ?? "")',
            maGV: '@Html.Raw(User.FindFirst("MaGV")?.Value ?? "")'
        };
    </script>
    <script src="~/js/portal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
