@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "/";
    var isLoginPage = currentPath.StartsWith("/login");
    var username = User.Identity?.Name ?? "Khách";
    var roleName = User.FindFirst(ClaimTypes.Role)?.Value ?? "SinhVien";
    var hoTen = User.FindFirst("HoTen")?.Value ?? username;
    var maGV = User.FindFirst("MaGV")?.Value ?? "";
    var maSV = User.FindFirst("MaSV")?.Value ?? "";
}
<!DOCTYPE html>
<html lang="vi" class="enterprise">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Điểm Sinh Viên</title>

    <link rel="stylesheet" href="~/css/academic.css" asp-append-version="true" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN with Custom Theme Colors matching NodeJS+ReactJS project -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        canvas: 'var(--color-canvas)',
                        surface: 'var(--color-surface)',
                        'surface-hover': 'var(--color-surface-hover)',
                        'surface-header': 'var(--color-surface-header)',
                        primary: 'var(--color-primary)',
                        'primary-hover': 'var(--color-primary-hover)',
                        'text-primary': 'var(--color-text-primary)',
                        'text-main': 'var(--color-text-primary)',
                        'text-muted': 'var(--color-text-muted)',
                        'semantic-success': 'var(--color-semantic-success)',
                        'semantic-error': 'var(--color-semantic-error)',
                        'semantic-warning': 'var(--color-semantic-warning)',
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons, SheetJS (XLSX), Chart.js -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <style>
        :root {
            --font-sans: 'Inter', sans-serif;
            --color-canvas: #10131a;
            --color-surface: #1d2027;
            --color-surface-hover: #32353c;
            --color-surface-header: #191b23;
            --color-primary: #4d8eff;
            --color-primary-hover: #adc6ff;
            --color-text-primary: #e1e2ec;
            --color-text-muted: #9ca3af;
            --color-semantic-success: #10B981;
            --color-semantic-error: #ffb4ab;
            --color-semantic-warning: #df7412;
        }

        html.light {
            --color-canvas: #f3f4f6;
            --color-surface: #ffffff;
            --color-surface-hover: #e5e7eb;
            --color-surface-header: #f9fafb;
            --color-primary: #2563eb;
            --color-primary-hover: #1d4ed8;
            --color-text-primary: #111827;
            --color-text-muted: #6b7280;
            --color-semantic-success: #10B981;
            --color-semantic-error: #ef4444;
            --color-semantic-warning: #f59e0b;
        }

        body {
            background-color: var(--color-canvas);
            color: var(--color-text-primary);
            font-family: var(--font-sans);
            -webkit-font-smoothing: antialiased;
        }

        .input-field {
            background-color: var(--color-canvas);
            color: var(--color-text-primary);
            border: 1px solid var(--color-surface-hover);
            border-radius: 0.75rem;
            padding: 0.5rem 0.75rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .input-field:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 2px rgba(77, 142, 255, 0.2);
        }
        .input-field option {
            background-color: var(--color-surface);
            color: var(--color-text-primary);
        }
        .input-field::placeholder {
            color: var(--color-text-muted);
            opacity: 0.75;
        }

        .card {
            background-color: var(--color-surface);
            border: 1px solid var(--color-surface-hover);
            border-radius: 1rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            font-weight: 600;
            padding: 0.5rem 1rem;
            transition: all 0.2s;
            cursor: pointer;
        }
        .btn-primary {
            background-color: var(--color-primary);
            color: #ffffff;
        }
        .btn-primary:hover {
            filter: brightness(1.08);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .badge-success {
            background-color: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .badge-warning {
            background-color: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }
        .badge-danger {
            background-color: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        .badge-info {
            background-color: rgba(77, 142, 255, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(77, 142, 255, 0.3);
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--color-surface-hover); border-radius: 9999px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: var(--color-primary); }
    </style>

    <script>
        // Restore theme & font before paint
        (function () {
            const savedTheme = localStorage.getItem('app-theme') || 'dark';
            if (savedTheme === 'light') document.documentElement.classList.add('light');
            const savedFont = localStorage.getItem('app-font') || 'Inter';
            document.documentElement.style.setProperty('--font-sans', `'${savedFont}', sans-serif`);
        })();

        window.CURRENT_USER = {
            isAuthenticated: @(isAuthenticated ? "true" : "false"),
            username: "@Html.Raw(username)",
            role: "@Html.Raw(roleName)",
            hoTen: "@Html.Raw(hoTen)",
            maGV: "@Html.Raw(maGV)",
            maSV: "@Html.Raw(maSV)"
        };

        window.showToast = function (message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            const bgClass = type === 'error'
                ? 'bg-[#ef4444] text-white border-[#ef4444]'
                : type === 'warning'
                    ? 'bg-[#df7412] text-white border-[#df7412]'
                    : 'bg-[#10B981] text-white border-[#10B981]';
            toast.className = `flex items-center gap-3 px-4 py-3 rounded-xl shadow-2xl border ${bgClass} text-sm font-medium transform transition-all duration-300 translate-y-2 opacity-0`;
            toast.innerHTML = `<span>${message}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-x-4');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        };

        window.apiFetch = async function (url, options = {}) {
            const defaultHeaders = { 'Content-Type': 'application/json' };
            const res = await fetch(url, {
                ...options,
                headers: { ...defaultHeaders, ...(options.headers || {}) }
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok || json.status === 'error') {
                throw new Error(json.message || `Lỗi HTTP ${res.status}`);
            }
            return json;
        };
    </script>
<link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="enterprise-admin min-h-screen flex bg-canvas text-text-primary selection:bg-primary selection:text-white">
    <!-- Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-[100] flex flex-col gap-2 max-w-sm"></div>

    @if (isLoginPage || !isAuthenticated)
    {
        <main class="w-full min-h-screen">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="admin-wrapper">
        <!-- Fixed Sidebar -->
        <aside class="admin-sidebar w-64 border-r border-surface-hover flex flex-col fixed inset-y-0 left-0 z-40 select-none">
            <!-- Brand Header -->
            <div class="sidebar-brand">
                <div class="w-10 h-10 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center text-primary shadow-inner">
                    <i data-lucide="graduation-cap" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-base tracking-tight text-text-primary leading-tight">Academic Ledger</h1>
                    <span class="admin-brand-badge">@roleName</span>
                </div>
            </div>

            <!-- Navigation Menu -->
            <partial name="_SidebarNavigation" />

            <div class="admin-website-links">
                <p>CẤU HÌNH WEBSITE</p>
                <a href="/portal">↗ Xem trang Cổng thông tin</a>
            </div>

            <!-- User Footer -->
            <div class="admin-sidebar-account p-4 border-t border-surface-hover space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-9 h-9 rounded-full bg-primary/20 text-primary font-bold flex items-center justify-center text-sm shrink-0">
                            @(hoTen.Length > 0 ? hoTen.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div class="truncate">
                            <div class="text-sm font-semibold text-text-primary truncate" title="@hoTen">@hoTen</div>
                            <div class="text-[11px] text-primary font-medium">@roleName (@username)</div>
                        </div>
                    </div>
                    <button onclick="toggleSettingsDrawer()" title="Cài đặt Giao diện" class="p-2 text-text-muted hover:text-primary hover:bg-surface-hover rounded-lg transition-colors">
                        <i data-lucide="settings" class="w-4 h-4"></i>
                    </button>
                </div>
                <button onclick="handleLogout()" class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-[#ef4444]/10 hover:bg-[#ef4444]/20 text-[#ef4444] text-xs font-semibold transition-colors">
                    <i data-lucide="log-out" class="w-3.5 h-3.5"></i> Đăng xuất
                </button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-main">
            <!-- Top Header Bar with Notification Bell -->
            <header class="admin-topbar">
                <div class="flex items-center gap-2 text-sm text-text-muted">
                    <strong class="admin-page-title">@ViewData["Title"]</strong>
                </div>

                <div class="admin-topbar-actions">
                    <a href="/portal" class="admin-outline-link">Trang chủ Portal ↗</a>
                    <details class="admin-account-menu">
                        <summary>@hoTen</summary>
                        <div class="admin-account-dropdown">
                            <span>@roleName · @username</span>
                            <button type="button" onclick="handleLogout()">Đăng xuất</button>
                        </div>
                    </details>
                    <!-- Quick Theme Toggle -->
                    <button onclick="quickToggleTheme()" class="p-2 rounded-lg bg-canvas border border-surface-hover text-text-muted hover:text-primary transition-colors" title="Đổi giao diện Sáng/Tối">
                        <i data-lucide="sun-moon" class="w-4 h-4"></i>
                    </button>

                    <!-- Notification Bell -->
                    <div class="relative" id="notif-wrapper">
                        <button onclick="toggleNotificationDropdown()" class="relative p-2 rounded-lg bg-canvas border border-surface-hover text-text-muted hover:text-primary transition-colors">
                            <i data-lucide="bell" class="w-4 h-4"></i>
                            <span id="notif-badge" class="hidden absolute -top-1 -right-1 w-4 h-4 rounded-full bg-[#ef4444] text-white text-[10px] font-bold flex items-center justify-center">0</span>
                        </button>

                        <div id="notif-dropdown" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-surface border border-surface-hover rounded-2xl shadow-2xl overflow-hidden z-50">
                            <div class="p-3.5 border-b border-surface-hover bg-surface-header flex items-center justify-between">
                                <span class="text-xs font-bold uppercase tracking-wider text-text-primary flex items-center gap-1.5">
                                    <i data-lucide="bell-ring" class="w-3.5 h-3.5 text-primary"></i> Thông báo hệ thống
                                </span>
                                <button onclick="markAllNotificationsRead()" class="text-xs text-primary hover:underline">Đọc tất cả</button>
                            </div>
                            <div id="notif-list" class="max-h-80 overflow-y-auto divide-y divide-surface-hover custom-scrollbar">
                                <div class="p-6 text-center text-xs text-text-muted">Đang tải thông báo...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <main class="admin-content flex-1">
                @RenderBody()
            </main>
        </div>

        </div>

        <!-- Settings Drawer Modal -->
        <div id="settings-drawer" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex justify-end">
            <div class="w-80 bg-surface h-full border-l border-surface-hover p-6 flex flex-col justify-between shadow-2xl">
                <div class="space-y-6">
                    <div class="flex items-center justify-between border-b border-surface-hover pb-4">
                        <h3 class="font-bold text-text-primary flex items-center gap-2">
                            <i data-lucide="Sliders" class="w-4 h-4 text-primary"></i> Cá nhân hóa Giao diện
                        </h3>
                        <button onclick="toggleSettingsDrawer()" class="text-text-muted hover:text-text-primary">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">Chế độ màu sắc</label>
                        <div class="grid grid-cols-2 gap-3">
                            <button onclick="setAppTheme('dark')" class="p-3 rounded-xl border border-surface-hover bg-[#10131a] text-white text-xs font-semibold flex items-center justify-center gap-2 hover:border-primary">
                                <i data-lucide="moon" class="w-4 h-4 text-primary"></i> Tối (Dark)
                            </button>
                            <button onclick="setAppTheme('light')" class="p-3 rounded-xl border border-surface-hover bg-white text-gray-900 text-xs font-semibold flex items-center justify-center gap-2 hover:border-primary">
                                <i data-lucide="sun" class="w-4 h-4 text-amber-500"></i> Sáng (Light)
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">Phông chữ hệ thống</label>
                        <div class="space-y-2">
                            <button onclick="setAppFont('Inter')" class="w-full text-left px-4 py-2.5 rounded-lg border border-surface-hover bg-canvas hover:border-primary text-sm">Inter (Mặc định)</button>
                            <button onclick="setAppFont('Plus Jakarta Sans')" class="w-full text-left px-4 py-2.5 rounded-lg border border-surface-hover bg-canvas hover:border-primary text-sm">Plus Jakarta Sans</button>
                            <button onclick="setAppFont('Roboto')" class="w-full text-left px-4 py-2.5 rounded-lg border border-surface-hover bg-canvas hover:border-primary text-sm">Roboto</button>
                        </div>
                    </div>
                </div>

                <div class="text-xs text-text-muted border-t border-surface-hover pt-4">
                    Phiên bản ASP.NET Core 8.0 MVC • SQL Server
                </div>
            </div>
        </div>
    }

    <script>
        lucide.createIcons();

        function toggleSettingsDrawer() {
            const el = document.getElementById('settings-drawer');
            if (el) el.classList.toggle('hidden');
        }

        function setAppTheme(mode) {
            localStorage.setItem('app-theme', mode);
            if (mode === 'light') document.documentElement.classList.add('light');
            else document.documentElement.classList.remove('light');
        }

        function quickToggleTheme() {
            const isLight = document.documentElement.classList.contains('light');
            setAppTheme(isLight ? 'dark' : 'light');
        }

        function setAppFont(fontName) {
            localStorage.setItem('app-font', fontName);
            document.documentElement.style.setProperty('--font-sans', `'${fontName}', sans-serif`);
        }

        async function handleLogout() {
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch (e) { }
            localStorage.removeItem('accessToken');
            localStorage.removeItem('user');
            window.location.href = '/login';
        }

        // Notification Bell Logic
        function getRecipientCode() {
            const u = window.CURRENT_USER;
            if (!u || !u.isAuthenticated) return null;
            if (u.role === 'Admin') return 'ADMIN';
            if (u.role === 'GiangVien') return u.maGV || u.username;
            if (u.role === 'SinhVien') return u.maSV || u.username;
            return u.username;
        }

        async function loadNotifications() {
            const code = getRecipientCode();
            if (!code) return;
            try {
                const res = await fetch(`/api/thongbao/${encodeURIComponent(code)}`);
                const json = await res.json();
                const list = json.data || [];
                const unread = list.filter(n => !n.DaDoc).length;
                const badge = document.getElementById('notif-badge');
                if (badge) {
                    if (unread > 0) {
                        badge.textContent = unread > 9 ? '9+' : unread;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }
                const container = document.getElementById('notif-list');
                if (container) {
                    if (list.length === 0) {
                        container.innerHTML = `<div class="p-6 text-center text-xs text-text-muted">Chưa có thông báo nào</div>`;
                    } else {
                        container.innerHTML = list.map(n => `
                            <div onclick="handleNotificationClick(${n.MaThongBao}, '${n.LoaiThongBao || ''}', '${n.ThamChieuID || ''}')"
                                 class="p-3.5 hover:bg-surface-hover/50 cursor-pointer transition-colors ${!n.DaDoc ? 'bg-primary/5 border-l-2 border-l-primary' : ''}">
                                <div class="flex justify-between items-start gap-2">
                                    <div class="text-xs font-bold text-text-primary">${n.TieuDe || 'Thông báo'}</div>
                                    <span class="text-[10px] text-text-muted whitespace-nowrap">${new Date(n.NgayGui).toLocaleDateString('vi-VN')}</span>
                                </div>
                                <p class="text-xs text-text-muted mt-1 leading-relaxed">${n.NoiDung || ''}</p>
                            </div>
                        `).join('');
                    }
                }
            } catch (err) { }
        }

        function toggleNotificationDropdown() {
            const dd = document.getElementById('notif-dropdown');
            if (dd) dd.classList.toggle('hidden');
        }

        async function handleNotificationClick(id, type, refId) {
            try {
                await fetch(`/api/thongbao/${id}/read`, { method: 'PUT' });
                await loadNotifications();
                if (type === 'COMPLAINT_NEW') window.location.href = '/khieu-nai';
                else if (type === 'PhucKhaoDiem' || type === 'COMPLAINT_PROCESSED') window.location.href = '/Portal/KetQuaHocTap?tab=khieu-nai';
                else if (type === 'DiemSo') window.location.href = '/Portal/KetQuaHocTap';
                else if (type === 'UNLOCK_REQUEST' || type === 'UNLOCK_APPROVED') window.location.href = '/diem-so';
            } catch (e) { }
        }

        async function markAllNotificationsRead() {
            const code = getRecipientCode();
            if (!code) return;
            await fetch(`/api/thongbao/read-all/${encodeURIComponent(code)}`, { method: 'PUT' });
            await loadNotifications();
        }

        if (window.CURRENT_USER && window.CURRENT_USER.isAuthenticated) {
            loadNotifications();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
<script src="~/js/sidebar.js" asp-append-version="true"></script>
</body>
</html>
