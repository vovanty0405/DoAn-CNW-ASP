@model QL_DiemSV.ViewModels.ScheduleEditorViewModel
@using QL_DiemSV.Models
@using QL_DiemSV.Services
@{ViewData["Title"]="Điều phối lịch học"; var s=Model.Section; var hk=s.HocKy; var config=Model.ConfigurationTerm;}
<div class="academic"><div><p class="muted">Quản lý đào tạo / Admin</p><h1>Điều phối lịch học & Phòng học</h1></div>
@if(TempData["Error"] is string error){<p class="notice error" role="alert">@error</p>}
@if(TempData["Message"] is string message){<p class="notice success" role="status">@message</p>}
<section class="panel"><div class="toolbar"><form method="get"><input type="hidden" name="configHK" value="@config?.MaHK" /><label>Lớp học phần<select name="id" onchange="this.form.submit()">@foreach(var l in Model.Sections){<option value="@l.MaLHP" selected="@(l.MaLHP==s.MaLHP)">@l.MaLHP · @l.TenLopHP</option>}</select></label></form><a class="button secondary" href="/quan-ly-lich-hoc/ma-tran?maHK=@s.MaHK">Ma trận điều phối phòng</a><a class="button secondary" href="/lop-hoc-phan">Quản lý lớp học phần</a></div>
@if(!string.IsNullOrEmpty(s.MaLHP)) {
<form method="post" action="/quan-ly-lich-hoc/luu" id="schedule-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.MaLHP" /><input type="hidden" name="configHK" value="@config?.MaHK" />
<div class="toolbar"><label>NMH<input name="nmh" value="@s.NMH" required maxlength="10" /></label><label>Tổ thực hành<input name="tth" value="@s.TTH" maxlength="10" /></label><label>STC<input name="stc" type="number" min="0" max="30" value="@s.STC" required /></label><label>STCHP<input name="stchp" type="number" step="0.01" min="0" max="100" value="@s.STCHP.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label><label>Mã lớp hành chính<select name="maLop"><option value="">-- Chưa phân lớp hành chính --</option>@foreach(var classroom in Model.AdministrativeClasses){<option value="@classroom.MaLop" selected="@(classroom.MaLop==s.MaLop)">@classroom.MaLop - @classroom.TenLop</option>}</select></label><label>Sĩ số tối đa<input name="capacity" type="number" min="1" value="@s.SiSoToiDa" required /></label></div>
<div class="scroll"><table class="editor"><thead><tr><th>TH</th><th>Thứ</th><th>Tiết BĐ</th><th>Số tiết</th><th>Phòng</th><th>Giảng viên</th><th>Loại lịch</th><th>Tuần học</th><th>Tuần báo nghỉ</th><th>Xóa</th></tr></thead><tbody id="schedule-rows">
@foreach(var l in s.LichHocs.OrderBy(x=>x.Thu).ThenBy(x=>x.TietBatDau)) {
<tr><td><input type="hidden" data-field="MaLHP" value="@s.MaLHP" /><input data-field="LoaiBuoiHoc" type="checkbox" value="true" checked="@l.LoaiBuoiHoc" aria-label="Thực hành" /></td><td><select data-field="Thu">@for(int d=2;d<=8;d++){<option value="@d" selected="@(d==l.Thu)">@QL_DiemSV.Services.ScheduleRules.DayName(d)</option>}</select></td><td><input data-field="TietBatDau" type="number" min="1" max="12" value="@l.TietBatDau" required /></td><td><input data-field="SoTiet" type="number" min="1" max="12" value="@l.SoTiet" required /></td><td><select data-field="PhongHoc" required>@foreach(var r in Model.Rooms){<option value="@r.MaPhong" selected="@(r.MaPhong==l.PhongHoc)">@r.MaPhong (@r.SucChua) · @RoomMatrixRules.Statuses.GetValueOrDefault(r.TrangThai,r.TrangThai)</option>}</select></td><td><select data-field="MaGV" required>@foreach(var t in Model.Teachers){<option value="@t.MaGV" selected="@(t.MaGV==l.MaGV)">@t.HoTen</option>}</select></td><td><select data-field="LoaiLich">@foreach(var type in RoomMatrixRules.ScheduleTypes){<option value="@type.Key" selected="@(type.Key==l.LoaiLich)">@type.Value</option>}</select></td><td><input data-field="ChuoiTuanHoc" value="@l.ChuoiTuanHoc" required maxlength="200" /></td><td><input data-field="TuanBaoNghi" value="@l.TuanBaoNghi" maxlength="200" placeholder="VD: 3,5" aria-label="Tuần báo nghỉ" /></td><td><button type="button" class="secondary" onclick="this.closest('tr').remove()">Xóa</button></td></tr>
}
</tbody></table></div>
<p class="notice muted">Tuần học: nhập số hoặc khoảng, ví dụ 1-5,8,10-12. Thứ Hai = 2, Chủ nhật = 8. Hệ thống kiểm tra giao nhau theo tuần; cảnh báo khi vượt sức chứa phòng.</p>
<div class="toolbar"><button type="button" id="add-schedule" class="secondary">+ Thêm buổi học</button><button>Lưu thông tin & Lịch học</button></div></form>
<template id="schedule-template"><tr><td><input type="hidden" data-field="MaLHP" value="@s.MaLHP" /><input data-field="LoaiBuoiHoc" type="checkbox" value="true" aria-label="Thực hành" /></td><td><select data-field="Thu">@for(int d=2;d<=8;d++){<option value="@d">@QL_DiemSV.Services.ScheduleRules.DayName(d)</option>}</select></td><td><input data-field="TietBatDau" type="number" min="1" max="12" value="1" required /></td><td><input data-field="SoTiet" type="number" min="1" max="12" value="3" required /></td><td><select data-field="PhongHoc" required>@foreach(var r in Model.Rooms){<option value="@r.MaPhong">@r.MaPhong (@r.SucChua) · @RoomMatrixRules.Statuses.GetValueOrDefault(r.TrangThai,r.TrangThai)</option>}</select></td><td><select data-field="MaGV" required>@foreach(var t in Model.Teachers){<option value="@t.MaGV">@t.HoTen</option>}</select></td><td><select data-field="LoaiLich">@foreach(var type in RoomMatrixRules.ScheduleTypes){<option value="@type.Key">@type.Value</option>}</select></td><td><input data-field="ChuoiTuanHoc" value="1-@(hk?.SoTuan ?? 20)" required maxlength="200" /></td><td><input data-field="TuanBaoNghi" maxlength="200" placeholder="VD: 3,5" aria-label="Tuần báo nghỉ" /></td><td><button type="button" class="secondary" onclick="this.closest('tr').remove()">Xóa</button></td></tr></template>
}else{<p class="muted">Hãy tạo lớp học phần trước khi xếp lịch.</p>}
</section>
<section class="panel" id="rooms">
<div class="section-heading"><div><p class="muted">Danh mục cơ sở vật chất</p><h2>Khai báo phòng học</h2></div><span class="badge neutral">@Model.Rooms.Count phòng</span></div>
<form method="post" action="/quan-ly-lich-hoc/phong" id="room-form" class="toolbar">
@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.MaLHP" /><input type="hidden" name="configHK" value="@config?.MaHK" /><input type="hidden" name="originalMaPhong" />
<label>Mã phòng<input name="maPhong" required maxlength="50" placeholder="VD: NA301" /></label>
<label>Tòa nhà / Khu vực<select name="toaNha">@foreach(var b in RoomMatrixRules.Buildings){<option value="@b.Key" selected="@(b.Key=="Khac")">@b.Value</option>}</select></label>
<label>Sức chứa<input name="sucChua" type="number" min="1" max="10000" required value="40" /></label>
<label>Trạng thái<select name="trangThai">@foreach(var status in RoomMatrixRules.Statuses){<option value="@status.Key">@status.Value</option>}</select></label>
<button id="room-save">Thêm phòng</button><button type="button" class="secondary" id="room-cancel" hidden>Hủy sửa</button>
</form>
<p id="room-edit-message" class="notice muted" role="status">Chọn Sửa để cập nhật hoặc đổi mã phòng. Mã phòng mới sẽ được cập nhật vào lịch đang liên kết.</p>
<div class="scroll"><table><thead><tr><th>Mã phòng</th><th>Tòa nhà</th><th>Sức chứa</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var room in Model.Rooms){<tr><td><strong>@room.MaPhong</strong></td><td>@RoomMatrixRules.Buildings.GetValueOrDefault(room.ToaNha,room.ToaNha)</td><td>@room.SucChua</td><td><span class="badge @(room.TrangThai=="HoatDong"?"active":room.TrangThai=="BaoTri"?"maintenance":"locked")">@RoomMatrixRules.Statuses.GetValueOrDefault(room.TrangThai,room.TrangThai)</span></td><td><div class="row-actions"><button type="button" class="secondary room-edit" data-code="@room.MaPhong" data-building="@room.ToaNha" data-capacity="@room.SucChua" data-status="@room.TrangThai">Sửa</button><form method="post" action="/quan-ly-lich-hoc/phong/xoa" class="room-delete">@Html.AntiForgeryToken()<input type="hidden" name="maPhong" value="@room.MaPhong" /><input type="hidden" name="id" value="@s.MaLHP" /><input type="hidden" name="configHK" value="@config?.MaHK" /><button class="danger" aria-label="Xóa phòng @room.MaPhong">Xóa</button></form></div></td></tr>}
@if(Model.Rooms.Count==0){<tr><td colspan="5" class="empty-state">Chưa có phòng học. Thêm phòng để bắt đầu xếp lịch.</td></tr>}
</tbody></table></div>
</section>
<section class="panel" id="term-config"><div class="section-heading"><div><p class="muted">Thời gian và học phí</p><h2>Cấu hình Học kỳ</h2></div></div>
<form method="get" action="/quan-ly-lich-hoc#term-config" class="toolbar"><input type="hidden" name="id" value="@s.MaLHP" /><label>Chọn học kỳ cấu hình<select name="configHK" onchange="this.form.submit()">@foreach(var term in Model.Terms){<option value="@term.MaHK" selected="@(term.MaHK==config?.MaHK)">@term.TenHK · @term.NamHocBatDau-@term.NamHocKetThuc</option>}</select></label><button class="secondary">Tải cấu hình</button></form>
@if(config!=null){
<p class="notice muted">Đang cấu hình: @config.TenHK · @config.NamHocBatDau-@config.NamHocKetThuc</p>
<form method="post" action="/quan-ly-lich-hoc/hoc-ky" class="toolbar">@Html.AntiForgeryToken()<input type="hidden" name="maHK" value="@config.MaHK" /><input type="hidden" name="id" value="@s.MaLHP" />
<label>Ngày bắt đầu tuần 1 (Thứ Hai)<input name="ngayBatDauTuan1" type="date" value="@config.NgayBatDauTuan1?.ToString("yyyy-MM-dd")" required /></label>
<label>Số tuần<input name="soTuan" type="number" min="1" max="52" value="@config.SoTuan" required /></label>
<label>Bắt đầu đăng ký (giờ VN)<input name="batDauDangKy" type="datetime-local" value="@config.BatDauDangKy?.ToString("yyyy-MM-ddTHH:mm")" required /></label>
<label>Kết thúc đăng ký (giờ VN)<input name="ketThucDangKy" type="datetime-local" value="@config.KetThucDangKy?.ToString("yyyy-MM-ddTHH:mm")" required /></label>
<label>Đơn giá tín chỉ (VNĐ)<input name="donGiaTinChi" type="number" min="0" max="100000000" step="0.01" value="@config.DonGiaTinChi.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label><button>Lưu cấu hình học kỳ</button></form>
}else{<p class="empty-state">Chưa có học kỳ. Hãy tạo học kỳ tại màn hình quản lý lớp học phần.</p>}
</section></div>
@section Scripts{<script src="~/js/schedule-admin.js" asp-append-version="true"></script>}
